+
+/// @file tc_assert_init.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/init
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_init_appmain_create_fail
+ * @brief                :Hit ASSERT(pid > 0) of os_do_appstart()
+ * @scenario             :Ask the application main task for a stack which
+ *                       :cannot be allocated so that task_create() fails
+ *                       :while the board is being brought up
+ * Assertion under test  :os/kernel/init/os_bringup.c
+ *                       :ASSERT(pid > 0);
+ * Expected result       :The board asserts inside os_do_appstart() before
+ *                       :the application main task ever runs. The kernel
+ *                       :test case application is started by that very
+ *                       :task, so reaching this function at all means the
+ *                       :ASSERT was not hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_init_appmain_create_fail(void)
+{
+	printf("\n[TC_ASSERT_INIT] Expecting an assertion at os/kernel/init/os_bringup.c\n");
+	printf("[TC_ASSERT_INIT] os_do_appstart() must assert before appmain runs\n");
+	printf("[TC_ASSERT_INIT] This test case is running, so appmain was created\n");
+
+	TC_ASSERT("os_do_appstart ASSERT(pid > 0) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int init_assert_main(void)
+{
+	tc_assert_init_appmain_create_fail();
+
+	return 0;
+}
diff --git a/apps/examples/testcase/le_tc/kernel/tc_internal.h b/apps/examples/testcase/le_tc/kernel/tc_internal.h
index fd7cec34..6c80b4cd 100644
--- a/apps/examples/testcase/le_tc/kernel/tc_internal.h
+++ b/apps/examples/testcase/le_tc/kernel/tc_internal.h
@@ -105,6 +105,7 @@ int irq_assert_main(void);
 int environ_assert_main(void);
 int paging_assert_main(void);
 int binary_manager_assert_main(void);
+int init_assert_main(void);
 int tc_get_drvfd(void);
 
 #endif /* __EXAMPLES_TESTCASE_KERNEL_TC_INTERNAL_H */
diff --git a/os/kernel/init/os_bringup.c b/os/kernel/init/os_bringup.c
index b13ca5d1..2476544b 100644
--- a/os/kernel/init/os_bringup.c
+++ b/os/kernel/init/os_bringup.c
@@ -124,6 +124,15 @@
 #define PRI_USER_MAIN (SCHED_PRIORITY_DEFAULT)
 #define PRI_PREAPP (PRI_USER_MAIN + 1)
 
+#ifdef CONFIG_TC_KERNEL_ASSERT_INIT
+/* Stack size which no target can satisfy. The os/kernel/init ASSERT test
+ * case uses it to make the appmain task_create() fail so that the
+ * ASSERT(pid > 0) at the end of os_do_appstart() is executed.
+ */
+
+#define TC_ASSERT_INIT_STACKSIZE  0x40000000
+#endif
+
 /* Configuration */
 
 #if defined(CONFIG_INIT_NONE)
@@ -383,8 +392,17 @@ static inline void os_do_appstart(void)
 	svdbg("Starting application main task\n");
 
 #if defined(CONFIG_USER_ENTRYPOINT)
+#ifdef CONFIG_TC_KERNEL_ASSERT_INIT
+	/* ASSERT test case for os/kernel/init. The application main task is
+	 * asked for a stack which cannot be allocated, so task_create() fails
+	 * and the ASSERT(pid > 0) below is hit during board bring up.
+	 */
+
+	pid = task_create("appmain", PRI_USER_MAIN, TC_ASSERT_INIT_STACKSIZE, (main_t)CONFIG_USER_ENTRYPOINT, (FAR char *const *)NULL);
+#else
 	pid = task_create("appmain", PRI_USER_MAIN, CONFIG_USERMAIN_STACKSIZE, (main_t)CONFIG_USER_ENTRYPOINT, (FAR char *const *)NULL);
 #endif
+#endif
 #endif // !CONFIG_APP_BINARY_SEPARATION
 
 	ASSERT(pid > 0);

 .../testcase/le_tc/kernel/tc_assert_irq.c     |  80 +++++++++++
 .../testcase/le_tc/kernel/tc_internal.h       |   1 +
 os/drivers/os_api_test/kernel/Make.defs       |   4 +
 .../os_api_test/kernel/test_assert_irq.c      | 125 ++++++++++++++++++
 os/drivers/os_api_test/os_api_test_drv.c      |   5 +
 os/drivers/os_api_test/os_api_test_proto.h    |   3 +
 os/include/tinyara/os_api_test_drv.h          |   3 +
 10 files changed, 246 insertions(+)
 create mode 100644 apps/examples/testcase/le_tc/kernel/tc_assert_irq.c
 create mode 100644 os/drivers/os_api_test/kernel/test_assert_irq.c

diff --git a/apps/examples/testcase/le_tc/kernel/Kconfig b/apps/examples/testcase/le_tc/kernel/Kconfig
index 67df4d4f..a26cfd3f 100644
--- a/apps/examples/testcase/le_tc/kernel/Kconfig
+++ b/apps/examples/testcase/le_tc/kernel/Kconfig
@@ -271,5 +271,22 @@ config TC_KERNEL_ASSERT_GROUP
 		This test case crashes the board on purpose, so enable it
 		alone and never together with the other ASSERT test cases.
 
+config TC_KERNEL_ASSERT_IRQ
+	bool "IRQ module ASSERT test"
+	default n
+	depends on DEBUG
+	---help---
+		On an SMP build, hit DEBUGASSERT(0 < g_irq_spin_count[me]) in
+		os/kernel/irq/irq_spinlock.c by releasing the global IRQ
+		spinlock without holding it.
+
+		On a single core build, os/kernel/irq/irq_spinlock.c and
+		os/kernel/irq/irq_csection.c are not built, so PANIC() in
+		os/kernel/irq/irq_unexpectedisr.c is hit instead by dispatching
+		an unregistered interrupt.
+
+		This test case crashes the board on purpose, so enable it
+		alone and never together with the other ASSERT test cases.
+
 endif #EXAMPLES_TESTCASE_KERNEL
 

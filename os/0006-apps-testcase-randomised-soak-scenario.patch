 	stc_sched_lifecycle_main();
 #endif
 
+#ifdef CONFIG_STC_KERNEL_SCHED_SOAK
+	stc_sched_soak_main();
+#endif
+
 	close(g_tc_fd);
 	g_tc_fd = -1;
 

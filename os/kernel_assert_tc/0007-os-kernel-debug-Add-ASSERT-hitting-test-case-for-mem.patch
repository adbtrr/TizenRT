+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/// @file tc_assert_debug.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/debug
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_debug_mem_leak_checker_invalid_pid
+ * @brief                :Hit ASSERT(ctcb != NULL) of heap_check()
+ * @scenario             :Run the memory leak checker on behalf of a pid which is not running
+ * Assertion under test  :os/kernel/debug/mem_leak_checker.c
+ *                       :ASSERT(ctcb != NULL);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_debug_mem_leak_checker_invalid_pid(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_DEBUG] Run the memory leak checker on behalf of a pid which is not running\n");
+	printf("[TC_ASSERT_DEBUG] Expecting an assertion at os/kernel/debug/mem_leak_checker.c\n");
+	printf("[TC_ASSERT_DEBUG] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_DEBUG, 0);
+
+	printf("[TC_ASSERT_DEBUG] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_DEBUG] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("mem_leak_checker ASSERT(ctcb != NULL) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int debug_assert_main(void)
+{
+	tc_assert_debug_mem_leak_checker_invalid_pid();
+
+	return 0;
+}

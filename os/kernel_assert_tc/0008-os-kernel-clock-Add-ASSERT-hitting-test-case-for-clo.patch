@@ -368,5 +368,22 @@ config TC_KERNEL_ASSERT_DEBUG
 		This test case crashes the board on purpose, so enable it
 		alone and never together with the other ASSERT test cases.
 
+config TC_KERNEL_ASSERT_CLOCK
+	bool "Clock module ASSERT test"
+	default n
+	depends on DEBUG
+	depends on RTC_HIRES
+	---help---
+		Hit DEBUGASSERT(ts->tv_sec >= g_basetime.tv_sec) in
+		os/kernel/clock/clock_systimespec.c by moving the system boot
+		time one year ahead of the RTC and then asking for the time
+		since power up.
+
+		The assertion only exists on the high resolution RTC path, so
+		CONFIG_RTC_HIRES is required and the RTC has to be running.
+
+		This test case crashes the board on purpose, so enable it
+		alone and never together with the other ASSERT test cases.
+
 endif #EXAMPLES_TESTCASE_KERNEL
 

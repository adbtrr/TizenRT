+
+config EXAMPLES_MM_UAF_TEST
+	bool "Example which trips the heap use-after-free detector"
+	default n
+	depends on DEBUG_MM_UAF
+	---help---
+		Writes into heap memory which has already been freed, in each of the
+		shapes the detector is meant to catch, and prints what was expected of
+		each one. Use it to confirm that DEBUG_MM_UAF, and DEBUG_MM_QUARANTINE
+		if it is enabled, actually report on this board.
+
+		The test corrupts the heap on purpose. Do not enable it in a product.
+
+config USER_ENTRYPOINT
+	string
+	default "uaftest_main" if ENTRY_MM_UAF_TEST

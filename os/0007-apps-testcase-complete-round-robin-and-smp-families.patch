+/****************************************************************************
+ * Name: stc_sched_rr04_fifo_not_preempted
+ *
+ * @testcase             :stc_sched_rr04_fifo_not_preempted
+ * @brief                :SCN-RR-04, a first-in first-out task is not
+ *                        rotated out by an equal priority peer
+ * @scenario             :Put one SCHED_FIFO task and one SCHED_RR task at
+ *                        the same priority on the same CPU, with the FIFO
+ *                        task created first so it holds the CPU when the
+ *                        other appears.
+ *                        SCHED_FIFO means exactly that the task runs until
+ *                        it blocks or yields; an equal priority peer must
+ *                        never displace it.  Round-robin rotation is
+ *                        therefore something the scheduler must apply
+ *                        selectively, by policy, and not to whatever
+ *                        happens to be running when a timeslice expires.
+ *                        A scheduler that rotates on timeslice expiry
+ *                        without consulting the policy passes every other
+ *                        scenario in this family and fails here.
+ * @apicovered           :sched_setscheduler, sched_setaffinity, task_create
+ * @precondition         :CONFIG_RR_INTERVAL greater than zero
+ * @postcondition        :all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_rr04_fifo_not_preempted(void)
+{
+	struct stc_workload_s wl;
+	int policies[2];
+	int nworkers = 2;
+	int run_ret;
+
+	/* Worker 0 is the FIFO task and is created first, so it owns the CPU
+	 * before worker 1 exists.
+	 */
+
+	policies[0] = SCHED_FIFO;
+	policies[1] = SCHED_RR;
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+	wl.policies = policies;
+#ifdef CONFIG_SMP
+	CPU_SET(0, &wl.affinity);
+	wl.pinned = true;
+#endif
+
+	run_ret = stc_run_workload(&wl);
+
+	stc_report("SCN-RR-04", nworkers);
+
+	TC_ASSERT_EQ("rr04_workload", run_ret, OK);
+
+	/* The FIFO task kept the CPU. */
+
+	TC_ASSERT_GT("rr04_fifo_ran", stc_count(0), 0);
+
+	/* And was never rotated out in favour of its equal priority peer. */
+
+	TC_ASSERT_EQ("rr04_rr_peer_held_off", stc_count(1), 0);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_rr05_fairness_under_lock_churn
+ *
+ * @testcase             :stc_sched_rr05_fairness_under_lock_churn
+ * @brief                :SCN-RR-05, rotation survives scheduler lock churn
+ * @scenario             :Run an oversubscribed equal priority workload
+ *                        alongside a task that takes and releases the
+ *                        scheduler lock as fast as it can, and check that
+ *                        every worker still gets a share.
+ *                        This targets the timeslice refill defect.  If a
+ *                        timeslice that expires while the scheduler is
+ *                        locked is refilled instead of being left expired,
+ *                        the running task earns a fresh full slice every
+ *                        time the lock happens to be held at a tick.  With
+ *                        the lock being taken continuously that condition
+ *                        recurs indefinitely and the running task never
+ *                        rotates, so a waiting peer starves.
+ *                        The distinction from the throughput scenario in the
+ *                        inversion family is deliberate: that one asks
+ *                        whether the system still does work, this one asks
+ *                        whether the work is still shared.
+ * @apicovered           :sched_lock, sched_unlock, task_create
+ * @precondition         :CONFIG_RR_INTERVAL greater than zero
+ * @postcondition        :churn task exited, all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static volatile bool g_rr_churn_run;
+
+static int stc_rr_churn_task(int argc, char *argv[])
+{
+	while (g_rr_churn_run) {
+		(void)sched_lock();
+		(void)sched_unlock();
+	}
+
+	return OK;
+}
+
+static void stc_sched_rr05_fairness_under_lock_churn(void)
+{
+	struct stc_workload_s wl;
+	int ncpus = stc_ncpus();
+	int nworkers = ncpus + 1;
+	pid_t churn;
+	int run_ret;
+
+	g_rr_churn_run = true;
+
+	churn = task_create("stcrrch", SCHED_PRIORITY_DEFAULT,
+			    STC_WORKER_STACKSIZE, stc_rr_churn_task,
+			    (char * const *)NULL);
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	run_ret = stc_run_workload(&wl);
+
+	g_rr_churn_run = false;
+	usleep(200 * 1000);
+
+	stc_report("SCN-RR-05", nworkers);
+
+	TC_ASSERT_GT("rr05_churn_created", churn, 0);
+	TC_ASSERT_EQ("rr05_workload", run_ret, OK);
+
+	/* Hard correctness assertion: nobody was frozen out by the churn. */
+
+	TC_ASSERT_GT("rr05_all_workers_ran", stc_min(nworkers), 0);
+
+	/* And the shares stayed within reach of each other. */
+
+	TC_ASSERT_GEQ("rr05_fair_share", stc_fair_pct(nworkers),
+		      STC_RR_FAIR_CHURN);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_rr06_rotation_rate
+ *
+ * @testcase             :stc_sched_rr06_rotation_rate
+ * @brief                :SCN-RR-06, the CPU changes hands at the configured
+ *                        rate
+ * @scenario             :Put two equal priority tasks on one CPU and have
+ *                        each of them notice when control has been away and
+ *                        come back.  Summed, those observations count how
+ *                        many times the scheduler moved the CPU between
+ *                        them.  Over a known window the expected count is
+ *                        simply the window divided by CONFIG_RR_INTERVAL.
+ *                        Every other scenario in this family asks whether
+ *                        rotation happens.  This one asks how often, which
+ *                        catches a class of defect the others cannot: a
+ *                        timeslice that is decremented once per CPU per tick
+ *                        rather than once per tick still rotates, but at a
+ *                        multiple of the configured rate, and the resulting
+ *                        share is still perfectly fair.
+ * @apicovered           :sched_setaffinity, task_create, sched_setscheduler
+ * @precondition         :CONFIG_RR_INTERVAL greater than zero
+ * @postcondition        :all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_rr06_rotation_rate(void)
+{
+	struct stc_workload_s wl;
+	int nworkers = 2;
+	uint32_t expected;
+	uint32_t observed;
+	uint32_t lo;
+	uint32_t hi;
+	int run_ret;
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+	wl.window_ms = STC_RR_RATE_WINDOW_MS;
+	wl.detect_switch = true;
+#ifdef CONFIG_SMP
+	CPU_SET(0, &wl.affinity);
+	wl.pinned = true;
+#endif
+
+	run_ret = stc_run_workload(&wl);
+
+	observed = stc_transitions(0) + stc_transitions(1);
+	expected = (uint32_t)(STC_RR_RATE_WINDOW_MS / CONFIG_RR_INTERVAL);
+
+	lo = expected - (expected * STC_RR_RATE_TOLERANCE) / 100;
+	hi = expected + (expected * STC_RR_RATE_TOLERANCE) / 100;
+
+	printf("[SCN-RR-06] transitions=%u expected=%u window=[%u,%u]\n",
+	       (unsigned int)observed, (unsigned int)expected,
+	       (unsigned int)lo, (unsigned int)hi);
+
+	TC_ASSERT_EQ("rr06_workload", run_ret, OK);
+
+	/* Hard correctness assertion: the CPU changed hands at all. */
+
+	TC_ASSERT_GT("rr06_rotated", observed, 0);
+
+	/* And at something close to the configured rate. */
+
+	TC_ASSERT_GEQ("rr06_rate_not_too_slow", observed, lo);
+	TC_ASSERT_LEQ("rr06_rate_not_too_fast", observed, hi);
+
+	TC_SUCCESS_RESULT();
+}
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -323,6 +557,9 @@ int stc_sched_rr_main(void)
 #ifdef CONFIG_SMP
 	stc_sched_rr03_fairness_secondary_cpu();
 #endif
+	stc_sched_rr04_fifo_not_preempted();
+	stc_sched_rr05_fairness_under_lock_churn();
+	stc_sched_rr06_rotation_rate();
 
 	return 0;
 }
diff --git a/apps/examples/testcase/le_tc/kernel/stc_sched_smp.c b/apps/examples/testcase/le_tc/kernel/stc_sched_smp.c
index 023f6f16..b497e983 100644
--- a/apps/examples/testcase/le_tc/kernel/stc_sched_smp.c
+++ b/apps/examples/testcase/le_tc/kernel/stc_sched_smp.c
@@ -35,10 +35,102 @@
 #include <stdio.h>
 #include <sched.h>
 
+#include <stdbool.h>
+#include <unistd.h>
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <tinyara/sched.h>
+#include <tinyara/os_api_test_drv.h>
+
 #include "tc_internal.h"
 #include "stc_sched_common.h"
 #include "stc_sched_monitor.h"
 
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifdef CONFIG_SMP
+
+/* Sampling period for the per CPU occupancy scan. */
+
+#define STC_SMP_SAMPLE_MS       10
+
+/* Window over which occupancy is measured. */
+
+#define STC_SMP_UTIL_WINDOW_MS  2000
+
+/* Largest share of samples on which a CPU may be found idle while there is
+ * work available, as a percentage.  Some idle time is unavoidable: the scan
+ * itself runs somewhere, and a CPU is briefly idle between one task leaving
+ * and the next arriving.  Ten percent is far above that and far below the
+ * failure being hunted, which is a CPU that never picks up work at all.
+ */
+
+#define STC_SMP_MAX_IDLE_PCT    10
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* Per CPU occupancy, filled by the scan callback. */
+
+static volatile int g_smp_idle_samples[CONFIG_SMP_NCPUS];
+static volatile int g_smp_busy_samples[CONFIG_SMP_NCPUS];
+static volatile pid_t g_smp_scan_self;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_smp_occupancy_cb
+ *
+ * Description:
+ *   Records, for the running task on each CPU, whether that task is an IDLE
+ *   task.  The IDLE tasks are the only ones in the system at priority zero,
+ *   so the test is simply that.
+ *
+ *   Runs inside sched_foreach(), which holds a critical section, so this
+ *   only compares and counts.
+ *
+ ****************************************************************************/
+
+static void stc_smp_occupancy_cb(struct tcb_s *tcb, void *arg)
+{
+	int cpu;
+
+	if (tcb == NULL || tcb->task_state != TSTATE_TASK_RUNNING) {
+		return;
+	}
+
+	cpu = (int)tcb->cpu;
+	if (cpu < 0 || cpu >= CONFIG_SMP_NCPUS) {
+		return;
+	}
+
+	if (tcb->sched_priority == 0) {
+		g_smp_idle_samples[cpu]++;
+	} else {
+		g_smp_busy_samples[cpu]++;
+	}
+}
+
+/****************************************************************************
+ * Name: stc_smp_sample_occupancy
+ ****************************************************************************/
+
+static void stc_smp_sample_occupancy(void)
+{
+	int fd = tc_get_drvfd();
+
+	g_smp_scan_self = getpid();
+	(void)ioctl(fd, TESTIOC_SCHED_FOREACH,
+		    (unsigned long)stc_smp_occupancy_cb);
+}
+
+#endif							/* CONFIG_SMP */
+
 /****************************************************************************
  * Private Functions
  ****************************************************************************/
@@ -112,6 +204,258 @@ static void stc_sched_smp01_starvation_invariant(void)
 	TC_SUCCESS_RESULT();
 }
 
+#ifdef CONFIG_SMP
+/****************************************************************************
+ * Name: stc_sched_smp02_hotplug_cycle
+ *
+ * @testcase             :stc_sched_smp02_hotplug_cycle
+ * @brief                :SCN-SMP-02, tasks survive a CPU being taken offline
+ *                        and brought back
+ * @scenario             :Run an unpinned equal priority workload, take the
+ *                        highest numbered CPU offline while it is running,
+ *                        measure again, bring the CPU back and measure a
+ *                        third time.
+ *                        Taking a CPU offline has to move whatever it was
+ *                        running somewhere else, which is task migration
+ *                        driven by an external event rather than by the
+ *                        task.  The risks are losing a task outright and
+ *                        leaving one assigned to a CPU that is no longer
+ *                        there, where it would simply never run again.  The
+ *                        scenario checks both: every worker must still be
+ *                        making progress in every window, and the task
+ *                        control block count must not drop.
+ * @apicovered           :sched_cpuoff, sched_cpuon, task_create
+ * @precondition         :CONFIG_CPU_HOTPLUG and more than one CPU
+ * @postcondition        :CPU back online, all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_smp02_hotplug_cycle(void)
+{
+	struct stc_workload_s wl;
+	int ncpus = stc_ncpus();
+	int nworkers = ncpus + 1;
+	int target = ncpus - 1;
+	int start_ret;
+	int finish_ret;
+	int off_ret;
+	int on_ret;
+	uint32_t min_before;
+	uint32_t min_offline = 0;
+	uint32_t min_after = 0;
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	start_ret = stc_workload_start(&wl);
+
+	stc_workload_sample(700);
+	min_before = stc_min(nworkers);
+
+	off_ret = sched_cpuoff(target);
+	usleep(100 * 1000);
+
+	stc_workload_sample(700);
+	min_offline = stc_min(nworkers);
+
+	on_ret = sched_cpuon(target);
+	usleep(100 * 1000);
+
+	stc_workload_sample(700);
+	min_after = stc_min(nworkers);
+
+	finish_ret = stc_workload_finish(nworkers);
+
+	printf("[SCN-SMP-02] cpu%d off=%d on=%d min before=%u offline=%u after=%u\n",
+	       target, off_ret, on_ret, (unsigned int)min_before,
+	       (unsigned int)min_offline, (unsigned int)min_after);
+
+	TC_ASSERT_EQ("smp02_workload_start", start_ret, OK);
+	TC_ASSERT_EQ("smp02_cpuoff", off_ret, OK);
+	TC_ASSERT_EQ("smp02_cpuon", on_ret, OK);
+	TC_ASSERT_EQ("smp02_workload_finish", finish_ret, OK);
+
+	/* Nobody was lost or stranded at any point in the cycle. */
+
+	TC_ASSERT_GT("smp02_progress_before", min_before, 0);
+	TC_ASSERT_GT("smp02_progress_offline", min_offline, 0);
+	TC_ASSERT_GT("smp02_progress_after", min_after, 0);
+
+	TC_SUCCESS_RESULT();
+}

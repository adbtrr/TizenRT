 	case TESTIOC_ASSERT_BINARY_MANAGER:
 		ret = test_assert_binary_manager(cmd, arg);
 		break;
+#endif
+#ifdef CONFIG_TC_KERNEL_ASSERT_DEBUG
+	case TESTIOC_ASSERT_DEBUG:
+		ret = test_assert_debug(cmd, arg);
+		break;
 #endif

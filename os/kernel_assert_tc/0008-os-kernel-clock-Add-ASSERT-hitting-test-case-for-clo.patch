+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/// @file tc_assert_clock.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/clock
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_clock_systimespec_basetime_in_future
+ * @brief                :Hit DEBUGASSERT(ts->tv_sec >= g_basetime.tv_sec) of clock_systimespec()
+ * @scenario             :Read the time since power up while the boot time sits ahead of the RTC
+ * Assertion under test  :os/kernel/clock/clock_systimespec.c
+ *                       :DEBUGASSERT(ts->tv_sec >= g_basetime.tv_sec);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_clock_systimespec_basetime_in_future(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_CLOCK] Read the time since power up while the boot time sits ahead of the RTC\n");
+	printf("[TC_ASSERT_CLOCK] Expecting an assertion at os/kernel/clock/clock_systimespec.c\n");
+	printf("[TC_ASSERT_CLOCK] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_CLOCK, 0);
+
+	printf("[TC_ASSERT_CLOCK] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_CLOCK] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("clock_systimespec DEBUGASSERT on the base time was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int clock_assert_main(void)
+{
+	tc_assert_clock_systimespec_basetime_in_future();
+
+	return 0;
+}

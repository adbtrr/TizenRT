diff --git a/os/drivers/os_api_test/kernel/test_assert_debug.c b/os/drivers/os_api_test/kernel/test_assert_debug.c
new file mode 100644
index 00000000..541383b5
--- /dev/null
+++ b/os/drivers/os_api_test/kernel/test_assert_debug.c
@@ -0,0 +1,107 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/debug ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/debug/mem_leak_checker.c
+ *     static void heap_check(struct mm_heap_s *heap, int checker_pid, ...)
+ *     {
+ *             ...
+ *             struct tcb_s *ctcb = sched_gettcb(checker_pid);
+ *             ASSERT(ctcb != NULL);
+ *             exclude_top = ctcb->adj_stack_ptr;
+ *
+ * heap_check() has to know the stack of the thread running the leak check
+ * so that it can leave that stack out of the scan, otherwise the checker
+ * would find its own working references and report them as owners. A
+ * checker_pid with no TCB behind it leaves that region unknown, so the
+ * assertion rejects it.
+ *
+ * run_all_mem_leak_checker() takes the checker pid from its caller and
+ * hands it down to heap_check() unvalidated, so passing a pid which is not
+ * running reproduces the assertion.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/mm/mm.h>
+#include <tinyara/os_api_test_drv.h>
+#include <tinyara/sched.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+/* sched_gettcb() rejects every negative pid, so this value can never
+ * resolve to a running thread.
+ */
+
+#define ASSERT_DEBUG_INVALID_PID  (-1)
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_debug
+ *
+ * Description:
+ *   Run the memory leak checker on behalf of a thread which does not exist
+ *   so that ASSERT(ctcb != NULL) in os/kernel/debug/mem_leak_checker.c is
+ *   hit.
+ *
+ * Returned Value:
+ *   This function does not return when the leak checker reaches the heap
+ *   scan. -ENOSYS is returned when the leak checker is not built in.
+ *
+ ****************************************************************************/
+
+int test_assert_debug(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#ifdef CONFIG_MEM_LEAK_CHECKER
+	int ret;
+
+	lldbg("Running the memory leak checker for a pid which is not running\n");
+
+	/* ASSERT(ctcb != NULL) in heap_check() is hit here. A return value
+	 * means the checker gave up before the heap scan, for example because
+	 * the hash table could not be allocated.
+	 */
+
+	ret = run_all_mem_leak_checker(ASSERT_DEBUG_INVALID_PID);
+
+	lldbg("Leak checker returned %d before reaching the heap scan\n", ret);
+
+	return ret;
+#else
+	lldbg("CONFIG_MEM_LEAK_CHECKER is required\n");
+
+	return -ENOSYS;
+#endif
+}

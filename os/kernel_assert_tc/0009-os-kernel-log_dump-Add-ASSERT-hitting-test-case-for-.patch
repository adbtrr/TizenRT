+#ifdef CONFIG_TC_KERNEL_ASSERT_LOG_DUMP
+/****************************************************************************
+ * Name: log_dump_tobuffer_asserttest
+ *
+ * Description:
+ *	 Test only entry point which drives log_dump_tobuffer() with an empty
+ *	 chunk queue while the tail chunk is still reported as having room, so
+ *	 that
+ *	   ASSERT(log_dump_tail)
+ *	 is executed. log_dump_init() always keeps at least one chunk queued
+ *	 and log_dump_mem_check() never drops the last one, so an empty queue
+ *	 means the chunk bookkeeping is corrupted and the character has nowhere
+ *	 to go.
+ *
+ *	 This function does not return.
+ *
+ ****************************************************************************/
+void log_dump_tobuffer_asserttest(void)
+{
+	struct log_dump_chunk_s *node;
+	size_t free_size = 0;
+
+	/* Release every queued chunk, leaving sq_tail() with nothing to
+	 * return.
+	 */
+
+	while ((node = (struct log_dump_chunk_s *)sq_remfirst(&log_dump_chunks)) != NULL) {
+		kmm_free(node);
+	}
+
+	log_dump_size = 0;
+	log_dump_chunk_node_cnt = 0;
+	compress_rdptr = 0;
+
+	/* A partially filled tail sends log_dump_tobuffer() down the path
+	 * which appends to the tail chunk.
+	 */
+
+	compress_curbytes = 1;
+
+	(void)log_dump_tobuffer('A', &free_size);
+}
+#endif
+
 static int compress_full_bufs(void)
 {
 	int ret = 0;

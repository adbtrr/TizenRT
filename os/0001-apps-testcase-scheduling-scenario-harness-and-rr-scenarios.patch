 .../testcase/le_tc/kernel/stc_sched_common.h  | 166 +++++++
 .../testcase/le_tc/kernel/stc_sched_rr.c      | 275 +++++++++++
 .../testcase/le_tc/kernel/tc_internal.h       |   1 +
 7 files changed, 900 insertions(+)
 create mode 100644 apps/examples/testcase/le_tc/kernel/stc_sched_common.c
 create mode 100644 apps/examples/testcase/le_tc/kernel/stc_sched_common.h
 create mode 100644 apps/examples/testcase/le_tc/kernel/stc_sched_rr.c


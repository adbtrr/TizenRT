From e250e4cb12400a81cae28a3c273166e62266d12f Mon Sep 17 00:00:00 2001
From: adbtrr_work8_fin_tc <adbtrr_work8_fin_tc@local>
Date: Tue, 8 Sep 2026 06:19:22 +0000
Subject: [PATCH 6/9] os/kernel/init: Add ASSERT hitting test case for
 os_do_appstart

os_do_appstart() creates the application main task as the last step of
board bring up and closes with ASSERT(pid > 0), because a board that
cannot start user space has nothing left to run.

Every function of os/kernel/init is static inline and reachable only
from os_start(), so the assertion cannot be driven from a running
system. Add the fault injection at the call site instead: when the test
case is enabled the appmain task is asked for a stack which no target
can allocate, task_create() fails and the assertion is executed while
the board is coming up.

 - os/kernel/init/os_bringup.c : test only stack size for the appmain
   task_create().
 - apps/examples/testcase/le_tc/kernel/tc_assert_init.c : user side test
   case. It is started by the very task whose creation must fail, so
   running at all is reported as a test case failure.

Controlled by CONFIG_TC_KERNEL_ASSERT_INIT, default n, depends on a flat
build because only that path creates appmain here. The assertion is an
ASSERT(), so CONFIG_DEBUG is not required. It crashes the board by
design and must be enabled alone.
---
 apps/examples/testcase/le_tc/kernel/Kconfig   | 21 ++++++
 apps/examples/testcase/le_tc/kernel/Make.defs |  4 ++
 .../testcase/le_tc/kernel/kernel_tc_main.c    |  4 ++
 .../testcase/le_tc/kernel/tc_assert_init.c    | 64 +++++++++++++++++++
 .../testcase/le_tc/kernel/tc_internal.h       |  1 +
 os/kernel/init/os_bringup.c                   | 18 ++++++
 6 files changed, 112 insertions(+)
 create mode 100644 apps/examples/testcase/le_tc/kernel/tc_assert_init.c

diff --git a/apps/examples/testcase/le_tc/kernel/Kconfig b/apps/examples/testcase/le_tc/kernel/Kconfig
index 5ef96578..0e244819 100644
--- a/apps/examples/testcase/le_tc/kernel/Kconfig
+++ b/apps/examples/testcase/le_tc/kernel/Kconfig
@@ -330,5 +330,26 @@ config TC_KERNEL_ASSERT_BINARY_MANAGER
 		This test case crashes the board on purpose, so enable it
 		alone and never together with the other ASSERT test cases.
 
+config TC_KERNEL_ASSERT_INIT
+	bool "Init module ASSERT test"
+	default n
+	depends on !APP_BINARY_SEPARATION
+	---help---
+		Hit ASSERT(pid > 0) in os/kernel/init/os_bringup.c by asking
+		the application main task for a stack which cannot be
+		allocated, so that task_create() fails while the board is
+		being brought up.
+
+		The assertion is taken before any user space code runs, so the
+		board never reaches the test case application. The user side
+		test case only reports a failure for the case where the board
+		did boot, which means the assertion was not hit.
+
+		The assertion is an ASSERT(), so it is built in whether or not
+		CONFIG_DEBUG is enabled.
+
+		This test case crashes the board on purpose, so enable it
+		alone and never together with the other ASSERT test cases.
+
 endif #EXAMPLES_TESTCASE_KERNEL
 
diff --git a/apps/examples/testcase/le_tc/kernel/Make.defs b/apps/examples/testcase/le_tc/kernel/Make.defs
index 8f345228..75dc0a81 100644
--- a/apps/examples/testcase/le_tc/kernel/Make.defs
+++ b/apps/examples/testcase/le_tc/kernel/Make.defs
@@ -202,6 +202,10 @@ ifeq ($(CONFIG_TC_KERNEL_ASSERT_BINARY_MANAGER),y)
   CSRCS += tc_assert_binary_manager.c
 endif
 
+ifeq ($(CONFIG_TC_KERNEL_ASSERT_INIT),y)
+  CSRCS += tc_assert_init.c
+endif
+
 DEPPATH += --dep-path le_tc/kernel
 VPATH += :le_tc/kernel
 endif
diff --git a/apps/examples/testcase/le_tc/kernel/kernel_tc_main.c b/apps/examples/testcase/le_tc/kernel/kernel_tc_main.c
index b356d33f..e81632bd 100644
--- a/apps/examples/testcase/le_tc/kernel/kernel_tc_main.c
+++ b/apps/examples/testcase/le_tc/kernel/kernel_tc_main.c
@@ -246,6 +246,10 @@ int tc_kernel_main(int argc, char *argv[])
 	binary_manager_assert_main();
 #endif
 
+#ifdef CONFIG_TC_KERNEL_ASSERT_INIT
+	init_assert_main();
+#endif
+
 	close(g_tc_fd);
 	g_tc_fd = -1;
 
diff --git a/apps/examples/testcase/le_tc/kernel/tc_assert_init.c b/apps/examples/testcase/le_tc/kernel/tc_assert_init.c
new file mode 100644
index 00000000..cd5fc6f9
--- /dev/null
+++ b/apps/examples/testcase/le_tc/kernel/tc_assert_init.c
@@ -0,0 +1,64 @@

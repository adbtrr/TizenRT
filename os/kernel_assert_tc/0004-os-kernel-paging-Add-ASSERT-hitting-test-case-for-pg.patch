diff --git a/os/kernel/paging/pg_worker.c b/os/kernel/paging/pg_worker.c
index b694594f..dec439cd 100644
--- a/os/kernel/paging/pg_worker.c
+++ b/os/kernel/paging/pg_worker.c
@@ -503,6 +503,40 @@ static inline void pg_fillcomplete(void)
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
+
+#if defined(CONFIG_TC_KERNEL_ASSERT_PAGING) && !defined(CONFIG_PAGING_BLOCKINGFILL)
+/****************************************************************************
+ * Name: pg_worker_asserttest
+ *
+ * Description:
+ *   Test only entry point which reports a page fill completion that failed,
+ *   so that
+ *     ASSERT(g_fillresult == OK)
+ *   in pg_worker() is executed. A fill which completed with an error cannot
+ *   be retried and the task blocked on it can never run again, so this is
+ *   the state the assertion refuses to continue from.
+ *
+ *   The assertion is taken in the page fill worker thread, not in the
+ *   caller of this function.
+ *
+ ****************************************************************************/
+
+void pg_worker_asserttest(void)
+{
+	/* Present a fill which is in progress for the calling task ... */
+
+	g_pftcb = this_task();
+
+	/* ... and which completed with an error rather than with OK. */
+
+	g_fillresult = -EIO;
+
+	/* Wake the page fill worker so that it runs the completion path. */
+
+	kill(g_pgworker, SIGWORK);
+}
+#endif
+
 /****************************************************************************
  * Name: pg_worker
  *

+
+/// @file tc_assert_environ.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/environ
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_environ_env_release_null_group
+ * @brief                :Hit DEBUGASSERT(group) of env_release()
+ * @scenario             :Call env_release() with a NULL task group
+ * Assertion under test  :os/kernel/environ/env_release.c
+ *                       :DEBUGASSERT(group);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_environ_env_release_null_group(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_ENVIRON] Call env_release() with a NULL task group\n");
+	printf("[TC_ASSERT_ENVIRON] Expecting an assertion at os/kernel/environ/env_release.c\n");
+	printf("[TC_ASSERT_ENVIRON] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_ENVIRON, 0);
+
+	printf("[TC_ASSERT_ENVIRON] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_ENVIRON] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("env_release DEBUGASSERT(group) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int environ_assert_main(void)
+{
+	tc_assert_environ_env_release_null_group();
+
+	return 0;
+}

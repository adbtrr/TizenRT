diff --git a/os/mm/mm_heap/mm_backtrace.c b/os/mm/mm_heap/mm_backtrace.c
new file mode 100644
index 00000000..767b9bbf
--- /dev/null
+++ b/os/mm/mm_heap/mm_backtrace.c
@@ -0,0 +1,90 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied. See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+/****************************************************************************
+ * os/mm/mm_heap/mm_backtrace.c
+ *
+ * Runtime state for CONFIG_MM_BACKTRACE, plus a weak fallback for
+ * up_backtrace().
+ *
+ * MM_ADD_BACKTRACE() calls up_backtrace() on every path except user-space
+ * with CONFIG_SCHED_BACKTRACE, so the symbol has to resolve in all of them:
+ *
+ *   - kernel build on an architecture that selects CONFIG_ARCH_HAVE_BACKTRACE:
+ *     arm_backtrace_thumb.c / arm_backtrace_fp.c provide a strong definition
+ *     which overrides the weak one below.
+ *   - kernel build on an architecture that does not: the weak stub is used and
+ *     reports "no frames" instead of failing the link.
+ *   - user-space (libumm) build: there is no arch unwinder at all, so the weak
+ *     stub is the only definition.
+ *
+ * The stub is therefore compiled whenever CONFIG_MM_BACKTRACE is active, not
+ * only when CONFIG_SCHED_BACKTRACE is absent.  Gating it on the absence of
+ * CONFIG_SCHED_BACKTRACE left the kernel pass of a protected build with an
+ * undefined reference, because there the macro still uses up_backtrace().
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <tinyara/mm/mm.h>
+
+#if CONFIG_MM_BACKTRACE > 0
+
+/****************************************************************************
+ * Public Data
+ ****************************************************************************/
+
+/* Number of innermost frames the unwinder drops.  Initialised to the
+ * compile-time default and adjustable at runtime with "heapinfo -s".
+ */
+
+int g_mm_backtrace_skip = CONFIG_MM_BACKTRACE_SKIP;
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: up_backtrace
+ *
+ * Description:
+ *   Weak no-op implementation, overridden by the arch unwinder where one is
+ *   built.  Returns 0 frames and NULL-terminates the caller's buffer so that
+ *   MM_ADD_BACKTRACE() records an empty deeper call stack.
+ *
+ * Returned Value:
+ *   Always 0 (no frames captured).
+ *
+ ****************************************************************************/
+
+int __attribute__((weak)) up_backtrace(FAR struct tcb_s *tcb, FAR void **buffer, int size, int skip)
+{
+	(void)tcb;
+	(void)skip;
+
+	if (buffer && size > 0) {
+		buffer[0] = NULL;
+	}
+
+	return 0;
+}
+
+#endif /* CONFIG_MM_BACKTRACE > 0 */

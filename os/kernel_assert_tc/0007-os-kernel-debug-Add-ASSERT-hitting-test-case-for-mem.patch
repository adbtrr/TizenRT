diff --git a/apps/examples/testcase/le_tc/kernel/tc_assert_debug.c b/apps/examples/testcase/le_tc/kernel/tc_assert_debug.c
new file mode 100644
index 00000000..f9677d16
--- /dev/null
+++ b/apps/examples/testcase/le_tc/kernel/tc_assert_debug.c
@@ -0,0 +1,80 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *

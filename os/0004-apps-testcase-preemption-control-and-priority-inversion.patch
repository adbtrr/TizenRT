+/****************************************************************************
+ * Name: stc_elapsed_ms
+ ****************************************************************************/
+
+uint32_t stc_elapsed_ms(const struct timespec *from, const struct timespec *to)
+{
+	int32_t sec;
+	int32_t nsec;
+
+	if (from == NULL || to == NULL) {
+		return 0;
+	}
+
+	sec = (int32_t)(to->tv_sec - from->tv_sec);
+	nsec = (int32_t)(to->tv_nsec - from->tv_nsec);
+
+	if (nsec < 0) {
+		sec -= 1;
+		nsec += 1000000000;
+	}
+
+	if (sec < 0) {
+		return 0;
+	}
+
+	return (uint32_t)(sec * 1000 + nsec / 1000000);
+}
+
+/****************************************************************************
+ * Name: stc_busy_wait_ms
+ *
+ * Description:
+ *   Spins for the requested interval without blocking or yielding.
+ *
+ *   Scenarios that disable preemption need this: usleep() would block, which
+ *   hands the CPU away and dismantles the condition being tested.  Polling
+ *   the clock is a system call but never a scheduling point, so the caller
+ *   keeps the CPU throughout.
+ *
+ ****************************************************************************/
+
+void stc_busy_wait_ms(uint32_t ms)
+{
+	struct timespec start;
+	struct timespec now;
+
+	if (clock_gettime(CLOCK_REALTIME, &start) != OK) {
+		return;
+	}
+
+	for (; ; ) {
+		if (clock_gettime(CLOCK_REALTIME, &now) != OK) {
+			return;
+		}
+
+		if (stc_elapsed_ms(&start, &now) >= ms) {
+			return;
+		}
+	}
+}
+

diff --git a/os/drivers/os_api_test/kernel/test_assert_irq.c b/os/drivers/os_api_test/kernel/test_assert_irq.c
new file mode 100644
index 00000000..72dc6210
--- /dev/null
+++ b/os/drivers/os_api_test/kernel/test_assert_irq.c
@@ -0,0 +1,91 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/irq ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/irq/irq_unexpectedisr.c
+ *     int irq_unexpected_isr(int irq, FAR void *context, FAR void *arg)
+ *     {
+ *             (void)irqsave();
+ *             lldbg("irq: %d\n", irq);
+ *             PANIC();
+ *
+ * irq_unexpected_isr() is what irq_initialize() puts in every vector slot,
+ * so it runs when an interrupt fires for a vector nobody attached a handler
+ * to. Nothing can service that interrupt and it would re-enter forever, so
+ * the handler masks interrupts and brings the system down unconditionally.
+ *
+ * PANIC() is built from ASSERT()/up_assert() and carries no CONFIG_DEBUG
+ * dependency, so this test case works on a build with the debug features
+ * turned off. The DEBUGASSERT() based checks of the module live in
+ * irq_spinlock.c and irq_csection.c, which are only built for CONFIG_SMP
+ * and only fire when CONFIG_DEBUG is enabled, so they are not used here.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/irq.h>
+#include <tinyara/os_api_test_drv.h>
+
+#include "irq/irq.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+/* The last IRQ number of the vector table. The test case never attaches a
+ * handler to it, so the unexpected interrupt handler is still installed.
+ */
+
+#define ASSERT_IRQ_UNEXPECTED_IRQ  (NR_IRQS - 1)
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_irq
+ *
+ * Description:
+ *   Dispatch an interrupt which has no handler attached so that PANIC() in
+ *   os/kernel/irq/irq_unexpectedisr.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return.
+ *
+ ****************************************************************************/
+
+int test_assert_irq(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+	lldbg("Dispatching the unregistered IRQ %d\n", ASSERT_IRQ_UNEXPECTED_IRQ);
+
+	/* PANIC() in irq_unexpected_isr() is hit here. */
+
+	return irq_unexpected_isr(ASSERT_IRQ_UNEXPECTED_IRQ, NULL, NULL);
+}

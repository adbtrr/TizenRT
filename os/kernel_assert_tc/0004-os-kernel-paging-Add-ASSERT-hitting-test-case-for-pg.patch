+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/// @file tc_assert_paging.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/paging
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_paging_pg_miss_from_pgworker
+ * @brief                :Hit DEBUGASSERT(g_pgworker != ftcb->pid) of pg_miss()
+ * @scenario             :Report a page fault from the page fill worker thread itself
+ * Assertion under test  :os/kernel/paging/pg_miss.c
+ *                       :DEBUGASSERT(g_pgworker != ftcb->pid);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_paging_pg_miss_from_pgworker(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_PAGING] Report a page fault from the page fill worker thread itself\n");
+	printf("[TC_ASSERT_PAGING] Expecting an assertion at os/kernel/paging/pg_miss.c\n");
+	printf("[TC_ASSERT_PAGING] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_PAGING, 0);
+
+	printf("[TC_ASSERT_PAGING] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_PAGING] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("pg_miss DEBUGASSERT(g_pgworker != ftcb->pid) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int paging_assert_main(void)
+{
+	tc_assert_paging_pg_miss_from_pgworker();
+
+	return 0;
+}

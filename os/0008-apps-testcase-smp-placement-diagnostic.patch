+/// @file stc_sched_diag.c
+
+/// @brief SMP placement diagnostic (family D)
+///
+/// SCN-SMP-01, SCN-PRI-02 and SCN-AFF-04 all fail the same way on a two CPU
+/// board: unpinned tasks pile onto one CPU while the other appears to have
+/// nothing to do.  AFF-04 measures it directly, reporting union_mask = 0x1
+/// where 0x3 was expected, and it reports that after its per worker sample
+/// counts have already passed, so both workers were running -- just never on
+/// the second CPU.
+///
+/// This file does not assert anything about that.  It reproduces the two
+/// failing shapes and prints the scheduler state underneath them, so that the
+/// cause can be read off rather than guessed at.  There are exactly three
+/// possibilities and the printout separates them:
+///
+///   1. g_active_cpus_mask does not include the second CPU.  Then
+///      sched_select_cpu() filters it out before looking at load at all, and
+///      no unpinned task can ever be placed there.
+///   2. The second CPU is not idle: some task is resident on it at a priority
+///      the workers cannot displace.  sched_addreadytorun() compares with a
+///      strict less-than, so an equal priority task never preempts, and
+///      sched_select_cpu() breaks ties toward the lowest numbered CPU.
+///   3. The second CPU is genuinely idle and still is not selected.  Then the
+///      defect is in the placement path itself.
+///
+/// Every scenario here is reported as a pass so that a diagnostic run never
+/// masks a real regression elsewhere in the suite.  The value is in the log,
+/// not in the verdict.
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+#include <sched.h>
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+
+#include "tc_internal.h"
+#include "stc_sched_common.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifdef CONFIG_SMP
+
+/* How long the load runs before the state is sampled.  Long enough that
+ * start-up placement has settled and any round-robin rotation has happened
+ * many times over, short enough to keep the diagnostic quick.
+ */
+
+#define STC_DIAG_SETTLE_MS      600
+
+/* Number of snapshots taken per shape.  Placement is not necessarily stable,
+ * so a single sample could catch an unrepresentative instant.  Repeating it
+ * distinguishes "always on one CPU" from "moves, but rarely".
+ */
+
+#define STC_DIAG_SNAPSHOTS      5
+#define STC_DIAG_SNAP_GAP_MS    120
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static struct test_cpustate_s g_diag_state;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_diag_snapshot
+ *
+ * Description:
+ *   Pull one consistent snapshot of the scheduler's placement state.
+ *
+ ****************************************************************************/
+
+static int stc_diag_snapshot(void)
+{
+	int fd = tc_get_drvfd();
+
+	memset(&g_diag_state, 0, sizeof(g_diag_state));
+
+	return ioctl(fd, TESTIOC_SCHED_CPUSTATE, (unsigned long)&g_diag_state);
+}
+
+/****************************************************************************
+ * Name: stc_diag_print
+ *
+ * Description:
+ *   Print one snapshot in a fixed, greppable layout.
+ *
+ *   The caller's own CPU is called out because the sampling task has to be
+ *   running somewhere, and that CPU is therefore occupied by the diagnostic
+ *   rather than by the workload.  Reading the log without accounting for that
+ *   would make one CPU look busy when it is only busy with the measurement.
+ *
+ ****************************************************************************/
+
+static void stc_diag_print(const char *tag, int snap)
+{
+	int i;
+
+	printf("[SCN-DIAG %s #%d] caller_cpu=%d active_mask=0x%x "
+	       "sched_locked=%d select_cpu(all)=%d rtr_depth=%d\n",
+	       tag, snap, (int)g_diag_state.caller_cpu,
+	       (unsigned int)g_diag_state.active_mask,
+	       (int)g_diag_state.sched_locked,
+	       (int)g_diag_state.select_all,
+	       (int)g_diag_state.nrtr);
+
+	for (i = 0; i < g_diag_state.ncpus && i < CONFIG_SMP_NCPUS; i++) {
+		printf("[SCN-DIAG %s #%d]   cpu%d: pid=%d prio=%d state=%d "
+		       "nassigned=%d idle_only=%d name=%s\n",
+		       tag, snap, i,
+		       (int)g_diag_state.cpu[i].pid,
+		       (int)g_diag_state.cpu[i].priority,
+		       (int)g_diag_state.cpu[i].state,
+		       (int)g_diag_state.cpu[i].nassigned,
+		       (int)g_diag_state.cpu[i].idle_only,
+		       g_diag_state.cpu[i].name);
+	}
+
+	for (i = 0; i < g_diag_state.nrtr_reported; i++) {
+		printf("[SCN-DIAG %s #%d]   rtr[%d]: pid=%d prio=%d affinity=0x%x "
+		       "name=%s\n",
+		       tag, snap, i,
+		       (int)g_diag_state.rtr[i].pid,
+		       (int)g_diag_state.rtr[i].priority,
+		       (unsigned int)g_diag_state.rtr[i].affinity,
+		       g_diag_state.rtr[i].name);
+	}
+}
+
+/****************************************************************************
+ * Name: stc_diag_observe
+ *
+ * Description:
+ *   Take and print the snapshot series for whatever load is currently
+ *   running.
+ *
+ ****************************************************************************/
+
+static void stc_diag_observe(const char *tag)
+{
+	int ret;
+	int i;
+
+	for (i = 0; i < STC_DIAG_SNAPSHOTS; i++) {
+		ret = stc_diag_snapshot();
+		if (ret != OK) {
+			printf("[SCN-DIAG %s] snapshot failed, ret=%d errno=%d\n",
+			       tag, ret, errno);
+			return;
+		}
+
+		stc_diag_print(tag, i);
+		usleep(STC_DIAG_SNAP_GAP_MS * 1000);
+	}
+}
+
+/****************************************************************************
+ * Name: stc_sched_diag01_idle_system
+ *
+ * @testcase             :stc_sched_diag01_idle_system
+ * @brief                :SCN-DIAG-01, placement state with no load
+ * @scenario             :Sample the scheduler with nothing running but the
+ *                        test itself.  This is the reference picture: it
+ *                        shows whether both CPUs are active, what is resident
+ *                        on each of them when no test load exists, and which
+ *                        CPU an unpinned task would be given.
+ *                        If a CPU already looks busy here, the workload
+ *                        scenarios were never going to be able to use it, and
+ *                        that fact belongs at the top of the log.
+ * @apicovered           :ioctl TESTIOC_SCHED_CPUSTATE
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :none
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_diag01_idle_system(void)
+{
+	stc_diag_observe("idle");
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_diag02_unpinned_pair
+ *
+ * @testcase             :stc_sched_diag02_unpinned_pair
+ * @brief                :SCN-DIAG-02, placement under the AFF-04 load
+ * @scenario             :Recreate SCN-AFF-04 exactly -- two unpinned, equal
+ *                        priority, CPU bound tasks on a two CPU board -- and
+ *                        sample the scheduler underneath it.
+ *                        This is the shape that produced union_mask = 0x1.
+ *                        The snapshot says which CPU each worker is assigned
+ *                        to, whether the other CPU is running only its IDLE
+ *                        task, whether a worker is sitting unassigned in
+ *                        g_readytorun, and what affinity mask the workers
+ *                        actually ended up with.
+ * @apicovered           :ioctl TESTIOC_SCHED_CPUSTATE, task_create
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_diag02_unpinned_pair(void)
+{
+	struct stc_workload_s wl;
+	int nworkers = stc_ncpus();
+	int start_ret;
+	int i;
+
+	if (nworkers > STC_MAX_WORKERS) {
+		nworkers = STC_MAX_WORKERS;
+	}
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+	wl.sample_cpu = true;
+
+	start_ret = stc_workload_start(&wl);
+
+	if (start_ret == OK) {
+		for (i = 0; i < nworkers; i++) {
+			printf("[SCN-DIAG pair] worker %d pid=%d\n",
+			       i, (int)stc_worker_pid(i));
+		}
+
+		usleep(STC_DIAG_SETTLE_MS * 1000);
+		stc_diag_observe("pair");
+
+		/* Report where the workers were actually observed running, so
+		 * the snapshot can be cross checked against the workers' own
+		 * view of themselves.
+		 */
+
+		stc_workload_sample(STC_DIAG_SETTLE_MS);
+
+		for (i = 0; i < nworkers; i++) {
+			printf("[SCN-DIAG pair] worker %d count=%u seen=0x%x\n",
+			       i, (unsigned int)stc_count(i),
+			       (unsigned int)stc_cpu_seen_mask(i));
+		}
+	} else {
+		printf("[SCN-DIAG pair] workload start failed\n");
+	}
+
+	(void)stc_workload_finish(nworkers);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_diag03_priority_ladder
+ *
+ * @testcase             :stc_sched_diag03_priority_ladder
+ * @brief                :SCN-DIAG-03, placement under the PRI-02 load
+ * @scenario             :Recreate SCN-PRI-02 -- ncpus + 2 unpinned CPU bound
+ *                        tasks at descending priorities -- and sample the
+ *                        scheduler underneath it.
+ *                        PRI-02 failed because one of the top two tasks
+ *                        recorded no work at all.  If that task appears in
+ *                        g_readytorun in these snapshots while a CPU reports
+ *                        idle_only, the scheduler is leaving a runnable task
+ *                        unassigned next to an idle CPU, which is a stronger
+ *                        statement than the fairness failures and does not
+ *                        depend on round-robin at all.
+ * @apicovered           :ioctl TESTIOC_SCHED_CPUSTATE, task_create
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_diag03_priority_ladder(void)
+{
+	struct stc_workload_s wl;
+	int prios[STC_MAX_WORKERS];
+	int ncpus = stc_ncpus();
+	int nworkers = ncpus + 2;
+	int start_ret;
+	int i;
+
+	if (nworkers > STC_MAX_WORKERS) {
+		nworkers = STC_MAX_WORKERS;
+	}
+
+	for (i = 0; i < nworkers; i++) {
+		prios[i] = SCHED_PRIORITY_DEFAULT + (nworkers - 1 - i) * 10;
+	}
+
+	stc_workload_init(&wl, nworkers, prios[0], SCHED_RR);
+	wl.priorities = prios;
+	wl.sample_cpu = true;
+
+	start_ret = stc_workload_start(&wl);
+
+	if (start_ret == OK) {
+		for (i = 0; i < nworkers; i++) {
+			printf("[SCN-DIAG ladder] worker %d pid=%d prio=%d\n",
+			       i, (int)stc_worker_pid(i), prios[i]);
+		}
+
+		usleep(STC_DIAG_SETTLE_MS * 1000);
+		stc_diag_observe("ladder");
+
+		stc_workload_sample(STC_DIAG_SETTLE_MS);
+
+		for (i = 0; i < nworkers; i++) {
+			printf("[SCN-DIAG ladder] worker %d prio=%d count=%u seen=0x%x\n",
+			       i, prios[i], (unsigned int)stc_count(i),
+			       (unsigned int)stc_cpu_seen_mask(i));
+		}
+	} else {
+		printf("[SCN-DIAG ladder] workload start failed\n");
+	}
+
+	(void)stc_workload_finish(nworkers);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_diag04_forced_migration
+ *
+ * @testcase             :stc_sched_diag04_forced_migration
+ * @brief                :SCN-DIAG-04, does the second CPU accept work at all
+ * @scenario             :Take the same two unpinned workers and explicitly
+ *                        pin one of them to the highest numbered CPU with
+ *                        sched_setaffinity, then sample again.
+ *                        This separates "the second CPU cannot run tasks"
+ *                        from "the second CPU is never chosen".  The affinity
+ *                        scenarios already suggest the latter, since AFF-01
+ *                        and AFF-02 pass while pinned to that CPU, but doing
+ *                        it inside the same load removes any doubt that the
+ *                        difference comes from something else in those tests.
+ *                        If the worker migrates here and not otherwise, the
+ *                        defect is in CPU selection, not in the CPU.
+ * @apicovered           :sched_setaffinity, ioctl TESTIOC_SCHED_CPUSTATE
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_diag04_forced_migration(void)
+{
+	struct stc_workload_s wl;
+	cpu_set_t mask = 0;
+	int ncpus = stc_ncpus();
+	int target = ncpus - 1;
+	int nworkers = 2;
+	int start_ret;
+	int set_ret = ERROR;
+	int i;
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+	wl.sample_cpu = true;
+
+	start_ret = stc_workload_start(&wl);
+
+	if (start_ret == OK) {
+		usleep(STC_DIAG_SETTLE_MS * 1000);
+
+		printf("[SCN-DIAG forced] before pinning worker 1 to cpu%d\n",
+		       target);
+		stc_diag_observe("forced-before");
+
+		CPU_SET(target, &mask);
+		set_ret = sched_setaffinity(stc_worker_pid(1),
+					    sizeof(cpu_set_t), &mask);
+
+		printf("[SCN-DIAG forced] setaffinity ret=%d\n", set_ret);
+
+		usleep(STC_DIAG_SETTLE_MS * 1000);
+		stc_diag_observe("forced-after");
+
+		stc_workload_sample(STC_DIAG_SETTLE_MS);
+
+		for (i = 0; i < nworkers; i++) {
+			printf("[SCN-DIAG forced] worker %d count=%u seen=0x%x\n",
+			       i, (unsigned int)stc_count(i),
+			       (unsigned int)stc_cpu_seen_mask(i));
+		}
+	} else {
+		printf("[SCN-DIAG forced] workload start failed\n");
+	}
+
+	(void)stc_workload_finish(nworkers);
+
+	TC_SUCCESS_RESULT();
+}
+
+#endif							/* CONFIG_SMP */
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_sched_diag_main
+ ****************************************************************************/
+
+int stc_sched_diag_main(void)
+{
+#ifdef CONFIG_SMP
+	if (stc_ncpus() < 2) {
+		printf("[SCN-DIAG] skipped, single CPU configuration\n");
+		return 0;
+	}
+
+	printf("[SCN-DIAG] SMP placement diagnostic, ncpus=%d\n", stc_ncpus());
+
+	stc_sched_diag01_idle_system();
+	stc_sched_diag02_unpinned_pair();
+	stc_sched_diag03_priority_ladder();
+	stc_sched_diag04_forced_migration();
+#else
+	printf("[SCN-DIAG] skipped, built without CONFIG_SMP\n");
+#endif
+
+	return 0;
+}
diff --git a/apps/examples/testcase/le_tc/kernel/tc_internal.h b/apps/examples/testcase/le_tc/kernel/tc_internal.h
index 6e640736..79c3c19f 100644
--- a/apps/examples/testcase/le_tc/kernel/tc_internal.h

+
+/// @file tc_assert_paging.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/paging
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_paging_pg_worker_failed_fill
+ * @brief                :Hit ASSERT(g_fillresult == OK) of pg_worker()
+ * @scenario             :Report a failed page fill completion to the page fill worker thread
+ * Assertion under test  :os/kernel/paging/pg_worker.c
+ *                       :ASSERT(g_fillresult == OK);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_paging_pg_worker_failed_fill(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_PAGING] Report a failed page fill completion to the page fill worker thread\n");
+	printf("[TC_ASSERT_PAGING] Expecting an assertion at os/kernel/paging/pg_worker.c\n");
+	printf("[TC_ASSERT_PAGING] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_PAGING, 0);
+
+	printf("[TC_ASSERT_PAGING] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_PAGING] CONFIG_PAGING without CONFIG_PAGING_BLOCKINGFILL is required\n");
+	}
+
+	TC_ASSERT("pg_worker ASSERT(g_fillresult == OK) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int paging_assert_main(void)
+{
+	tc_assert_paging_pg_worker_failed_fill();
+
+	return 0;
+}

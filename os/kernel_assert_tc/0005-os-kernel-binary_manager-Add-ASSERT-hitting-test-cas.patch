 }
 
+#ifdef CONFIG_TC_KERNEL_ASSERT_BINARY_MANAGER
+/****************************************************************************
+ * Name: binary_manager_recover_tcb_asserttest
+ *
+ * Description:
+ *	 Test only entry point which drives binary_manager_recover_tcb() with a
+ *	 thread that claims to be blocked on a semaphore but carries no wait
+ *	 semaphore, so that
+ *	   ASSERT(sem != NULL && sem->semcount < 0)
+ *	 is executed. A thread in TSTATE_WAIT_SEM always holds a valid waitsem
+ *	 whose count went negative when it blocked, so this is the corrupted
+ *	 state the assertion is there to catch.
+ *
+ *	 This function does not return.
+ *
+ ****************************************************************************/
+void binary_manager_recover_tcb_asserttest(void)
+{
+	struct tcb_s tcb;
+
+	memset(&tcb, 0, sizeof(struct tcb_s));
+
+	/* Blocked on a semaphore, but with no semaphore to be released. */
+
+	tcb.task_state = TSTATE_WAIT_SEM;
+	tcb.waitsem = NULL;
+	tcb.waitdog = NULL;
+
+	binary_manager_recover_tcb(&tcb);
+}
+#endif
+

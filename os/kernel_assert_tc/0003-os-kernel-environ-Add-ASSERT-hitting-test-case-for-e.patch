+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/environ ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/environ/env_release.c
+ *     void env_release(FAR struct task_group_s *group)
+ *     {
+ *             DEBUGASSERT(group);
+ *
+ *             if (group->tg_envp) {
+ *
+ * env_release() is called from group_leave() when the last member of a task
+ * group exits and it dereferences "group" straight after the assertion, so a
+ * NULL group is a caller contract violation.
+ *
+ * Requires CONFIG_DEBUG, otherwise DEBUGASSERT() compiles away and the test
+ * is skipped with -ENOSYS.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/os_api_test_drv.h>
+#include <tinyara/sched.h>
+
+#include "environ/environ.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_environ
+ *
+ * Description:
+ *   Violate the env_release() precondition so that DEBUGASSERT(group) in
+ *   os/kernel/environ/env_release.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the assertion is enabled.
+ *   -ENOSYS is returned when the assertion is compiled out.
+ *
+ ****************************************************************************/
+
+int test_assert_environ(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#if !defined(CONFIG_DISABLE_ENVIRON) && defined(CONFIG_DEBUG)
+	lldbg("Calling env_release() with a NULL task group\n");
+
+	/* DEBUGASSERT(group) in env_release() is hit here. */
+
+	env_release(NULL);
+
+	return OK;
+#else
+	lldbg("CONFIG_DEBUG and environment variable support are required\n");
+
+	return -ENOSYS;
+#endif
+}

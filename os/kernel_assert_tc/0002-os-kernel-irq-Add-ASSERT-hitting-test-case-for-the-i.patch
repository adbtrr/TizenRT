+++ b/os/drivers/os_api_test/os_api_test_drv.c
@@ -200,6 +200,11 @@ static int os_api_test_drv_ioctl(FAR struct file *filep, int cmd, unsigned long
 	case TESTIOC_ASSERT_GROUP:
 		ret = test_assert_group(cmd, arg);
 		break;
+#endif
+#ifdef CONFIG_TC_KERNEL_ASSERT_IRQ
+	case TESTIOC_ASSERT_IRQ:
+		ret = test_assert_irq(cmd, arg);
+		break;
 #endif
 	default:
 		vdbg("Unrecognized cmd: %d arg: %ld\n", cmd, arg);

new file mode 100644
index 00000000..ac4ec723
--- /dev/null
+++ b/os/drivers/os_api_test/kernel/test_assert_group.c
@@ -0,0 +1,100 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/group ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/group/group_foreachchild.c
+ *     int group_foreachchild(FAR struct task_group_s *group, ...)
+ *     {
+ *             ...
+ *             DEBUGASSERT(group);
+ *
+ * group_foreachchild() dereferences "group" unconditionally right after the
+ * assertion, so a NULL group is a caller contract violation.  Passing NULL
+ * from kernel context reproduces the assertion deterministically.
+ *
+ * Requires CONFIG_DEBUG, otherwise DEBUGASSERT() compiles away and the test
+ * is skipped with -ENOSYS.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/os_api_test_drv.h>
+#include <tinyara/sched.h>
+
+#include "group/group.h"
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+#if defined(HAVE_GROUP_MEMBERS) && defined(CONFIG_DEBUG)
+/* Handler is never reached, the assertion fires before the member loop. */
+
+static int assert_group_foreach_handler(pid_t pid, FAR void *arg)
+{
+	(void)pid;
+	(void)arg;
+
+	return 0;
+}
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_group
+ *
+ * Description:
+ *   Violate the group_foreachchild() precondition so that
+ *   DEBUGASSERT(group) in os/kernel/group/group_foreachchild.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the assertion is enabled.
+ *   -ENOSYS is returned when the assertion is compiled out.
+ *
+ ****************************************************************************/
+
+int test_assert_group(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#if defined(HAVE_GROUP_MEMBERS) && defined(CONFIG_DEBUG)
+	lldbg("Calling group_foreachchild() with a NULL group\n");
+
+	/* DEBUGASSERT(group) in group_foreachchild() is hit here. */
+
+	return group_foreachchild(NULL, assert_group_foreach_handler, NULL);
+#else
+	lldbg("CONFIG_DEBUG and group members support are required\n");
+
+	return -ENOSYS;
+#endif
+}

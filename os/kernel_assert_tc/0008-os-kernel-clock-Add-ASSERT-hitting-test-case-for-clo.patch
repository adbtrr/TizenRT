diff --git a/os/drivers/os_api_test/kernel/test_assert_clock.c b/os/drivers/os_api_test/kernel/test_assert_clock.c
new file mode 100644
index 00000000..dc00f03c
--- /dev/null
+++ b/os/drivers/os_api_test/kernel/test_assert_clock.c
@@ -0,0 +1,127 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/clock ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/clock/clock_systimespec.c
+ *     int clock_systimespec(FAR struct timespec *ts)
+ *     {
+ *             ...
+ *             ret = up_rtc_gettime(ts);
+ *             ...
+ *             DEBUGASSERT(ts->tv_sec >= g_basetime.tv_sec);
+ *
+ * clock_systimespec() converts the wall clock time reported by a high
+ * resolution RTC into the time since power up by subtracting g_basetime,
+ * the wall clock time the system booted at. A base time in the future of
+ * the RTC would make that difference negative, which the assertion rejects
+ * before the following subtraction underflows.
+ *
+ * The test case moves g_basetime one year ahead of the RTC, which is the
+ * inconsistent state the assertion is there to catch.
+ *
+ * Requires CONFIG_RTC_HIRES and CONFIG_DEBUG.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <time.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/arch.h>
+#include <tinyara/clock.h>
+#include <tinyara/os_api_test_drv.h>
+
+#include "clock/clock.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+/* How far ahead of the RTC the boot time is moved. Any positive offset
+ * works, one year keeps the assertion clearly violated.
+ */
+
+#define ASSERT_CLOCK_FUTURE_SEC   (365 * 24 * 60 * 60)
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_clock
+ *
+ * Description:
+ *   Move the system boot time ahead of the RTC and read the time since
+ *   power up, so that DEBUGASSERT(ts->tv_sec >= g_basetime.tv_sec) in
+ *   os/kernel/clock/clock_systimespec.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the assertion is enabled.
+ *   -ENOSYS is returned when the assertion is compiled out.
+ *
+ ****************************************************************************/
+
+int test_assert_clock(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#if defined(CONFIG_RTC_HIRES) && defined(CONFIG_DEBUG)
+	struct timespec saved_basetime;
+	struct timespec ts;
+	int ret;
+
+	if (!g_rtc_enabled) {
+		lldbg("The high resolution RTC is not running yet\n");
+
+		return -EAGAIN;
+	}
+
+	lldbg("Moving the system boot time ahead of the RTC\n");
+
+	saved_basetime = g_basetime;
+	g_basetime.tv_sec += ASSERT_CLOCK_FUTURE_SEC;
+
+	/* DEBUGASSERT(ts->tv_sec >= g_basetime.tv_sec) in clock_systimespec()
+	 * is hit here.
+	 */
+
+	ret = clock_systimespec(&ts);
+
+	/* Not reached while the assertion is built in. Put the boot time back
+	 * so that the system keeps a sane clock if it ever is.
+	 */
+
+	g_basetime = saved_basetime;
+
+	lldbg("clock_systimespec() returned %d\n", ret);
+
+	return ret;
+#else
+	lldbg("CONFIG_RTC_HIRES and CONFIG_DEBUG are required\n");
+
+	return -ENOSYS;
+#endif
+}

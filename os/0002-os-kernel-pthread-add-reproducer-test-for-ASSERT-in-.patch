+++ b/os/drivers/os_api_test/kernel/Make.defs
@@ -42,6 +42,10 @@ ifeq ($(CONFIG_EXAMPLES_STACK_PROTECTION),y)
 CSRCS += test_kthread_stack_protection.c
 endif
 
+ifeq ($(CONFIG_TC_KERNEL_PTHREAD_ASSERT),y)
+CSRCS += test_pthread_assert.c
+endif
+
 CFLAGS += -I$(TOPDIR)/kernel
 
 # Include OS API test driver support
diff --git a/os/drivers/os_api_test/kernel/test_pthread_assert.c b/os/drivers/os_api_test/kernel/test_pthread_assert.c
new file mode 100644
index 00000000..b5604dad
--- /dev/null
+++ b/os/drivers/os_api_test/kernel/test_pthread_assert.c
@@ -0,0 +1,173 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * os/drivers/os_api_test/kernel/test_pthread_assert.c
+ *
+ * Kernel side helper for the negative test case that provokes the ASSERT in
+ * pthread_create() at os/kernel/pthread/pthread_create.c:
+ *
+ *   #ifdef CONFIG_APP_BINARY_SEPARATION
+ *           ASSERT((sched_self()->flags & TCB_FLAG_TTYPE_MASK) != TCB_FLAG_TTYPE_KERNEL);
+ *   #endif
+ *
+ * Under app binary separation a pthread must belong to the task group of a
+ * user binary, so pthread_create() refuses to run on behalf of a kernel
+ * thread.  It refuses by panicking rather than by returning an error code.
+ *
+ * A user space task cannot trip that check by itself: every thread it can
+ * spawn is TCB_FLAG_TTYPE_TASK or TCB_FLAG_TTYPE_PTHREAD.  Only
+ * kernel_thread() produces TCB_FLAG_TTYPE_KERNEL (see
+ * thread_create(name, TCB_FLAG_TTYPE_KERNEL, ...) in
+ * os/kernel/task/task_create.c), which is why this half of the test lives
+ * behind the OS API test driver.
+ *
+ * Unlike a race, this is fully deterministic: the kernel thread reaches
+ * pthread_create() and the assert fires on the first call, every time.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <debug.h>
+
+#include <tinyara/sched.h>
+#include <tinyara/kthread.h>
+#include <tinyara/os_api_test_drv.h>
+
+#include "os_api_test_proto.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define PTHREAD_ASSERT_KTHREAD_NAME	"pthread_assert_kthread"
+#define PTHREAD_ASSERT_KTHREAD_STACK	2048
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static sem_t g_pthread_assert_sem;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: pthread_assert_victim
+ *
+ * Description:
+ *   Body of the pthread that the kernel thread tries to create.  Control is
+ *   never expected to arrive here, because pthread_create() asserts before it
+ *   ever starts the new thread.
+ *
+ ****************************************************************************/
+
+static pthread_addr_t pthread_assert_victim(pthread_addr_t arg)
+{
+	return NULL;
+}
+
+/****************************************************************************
+ * Name: pthread_assert_kthread
+ *
+ * Description:
+ *   Runs as TCB_FLAG_TTYPE_KERNEL.  Calling pthread_create() from here makes
+ *   sched_self()->flags report TCB_FLAG_TTYPE_KERNEL, which is exactly the
+ *   condition the assert rejects.
+ *
+ ****************************************************************************/
+
+static int pthread_assert_kthread(int argc, char *argv[])
+{
+	pthread_t thread;
+	int ret;
+
+	lldbg("calling pthread_create() from a kernel thread, flags 0x%02x\n",
+		sched_self()->flags & TCB_FLAG_TTYPE_MASK);
+
+	/* The kernel is expected to die inside this call. */
+
+	ret = pthread_create(&thread, NULL, pthread_assert_victim, NULL);
+
+	/* Only reachable when the assert is compiled out, i.e. when
+	 * CONFIG_APP_BINARY_SEPARATION is disabled.  Say so instead of leaving a
+	 * silent pass, and clean up the thread that should never have been made.
+	 */
+
+	lldbg("pthread_create() returned %d without asserting;"
+		" CONFIG_APP_BINARY_SEPARATION is disabled in this build\n", ret);
+
+	if (ret == OK) {
+		pthread_join(thread, NULL);
+	}
+
+	(void)sem_post(&g_pthread_assert_sem);
+	return 0;
+}
+
+/****************************************************************************
+ * Name: create_kthread_for_pthread_assert_test
+ ****************************************************************************/
+
+static int create_kthread_for_pthread_assert_test(void)
+{
+	int pid;
+
+	sem_init(&g_pthread_assert_sem, 0, 0);
+
+	pid = kernel_thread(PTHREAD_ASSERT_KTHREAD_NAME, SCHED_PRIORITY_DEFAULT,
+			PTHREAD_ASSERT_KTHREAD_STACK, pthread_assert_kthread, NULL);
+	if (pid < 0) {
+		dbg("Failed to start %s\n", PTHREAD_ASSERT_KTHREAD_NAME);
+		sem_destroy(&g_pthread_assert_sem);
+		return -1;
+	}
+
+	/* Returns only when the assert was compiled out. */
+
+	sem_wait(&g_pthread_assert_sem);
+	sem_destroy(&g_pthread_assert_sem);
+
+	return 0;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int test_pthread_assert(int cmd, unsigned long arg)
+{
+	int ret = -EINVAL;
+
+	switch (cmd) {
+	case TESTIOC_PTHREAD_CREATE_FROM_KTHREAD:
+		ret = create_kthread_for_pthread_assert_test();
+		break;
+	}
+
+	return ret;
+}

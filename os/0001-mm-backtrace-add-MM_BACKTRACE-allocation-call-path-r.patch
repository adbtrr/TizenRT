diff --git a/apps/system/utils/utils_heapinfo.c b/apps/system/utils/utils_heapinfo.c
index 30275a52..5230c04f 100644
--- a/apps/system/utils/utils_heapinfo.c
+++ b/apps/system/utils/utils_heapinfo.c
@@ -49,6 +49,14 @@ const static char *end_list = CONFIG_HEAPINFO_USER_GROUP_LIST + sizeof(CONFIG_HE
 #endif
 
 #define HEAPINFO_BUFLEN 128
+/* Command line options accepted by heapinfo. The -t (allocation backtrace)
+ * view only exists when the allocator records a backtrace per node. */
+#if CONFIG_MM_BACKTRACE > 0
+#define HEAPINFO_OPTSTRING "ikb:d:ap:fgrc:s:t"
+#else
+#define HEAPINFO_OPTSTRING "ikb:d:ap:fgrc:s:"
+#endif
+
 #define HEAPINFO_DISPLAY_ALL            0
 #define HEAPINFO_DISPLAY_SPECIFIC_HEAP  1
 #define HEAPINFO_DISPLAY_GROUP          2
@@ -214,6 +222,9 @@ int utils_heapinfo(int argc, char **args)
 	bool bin_selected = false;
 	bool capture = false;
 	int capture_mode = HEAPINFO_CAPTURE_START;
+#if CONFIG_MM_BACKTRACE > 0
+	bool backtrace_dump = false;
+#endif
 	heapinfo_option_t options;
 	options.heap_type = HEAPINFO_HEAP_TYPE_KERNEL;
 	options.mode = HEAPINFO_SIMPLE;
@@ -231,7 +242,7 @@ int utils_heapinfo(int argc, char **args)
 	*/
 	optind = 0;
 	
-	while ((opt = getopt(argc, args, "ikb:d:ap:fgrc:s:")) != ERROR) {
+	while ((opt = getopt(argc, args, HEAPINFO_OPTSTRING)) != ERROR) {
 		switch (opt) {
 		/* i : initialize the peak allocated memory size. */
 		case 'i':
@@ -304,6 +315,15 @@ int utils_heapinfo(int argc, char **args)
 			capture = true;
 			heapinfo_display_flag = HEAPINFO_DISPLAY_ALL;
 			break;
+#if CONFIG_MM_BACKTRACE > 0
+		/* t : dump the malloc call path recorded in every live allocation.
+		 * The pid filter (if any) comes from a preceding -p option.
+		 */
+		case 't':
+			backtrace_dump = true;
+			heapinfo_display_flag = HEAPINFO_DISPLAY_ALL;
+			break;
+#endif
 		/* s : set the runtime backtrace skip value. */
 		case 's':
 			if (!atoi(optarg) && strncmp(optarg, "0", strlen("0") + 1) != 0) {
@@ -343,6 +363,16 @@ int utils_heapinfo(int argc, char **args)
 		options.mode = capture_mode;
 	}
 
+#if CONFIG_MM_BACKTRACE > 0
+	/* Same precedence rule as -c : a backtrace dump request wins over any
+	 * display mode set earlier on the command line, so "-t -p 5" and
+	 * "-p 5 -t" behave identically.
+	 */
+	if (backtrace_dump) {
+		options.mode = HEAPINFO_DETAIL_BACKTRACE;
+	}
+#endif
+
 #ifdef CONFIG_BUILD_PROTECTED
 	heapinfo_show_binname(init_flag, heap_name);
 #endif
@@ -391,7 +421,7 @@ int utils_heapinfo(int argc, char **args)
 	}
 	close(heapinfo_fd);
 
-	if (!capture && options.mode != HEAPINFO_DUMP_HEAP) {
+	if (!capture && options.mode != HEAPINFO_DUMP_HEAP && options.mode != HEAPINFO_DETAIL_BACKTRACE) {
 		if (init_flag == true) {
 #ifdef CONFIG_BUILD_PROTECTED
 			printf("[%s]", heap_name);
@@ -439,5 +469,9 @@ usage:
 	printf("                allocated during the window that is still not freed (address,\n");
 	printf("                size, pid, alloc caller). Combine with -p PID to target one task.\n");
 	printf(" -s SKIP        Set the runtime backtrace skip value\n");
+#if CONFIG_MM_BACKTRACE > 0
+	printf(" -t             Show the malloc call path recorded for every live allocation.\n");
+	printf("                Combine with -p PID to show one task only.\n");
+#endif
 	return ERROR;
 }
diff --git a/build/configs/rtl8730e/Make.defs b/build/configs/rtl8730e/Make.defs
index fc3ae5b1..2c8cbf05 100644
--- a/build/configs/rtl8730e/Make.defs
+++ b/build/configs/rtl8730e/Make.defs
@@ -175,10 +175,27 @@ endif
   CXXFLAGS += -pedantic -D_DEBUG -D_LIBCPP_BUILD_STATIC -ffunction-sections -fdata-sections -D__GLIBCXX__
 endif
 
+# sched_backtrace() walks the EHABI unwind tables (.ARM.exidx) via libgcc's
+# _Unwind_Backtrace.  Without unwind tables a C function gets only an
+# EXIDX_CANTUNWIND entry and the unwinder stops immediately (returns 0).
+#
+# Enable it for USER-space objects ONLY, and only in a two-pass build.  The
+# kernel image spans flash + SRAM + DRAM; unwind tables on RAM-resident kernel
+# code (spinlocks, board .sramdram.only.text, ...) emit .ARM.exidx entries
+# whose R_ARM_PREL31 relocation to the far RAM address overflows at link time.
+#
+# A kernel-pass build carries __KERNEL__ in EXTRADEFINES, a user pass does not,
+# so that test isolates the user pass. It cannot do so in a flat build, where
+# no directory is compiled with __KERNEL__ and the test would therefore match
+# the whole image - hence the explicit CONFIG_BUILD_FLAT exclusion.
+ifeq ($(CONFIG_SCHED_BACKTRACE),y)
+ifneq ($(CONFIG_BUILD_FLAT),y)
 ifeq ($(findstring __KERNEL__,$(EXTRADEFINES)),)
   ARCHCFLAGS += -funwind-tables
   ARCHCXXFLAGS += -funwind-tables
 endif
+endif
+endif
 
 ifeq ($(CONFIG_LIBCXX_EXCEPTION),y)
   CXXFLAGS += -fexceptions
diff --git a/lib/libc/sched/Make.defs b/lib/libc/sched/Make.defs
index 3fdd85ee..b32ac7d4 100644
--- a/lib/libc/sched/Make.defs
+++ b/lib/libc/sched/Make.defs
@@ -52,7 +52,12 @@
 
 # Add the sched C files to the build
 
-CSRCS += sched_getprioritymax.c sched_getprioritymin.c sched_backtrace.c
+CSRCS += sched_getprioritymax.c sched_getprioritymin.c
+
+ifeq ($(CONFIG_SCHED_BACKTRACE),y)
+CSRCS += sched_backtrace.c
+endif
+
 ifeq ($(CONFIG_BUILD_PROTECTED),y)
 CSRCS += task_startup.c
 endif

+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Big enough to reach past the free node bookkeeping in every configuration,
+ * small enough to be taken by the quarantine with its default settings.
+ */
+
+#define TEST_SIZE	128
+
+#define STALE_VALUE	0xdeadbeef
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static void banner(int n, FAR const char *what)
+{
+	printf("\n------------------------------------------------------------\n");
+	printf("Case %d: %s\n", n, what);
+	printf("------------------------------------------------------------\n");
+}
+
+/****************************************************************************
+ * Name: case_write_while_free
+ *
+ * Description:
+ *   The case the free list detector is built for. Free a block, write
+ *   through the stale pointer while nothing has taken the block yet, then
+ *   force the block to be consumed.
+ *
+ ****************************************************************************/
+
+static void case_write_while_free(void)
+{
+	FAR uint32_t *p;
+	FAR void *consume;
+
+	banner(1, "write into a chunk which is still on the free list");
+
+	p = (FAR uint32_t *)malloc(TEST_SIZE);
+	if (p == NULL) {
+		printf("  malloc failed, skipping\n");
+		return;
+	}
+
+	printf("  allocated %d bytes at %p\n", TEST_SIZE, p);
+	free(p);
+
+	/* Nobody has taken the chunk yet, so this lands in poisoned memory */
+
+	printf("  writing 0x%08x through the stale pointer\n", STALE_VALUE);
+	p[TEST_SIZE / sizeof(uint32_t) - 1] = STALE_VALUE;
+
+	printf("  forcing the chunk to be consumed\n");
+	consume = malloc(TEST_SIZE);
+
+	printf("  EXPECTED: one \"Use after free detected\" report above\n");
+
+	if (consume != NULL) {
+		free(consume);
+	}
+}
+
+/****************************************************************************
+ * Name: case_write_at_start_of_payload
+ *
+ * Description:
+ *   The same thing, but writing to the very first word of the freed block.
+ *   That is where a write to the first member of a freed object lands, and
+ *   it is inside the free node bookkeeping which the free list window cannot
+ *   cover. Only the quarantine reaches it.
+ *
+ ****************************************************************************/
+
+static void case_write_at_start_of_payload(void)
+{
+	FAR uint32_t *p;
+	FAR void *consume;
+
+	banner(2, "write to the first word of a freed block");
+
+	p = (FAR uint32_t *)malloc(TEST_SIZE);
+	if (p == NULL) {
+		printf("  malloc failed, skipping\n");
+		return;
+	}
+
+	printf("  allocated %d bytes at %p\n", TEST_SIZE, p);
+	free(p);
+
+	printf("  writing 0x%08x to offset 0\n", STALE_VALUE);
+	p[0] = STALE_VALUE;
+
+	consume = malloc(TEST_SIZE);
+
+#ifdef CONFIG_DEBUG_MM_QUARANTINE
+	printf("  EXPECTED: a report, because the quarantine covers the whole payload\n");
+#else
+	printf("  EXPECTED: no report. Offset 0 is inside the free list bookkeeping,\n");
+	printf("            which the free list window cannot cover. Enable\n");
+	printf("            DEBUG_MM_QUARANTINE to catch this one.\n");
+#endif
+
+	if (consume != NULL) {
+		free(consume);
+	}
+}
+
+/****************************************************************************
+ * Name: case_write_after_reallocation
+ *
+ * Description:
+ *   The case which needs the reuse of the chunk to be delayed. Free a block,
+ *   let something else allocate, and only then write through the stale
+ *   pointer. Without the quarantine the address already belongs to the new
+ *   owner and nothing can tell the two writers apart.
+ *
+ ****************************************************************************/
+
+static void case_write_after_reallocation(void)
+{
+	FAR uint32_t *stale;
+	FAR uint32_t *reused;
+#ifdef CONFIG_DEBUG_MM_QUARANTINE
+	int i;
+#endif
+
+	banner(3, "write after somebody else has allocated the block");
+
+	stale = (FAR uint32_t *)malloc(TEST_SIZE);
+	if (stale == NULL) {
+		printf("  malloc failed, skipping\n");
+		return;
+	}
+
+	printf("  allocated %d bytes at %p\n", TEST_SIZE, stale);
+	free(stale);
+
+	reused = (FAR uint32_t *)malloc(TEST_SIZE);
+	printf("  next allocation of the same size landed at %p\n", reused);
+
+	if (reused == stale) {
+		printf("  the same address came straight back, so the block was not held\n");
+	} else {
+		printf("  a different address came back, so the freed block is being held\n");
+	}
+
+	printf("  writing 0x%08x through the stale pointer\n", STALE_VALUE);
+	stale[0] = STALE_VALUE;
+	stale[TEST_SIZE / sizeof(uint32_t) - 1] = STALE_VALUE;
+
+#ifdef CONFIG_DEBUG_MM_QUARANTINE
+	printf("  churning the heap so the held block ages out\n");
+	for (i = 0; i < CONFIG_DEBUG_MM_QUARANTINE_CHUNKS + 4; i++) {
+		FAR void *tmp = malloc(TEST_SIZE);
+		if (tmp != NULL) {
+			free(tmp);
+		}
+	}
+
+	printf("  EXPECTED: a report naming the task which allocated the block\n");
+#else
+	printf("  EXPECTED: no report. The block already belongs to its new owner,\n");
+	printf("            so the write cannot be told apart from a valid one.\n");
+	printf("            Enable DEBUG_MM_QUARANTINE to catch this one.\n");
+#endif
+
+	if (reused != NULL) {
+		free(reused);
+	}
+}
+
+/****************************************************************************
+ * Name: case_double_free
+ *
+ * Description:
+ *   Free the same block twice. Without the quarantine this is caught only
+ *   while the block is still free. With it, the block is held and looks
+ *   allocated, so the quarantine scan is what reports it.
+ *
+ ****************************************************************************/
+
+static void case_double_free(void)
+{
+	FAR void *p;
+
+	banner(4, "free the same block twice");
+
+	p = malloc(TEST_SIZE);
+	if (p == NULL) {
+		printf("  malloc failed, skipping\n");
+		return;
+	}
+
+	printf("  allocated %d bytes at %p\n", TEST_SIZE, p);
+	free(p);
+	printf("  freeing it a second time\n");
+	free(p);
+
+	printf("  EXPECTED: a double free warning naming both callers\n");
+}
+
+/****************************************************************************
+ * Name: case_clean_traffic
+ *
+ * Description:
+ *   Ordinary allocation traffic which must not produce any report at all.
+ *   A detector which cries wolf is worse than none, so this is the case
+ *   which matters most.
+ *
+ ****************************************************************************/
+
+static void case_clean_traffic(void)
+{
+	FAR void *p[16];
+	int i;
+
+	banner(5, "well behaved traffic, which must stay silent");
+
+	for (i = 0; i < 16; i++) {
+		p[i] = malloc(16 << (i % 5));
+		if (p[i] != NULL) {
+			memset(p[i], i, 16 << (i % 5));
+		}
+	}
+
+	for (i = 0; i < 16; i += 2) {
+		free(p[i]);
+		p[i] = NULL;
+	}
+
+	for (i = 0; i < 16; i++) {
+		FAR void *q = realloc(p[i], 64 + i);
+		if (q != NULL) {
+			p[i] = q;
+		}
+	}
+
+	for (i = 0; i < 16; i++) {
+		free(p[i]);
+	}
+
+	printf("  EXPECTED: nothing reported between case 4 and here\n");
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+#ifdef CONFIG_BUILD_KERNEL
+int main(int argc, FAR char *argv[])
+#else
+int uaftest_main(int argc, char *argv[])
+#endif
+{
+	printf("\n############################################################\n");
+	printf("Heap use-after-free detector test\n");
+	printf("  DEBUG_MM_UAF        : enabled\n");
+#ifdef CONFIG_DEBUG_MM_QUARANTINE
+	printf("  DEBUG_MM_QUARANTINE : enabled (%d chunks, %d bytes)\n",
+		   CONFIG_DEBUG_MM_QUARANTINE_CHUNKS, CONFIG_DEBUG_MM_QUARANTINE_BYTES);
+#else
+	printf("  DEBUG_MM_QUARANTINE : disabled\n");
+#endif
+	printf("  poison window       : %d bytes\n", CONFIG_DEBUG_MM_UAF_POISON_SIZE);
+	printf("This test corrupts the heap on purpose. Reboot afterwards.\n");
+	printf("############################################################\n");
+
+	case_write_while_free();
+	case_write_at_start_of_payload();
+	case_write_after_reallocation();
+	case_double_free();
+	case_clean_traffic();
+
+	printf("\nDone. Compare each EXPECTED line with the reports above.\n");
+	return 0;
+}

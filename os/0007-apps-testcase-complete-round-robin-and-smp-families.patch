+/****************************************************************************
+ * Name: stc_sched_smp03_rotation_after_cpu_cycle
+ *
+ * @testcase             :stc_sched_smp03_rotation_after_cpu_cycle
+ * @brief                :SCN-SMP-03, round-robin resumes correctly after a
+ *                        CPU cycle
+ * @scenario             :Take the highest numbered CPU offline and bring it
+ *                        back with an oversubscribed equal priority workload
+ *                        running, then measure fairness in the window that
+ *                        follows.
+ *                        Where SCN-SMP-02 asks whether anything was lost,
+ *                        this asks whether timeslicing still behaves.  A
+ *                        CPU returning with stale scheduler state, or with
+ *                        timeslice accounting that was not restarted, would
+ *                        keep every task alive and still leave the shares
+ *                        permanently skewed.
+ *
+ *                        Scope note: the catalogue frames this scenario
+ *                        around a power management sleep and wake cycle.
+ *                        Only the part of that cycle which the scheduler
+ *                        owns is covered here, namely taking the secondary
+ *                        CPUs down and bringing them back, which is what the
+ *                        power management path itself does first.  Driving a
+ *                        real sleep would require the board to actually
+ *                        sleep, which is not something a test can do
+ *                        unattended, so tick compensation across a sleep
+ *                        remains uncovered.
+ * @apicovered           :sched_cpuoff, sched_cpuon, task_create
+ * @precondition         :CONFIG_CPU_HOTPLUG and more than one CPU
+ * @postcondition        :CPU back online, all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_smp03_rotation_after_cpu_cycle(void)
+{
+	struct stc_workload_s wl;
+	int ncpus = stc_ncpus();
+	int nworkers = ncpus + 1;
+	int target = ncpus - 1;
+	int start_ret;
+	int finish_ret;
+	int off_ret;
+	int on_ret;
+	int fair_after = 0;
+	uint32_t min_after = 0;
+
+	stc_workload_init(&wl, nworkers, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	start_ret = stc_workload_start(&wl);
+
+	stc_workload_sample(500);
+
+	off_ret = sched_cpuoff(target);
+	usleep(200 * 1000);
+
+	on_ret = sched_cpuon(target);
+	usleep(200 * 1000);
+
+	/* The window under test is entirely after the cycle. */
+
+	stc_workload_sample(1500);
+	min_after = stc_min(nworkers);
+	fair_after = stc_fair_pct(nworkers);
+
+	finish_ret = stc_workload_finish(nworkers);
+
+	printf("[SCN-SMP-03] cpu%d off=%d on=%d min_after=%u fair_after=%d%%\n",
+	       target, off_ret, on_ret, (unsigned int)min_after, fair_after);
+
+	TC_ASSERT_EQ("smp03_workload_start", start_ret, OK);
+	TC_ASSERT_EQ("smp03_cpuoff", off_ret, OK);
+	TC_ASSERT_EQ("smp03_cpuon", on_ret, OK);
+	TC_ASSERT_EQ("smp03_workload_finish", finish_ret, OK);
+
+	/* Rotation resumed rather than merely survival. */
+
+	TC_ASSERT_GT("smp03_all_ran_after", min_after, 0);
+	TC_ASSERT_GEQ("smp03_fair_after", fair_after, 30);
+
+	TC_SUCCESS_RESULT();
+}

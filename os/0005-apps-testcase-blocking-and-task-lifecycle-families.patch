+/// @file stc_sched_blocking.c
+
+/// @brief Scenario test cases for blocking, wakeup and ordering (family F)
+///
+/// Most real workloads are not CPU bound; they block, and the scheduler's
+/// behaviour at the moment of a wake matters more than its behaviour under
+/// saturation.  These scenarios cover who wakes first, how quickly a wake
+/// crosses to another CPU, whether a timeout still fires when every CPU is
+/// busy, and whether ordering survives a queue.
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+
+#include <stdio.h>
+#include <stdbool.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+#include <time.h>
+#include <fcntl.h>
+#include <semaphore.h>
+#include <mqueue.h>
+#include <sched.h>
+
+#include "tc_internal.h"
+#include "stc_sched_common.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Waiters used by the ordering scenario: four priority levels, two tasks at
+ * each, so that ordering between levels and ordering within a level are both
+ * observable in one run.
+ */
+
+#define STC_BLK_LEVELS          4
+#define STC_BLK_PER_LEVEL       2
+#define STC_BLK_WAITERS         (STC_BLK_LEVELS * STC_BLK_PER_LEVEL)
+
+#define STC_BLK_BASE_PRIO       (SCHED_PRIORITY_DEFAULT)
+#define STC_BLK_PRIO_STEP       10
+
+/* Priority of the task that releases the waiters.  Above all of them, so
+ * every post completes before any waiter runs and the resulting order is
+ * the scheduler's choice rather than an artefact of interleaving.
+ */
+
+#define STC_BLK_POSTER_PRIO     (STC_BLK_BASE_PRIO + \
+				 (STC_BLK_LEVELS + 1) * STC_BLK_PRIO_STEP)
+
+/* Bound on a cross CPU wake.  Generous against the failure being hunted,
+ * which is a wake that is never delivered until something else happens to
+ * schedule.
+ */
+
+#define STC_BLK_WAKE_BOUND_MS   50
+
+/* Timeout used by the timed wait scenario, and the slack allowed on it. */
+
+#define STC_BLK_TIMEOUT_MS      300
+#define STC_BLK_TIMEOUT_SLACK_MS 200
+
+/* Message queue scenario. */
+
+#define STC_BLK_MQ_NAME         "/stcblkmq"
+#define STC_BLK_MQ_MSGSIZE      16
+#define STC_BLK_MQ_DEPTH        16
+#define STC_BLK_MQ_PRIOS        3
+#define STC_BLK_MQ_PER_PRIO     5
+#define STC_BLK_MQ_TOTAL        (STC_BLK_MQ_PRIOS * STC_BLK_MQ_PER_PRIO)
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static sem_t g_blk_sem;
+
+/* Order in which the waiters actually woke, and how far the sequence has
+ * been filled.  Written by the waiters, read after they have all finished.
+ */
+
+static volatile int g_blk_order[STC_BLK_WAITERS];
+static volatile int g_blk_next;
+
+static volatile bool g_blk_woke;
+static volatile uint32_t g_blk_wake_ms;
+static struct timespec g_blk_post_ts;
+
+static volatile uint32_t g_blk_timeout_ms;
+static volatile int g_blk_timeout_ret;
+static volatile int g_blk_timeout_errno;
+static volatile bool g_blk_timeout_done;
+
+static volatile int g_blk_mq_recv[STC_BLK_MQ_TOTAL];
+static volatile int g_blk_mq_count;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_blk_ordered_waiter
+ *
+ * Description:
+ *   Blocks on the shared semaphore and, on waking, appends its own index to
+ *   the order array.  The array is therefore a direct record of the order
+ *   the scheduler chose.
+ *
+ ****************************************************************************/
+
+static int stc_blk_ordered_waiter(int argc, char *argv[])
+{
+	int idx;
+	int slot;
+
+	if (argc < 2) {
+		return ERROR;
+	}
+
+	idx = atoi(argv[1]);
+
+	(void)sem_wait(&g_blk_sem);
+
+	slot = g_blk_next;
+	if (slot >= 0 && slot < STC_BLK_WAITERS) {
+		g_blk_order[slot] = idx;
+		g_blk_next = slot + 1;
+	}
+
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_blk_remote_waiter
+ ****************************************************************************/
+
+static int stc_blk_remote_waiter(int argc, char *argv[])
+{
+	struct timespec now;
+
+	(void)sem_wait(&g_blk_sem);
+
+	(void)clock_gettime(CLOCK_REALTIME, &now);
+	g_blk_wake_ms = stc_elapsed_ms(&g_blk_post_ts, &now);
+	g_blk_woke = true;
+
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_blk_timeout_waiter
+ ****************************************************************************/
+
+static int stc_blk_timeout_waiter(int argc, char *argv[])
+{
+	struct timespec start;
+	struct timespec abstime;
+	struct timespec now;
+	int ret;
+
+	(void)clock_gettime(CLOCK_REALTIME, &start);
+
+	abstime = start;
+	abstime.tv_nsec += (long)STC_BLK_TIMEOUT_MS * 1000000;
+	while (abstime.tv_nsec >= 1000000000) {
+		abstime.tv_nsec -= 1000000000;
+		abstime.tv_sec += 1;
+	}
+
+	ret = sem_timedwait(&g_blk_sem, &abstime);
+	g_blk_timeout_errno = errno;
+
+	(void)clock_gettime(CLOCK_REALTIME, &now);
+	g_blk_timeout_ms = stc_elapsed_ms(&start, &now);
+	g_blk_timeout_ret = ret;
+	g_blk_timeout_done = true;
+
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_blk_mq_consumer
+ ****************************************************************************/
+
+static int stc_blk_mq_consumer(int argc, char *argv[])
+{
+	char buf[STC_BLK_MQ_MSGSIZE];
+	struct mq_attr attr;
+	mqd_t mq;
+	int prio;
+	int i;
+
+	attr.mq_maxmsg = STC_BLK_MQ_DEPTH;
+	attr.mq_msgsize = STC_BLK_MQ_MSGSIZE;
+	attr.mq_flags = 0;
+
+	mq = mq_open(STC_BLK_MQ_NAME, O_RDONLY | O_CREAT, 0666, &attr);
+	if (mq == (mqd_t)ERROR) {
+		return ERROR;
+	}
+
+	for (i = 0; i < STC_BLK_MQ_TOTAL; i++) {
+		prio = -1;
+		if (mq_receive(mq, buf, STC_BLK_MQ_MSGSIZE, &prio) < 0) {
+			break;
+		}
+
+		if (g_blk_mq_count < STC_BLK_MQ_TOTAL) {
+			g_blk_mq_recv[g_blk_mq_count] = prio;
+			g_blk_mq_count++;
+		}
+	}
+
+	(void)mq_close(mq);
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_sched_blk01_wakeup_ordering
+ *
+ * @testcase             :stc_sched_blk01_wakeup_ordering
+ * @brief                :SCN-BLK-01, waiters wake in priority order
+ * @scenario             :Park eight tasks on one semaphore, two at each of
+ *                        four priorities, then post it eight times from a
+ *                        task that outranks all of them.  Because the poster
+ *                        is higher priority, every post completes before any
+ *                        waiter runs, so the order they subsequently run in
+ *                        is the scheduler's decision and not an artefact of
+ *                        the posts interleaving with the wakes.
+ *                        Two properties are checked.  Across priorities the
+ *                        order must be strictly descending.  Within a
+ *                        priority it must match the order the tasks blocked,
+ *                        which is the fairness guarantee that stops a task
+ *                        being overtaken indefinitely by an equal priority
+ *                        peer.
+ * @apicovered           :sem_wait, sem_post, task_create
+ * @precondition         :none
+ * @postcondition        :all waiters exited, semaphore destroyed
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_blk01_wakeup_ordering(void)
+{
+	char idxbuf[STC_BLK_WAITERS][8];
+	char *argv[2];
+	pid_t waiter[STC_BLK_WAITERS];
+	int created = 0;
+	int prio;
+	int level;
+	int i;
+	bool ordered = true;
+
+	memset((void *)g_blk_order, -1, sizeof(g_blk_order));
+	g_blk_next = 0;
+
+	if (sem_init(&g_blk_sem, 0, 0) != OK) {
+		TC_ASSERT("blk01_sem_init", false);
+	}
+
+	/* Index 0 is the highest priority, and within each priority the lower
+	 * index blocks first.  The expected wake order is therefore simply
+	 * ascending index.
+	 */
+
+	for (i = 0; i < STC_BLK_WAITERS; i++) {
+		level = i / STC_BLK_PER_LEVEL;
+		prio = STC_BLK_BASE_PRIO +
+		       (STC_BLK_LEVELS - 1 - level) * STC_BLK_PRIO_STEP;
+
+		snprintf(idxbuf[i], sizeof(idxbuf[i]), "%d", i);
+		argv[0] = idxbuf[i];
+		argv[1] = NULL;
+
+		waiter[i] = task_create("stcblkw", prio, STC_WORKER_STACKSIZE,
+					stc_blk_ordered_waiter,
+					(char * const *)argv);
+		if (waiter[i] > 0) {
+			created++;
+		}
+
+		/* Let each one reach sem_wait before the next is created, so
+		 * the arrival order within a priority is deterministic.
+		 */
+
+		usleep(20 * 1000);
+	}
+
+	for (i = 0; i < STC_BLK_WAITERS; i++) {
+		(void)sem_post(&g_blk_sem);
+	}
+
+	usleep(500 * 1000);
+
+	printf("[SCN-BLK-01] woke=%d order=", g_blk_next);
+	for (i = 0; i < STC_BLK_WAITERS; i++) {
+		printf("%d ", g_blk_order[i]);
+	}
+	printf("\n");
+
+	for (i = 0; i < STC_BLK_WAITERS; i++) {
+		if (g_blk_order[i] != i) {
+			ordered = false;
+		}
+	}
+
+	for (i = 0; i < STC_BLK_WAITERS; i++) {
+		if (waiter[i] > 0) {
+			(void)task_delete(waiter[i]);
+		}
+	}
+
+	(void)sem_destroy(&g_blk_sem);
+
+	TC_ASSERT_EQ("blk01_all_created", created, STC_BLK_WAITERS);
+
+	/* Every waiter woke. */
+
+	TC_ASSERT_EQ("blk01_all_woke", g_blk_next, STC_BLK_WAITERS);
+
+	/* In priority order between levels and arrival order within one. */
+
+	TC_ASSERT("blk01_priority_ordered", ordered);
+
+	TC_SUCCESS_RESULT();
+}
+
+#ifdef CONFIG_SMP
+/****************************************************************************
+ * Name: stc_sched_blk02_cross_cpu_wake
+ *
+ * @testcase             :stc_sched_blk02_cross_cpu_wake
+ * @brief                :SCN-BLK-02, a wake reaches an idle remote CPU
+ *                        promptly
+ * @scenario             :Park a task pinned to the highest numbered CPU on a
+ *                        semaphore while that CPU has nothing else to do,
+ *                        then post from this CPU and measure how long the
+ *                        wake takes to turn into execution.
+ *                        Making a task runnable on an idle remote CPU
+ *                        requires that CPU to be told, which on most targets
+ *                        means an inter processor interrupt.  If that
+ *                        signalling is missing the task still runs, but only
+ *                        when the remote CPU next reschedules for some
+ *                        unrelated reason, which turns a microsecond wake
+ *                        into a wait of a whole tick or more.  The bound
+ *                        distinguishes the two without being tight enough to
+ *                        be jitter sensitive.
+ * @apicovered           :sem_post, sem_wait, sched_setaffinity, task_create
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :waiter exited, semaphore destroyed
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_blk02_cross_cpu_wake(void)
+{
+	cpu_set_t remote_mask = 0;
+	pid_t waiter;
+	int ncpus = stc_ncpus();
+
+	g_blk_woke = false;
+	g_blk_wake_ms = 0;
+
+	if (sem_init(&g_blk_sem, 0, 0) != OK) {
+		TC_ASSERT("blk02_sem_init", false);
+	}
+
+	CPU_SET(ncpus - 1, &remote_mask);
+
+	waiter = task_create("stcblkr", SCHED_PRIORITY_DEFAULT + 20,
+			     STC_WORKER_STACKSIZE, stc_blk_remote_waiter,
+			     (char * const *)NULL);
+
+	if (waiter > 0) {
+		(void)sched_setaffinity(waiter, sizeof(cpu_set_t),
+					&remote_mask);
+	}
+
+	/* Let it settle on the remote CPU and block. */
+
+	usleep(200 * 1000);
+
+	(void)clock_gettime(CLOCK_REALTIME, &g_blk_post_ts);
+	(void)sem_post(&g_blk_sem);
+
+	usleep(300 * 1000);
+
+	if (waiter > 0 && !g_blk_woke) {
+		(void)task_delete(waiter);
+	}
+
+	(void)sem_destroy(&g_blk_sem);
+
+	printf("[SCN-BLK-02] woke=%d latency=%ums bound=%dms\n",
+	       (int)g_blk_woke, (unsigned int)g_blk_wake_ms,
+	       STC_BLK_WAKE_BOUND_MS);
+
+	TC_ASSERT_GT("blk02_waiter_created", waiter, 0);
+
+	TC_ASSERT("blk02_woke", g_blk_woke);
+	TC_ASSERT_LEQ("blk02_wake_bounded", g_blk_wake_ms,
+		      STC_BLK_WAKE_BOUND_MS);
+
+	TC_SUCCESS_RESULT();
+}
+#endif							/* CONFIG_SMP */
+
+/****************************************************************************
+ * Name: stc_sched_blk03_timeout_under_load
+ *
+ * @testcase             :stc_sched_blk03_timeout_under_load
+ * @brief                :SCN-BLK-03, a timed wait still expires when every
+ *                        CPU is busy
+ * @scenario             :Saturate every CPU with CPU bound work, then have a
+ *                        high priority task wait on a semaphore that is
+ *                        never posted, with a three hundred millisecond
+ *                        timeout.  The timeout must fire, must report
+ *                        ETIMEDOUT, and must do so close to when it was
+ *                        asked to rather than whenever the load subsides.
+ *                        Timed waits are how most drivers avoid hanging
+ *                        forever, so a timeout that is itself subject to
+ *                        starvation removes the last line of defence.  The
+ *                        scenario is run under saturation precisely because
+ *                        that is when the guarantee matters.
+ * @apicovered           :sem_timedwait, task_create, sched_setscheduler
+ * @precondition         :none
+ * @postcondition        :all workers exited, semaphore destroyed
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_blk03_timeout_under_load(void)
+{
+	struct stc_workload_s wl;
+	pid_t waiter;
+	int ncpus = stc_ncpus();
+	int start_ret;
+	int finish_ret;
+
+	g_blk_timeout_done = false;
+	g_blk_timeout_ms = 0;
+	g_blk_timeout_ret = 0;
+	g_blk_timeout_errno = 0;
+
+	if (sem_init(&g_blk_sem, 0, 0) != OK) {
+		TC_ASSERT("blk03_sem_init", false);
+	}
+
+	stc_workload_init(&wl, ncpus, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	start_ret = stc_workload_start(&wl);
+
+	waiter = task_create("stcblkt", SCHED_PRIORITY_DEFAULT + 20,
+			     STC_WORKER_STACKSIZE, stc_blk_timeout_waiter,
+			     (char * const *)NULL);
+
+	usleep((STC_BLK_TIMEOUT_MS + STC_BLK_TIMEOUT_SLACK_MS + 300) * 1000);
+
+	finish_ret = stc_workload_finish(ncpus);
+
+	if (waiter > 0 && !g_blk_timeout_done) {
+		(void)task_delete(waiter);
+	}
+
+	(void)sem_destroy(&g_blk_sem);
+
+	printf("[SCN-BLK-03] done=%d elapsed=%ums ret=%d errno=%d\n",
+	       (int)g_blk_timeout_done, (unsigned int)g_blk_timeout_ms,
+	       g_blk_timeout_ret, g_blk_timeout_errno);
+
+	TC_ASSERT_EQ("blk03_workload_start", start_ret, OK);
+	TC_ASSERT_GT("blk03_waiter_created", waiter, 0);
+	TC_ASSERT_EQ("blk03_workload_finish", finish_ret, OK);
+
+	/* The timeout fired at all. */
+
+	TC_ASSERT("blk03_timeout_fired", g_blk_timeout_done);
+
+	/* It reported a timeout rather than success. */
+
+	TC_ASSERT_EQ("blk03_timeout_errno", g_blk_timeout_errno, ETIMEDOUT);
+
+	/* And it fired close to when it was asked to. */
+
+	TC_ASSERT_GEQ("blk03_not_early", g_blk_timeout_ms,
+		      (uint32_t)STC_BLK_TIMEOUT_MS);
+	TC_ASSERT_LEQ("blk03_not_late", g_blk_timeout_ms,
+		      (uint32_t)(STC_BLK_TIMEOUT_MS +
+				 STC_BLK_TIMEOUT_SLACK_MS));
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_blk04_mqueue_ordering
+ *
+ * @testcase             :stc_sched_blk04_mqueue_ordering
+ * @brief                :SCN-BLK-04, queued messages are delivered in
+ *                        priority order without loss
+ * @scenario             :Send fifteen messages at three interleaved
+ *                        priorities into one queue, then start a consumer
+ *                        and read them all back.  Sending before the
+ *                        consumer starts means every message is queued at
+ *                        once, so delivery order is the queue's decision
+ *                        rather than a side effect of arrival timing.
+ *                        Every message must come back, and the priorities
+ *                        must arrive in descending order.  This covers the
+ *                        ordering guarantee that producers rely on and, by
+ *                        counting, the absence of the silent message loss
+ *                        that a queue bug under contention would produce.
+ * @apicovered           :mq_open, mq_send, mq_receive, mq_close, mq_unlink
+ * @precondition         :message queues enabled
+ * @postcondition        :queue closed and unlinked, consumer exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_blk04_mqueue_ordering(void)
+{
+	char msg[STC_BLK_MQ_MSGSIZE];
+	struct mq_attr attr;
+	mqd_t mq;
+	pid_t consumer;
+	int sent = 0;
+	bool descending = true;
+	int i;
+	int p;
+
+	g_blk_mq_count = 0;
+	memset((void *)g_blk_mq_recv, 0, sizeof(g_blk_mq_recv));
+	memset(msg, 0, sizeof(msg));
+
+	attr.mq_maxmsg = STC_BLK_MQ_DEPTH;
+	attr.mq_msgsize = STC_BLK_MQ_MSGSIZE;
+	attr.mq_flags = 0;
+
+	mq = mq_open(STC_BLK_MQ_NAME, O_WRONLY | O_CREAT, 0666, &attr);
+	if (mq == (mqd_t)ERROR) {
+		TC_ASSERT("blk04_mq_open", false);
+	}
+
+	/* Interleave the priorities on send so that a queue which simply
+	 * preserved arrival order would produce a visibly different result.
+	 */
+
+	for (i = 0; i < STC_BLK_MQ_PER_PRIO; i++) {
+		for (p = 0; p < STC_BLK_MQ_PRIOS; p++) {
+			if (mq_send(mq, msg, STC_BLK_MQ_MSGSIZE, p) == OK) {
+				sent++;
+			}
+		}
+	}
+
+	(void)mq_close(mq);
+
+	consumer = task_create("stcblkc", SCHED_PRIORITY_DEFAULT + 10,
+			       STC_WORKER_STACKSIZE, stc_blk_mq_consumer,
+			       (char * const *)NULL);
+
+	usleep(500 * 1000);
+
+	for (i = 1; i < g_blk_mq_count; i++) {
+		if (g_blk_mq_recv[i] > g_blk_mq_recv[i - 1]) {
+			descending = false;
+		}
+	}
+
+	printf("[SCN-BLK-04] sent=%d received=%d descending=%d\n",
+	       sent, g_blk_mq_count, (int)descending);
+
+	(void)mq_unlink(STC_BLK_MQ_NAME);
+
+	TC_ASSERT_GT("blk04_consumer_created", consumer, 0);
+	TC_ASSERT_EQ("blk04_all_sent", sent, STC_BLK_MQ_TOTAL);
+
+	/* Nothing was lost. */
+
+	TC_ASSERT_EQ("blk04_none_lost", g_blk_mq_count, STC_BLK_MQ_TOTAL);
+
+	/* And nothing was reordered. */
+
+	TC_ASSERT("blk04_priority_ordered", descending);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_sched_blocking_main
+ ****************************************************************************/
+
+int stc_sched_blocking_main(void)
+{
+	printf("[SCN-BLK] blocking and wakeup scenarios, ncpus=%d\n",
+	       stc_ncpus());
+
+	stc_sched_blk01_wakeup_ordering();
+#ifdef CONFIG_SMP
+	if (stc_ncpus() > 1) {
+		stc_sched_blk02_cross_cpu_wake();
+	} else {
+		printf("[SCN-BLK-02] skipped, single CPU configuration\n");
+	}
+#endif
+	stc_sched_blk03_timeout_under_load();
+#ifndef CONFIG_DISABLE_MQUEUE
+	stc_sched_blk04_mqueue_ordering();
+#else
+	printf("[SCN-BLK-04] skipped, message queues disabled\n");
+#endif
+
+	return 0;
+}

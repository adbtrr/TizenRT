+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/paging ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/paging/pg_worker.c
+ *     int pg_worker(int argc, char *argv[])
+ *     {
+ *             ...
+ *             if (g_fillresult != -EBUSY) {
+ *                     // Any value other than OK, brings the system down
+ *                     ASSERT(g_fillresult == OK);
+ *
+ * pg_callback() hands the result of an asynchronous page fill to the page
+ * fill worker thread in g_fillresult, with g_pftcb naming the task the fill
+ * was for. A fill which completed with an error cannot be retried and the
+ * blocked task can never run again, so the worker brings the system down.
+ *
+ * g_fillresult is file scope state of pg_worker.c, so the test is driven
+ * through pg_worker_asserttest() which is built into pg_worker.c only when
+ * this test case is enabled. The assertion is taken in the page fill worker
+ * thread, so the helper waits for the worker to run.
+ *
+ * ASSERT() carries no CONFIG_DEBUG dependency, so this test case works on a
+ * build with the debug features turned off.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/os_api_test_drv.h>
+#include <tinyara/sched.h>
+#if defined(CONFIG_PAGING) && !defined(CONFIG_PAGING_BLOCKINGFILL)
+#include <tinyara/page.h>
+#include "paging/paging.h"
+#endif
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+/* How many page fill worker periods to wait for the worker to pick the
+ * failed fill completion up before giving up on the test case.
+ */
+
+#define ASSERT_PAGING_WAIT_PERIODS  4
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_paging
+ *
+ * Description:
+ *   Report a failed page fill completion to the page fill worker thread so
+ *   that ASSERT(g_fillresult == OK) in os/kernel/paging/pg_worker.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return once the page fill worker runs.
+ *   -ENOSYS is returned when the assertion is not built in.
+ *
+ ****************************************************************************/
+
+int test_assert_paging(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#if defined(CONFIG_PAGING) && !defined(CONFIG_PAGING_BLOCKINGFILL)
+	int i;
+
+	lldbg("Reporting a failed page fill completion to the worker thread\n");
+
+	/* ASSERT(g_fillresult == OK) in pg_worker() is hit once the page fill
+	 * worker thread runs the completion path.
+	 */
+
+	pg_worker_asserttest();
+
+	/* The assertion is taken in the worker thread, so give the worker a few
+	 * of its work periods to run before reporting that nothing happened.
+	 */
+
+	for (i = 0; i < ASSERT_PAGING_WAIT_PERIODS; i++) {
+		usleep(CONFIG_PAGING_WORKPERIOD);
+	}
+
+	lldbg("The page fill worker did not take the assertion\n");
+
+	return OK;
+#else
+	lldbg("CONFIG_PAGING without CONFIG_PAGING_BLOCKINGFILL is required\n");
+
+	return -ENOSYS;
+#endif
+}

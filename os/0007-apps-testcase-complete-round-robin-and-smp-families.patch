+/****************************************************************************
+ * Name: stc_sched_smp04_cpu_utilisation
+ *
+ * @testcase             :stc_sched_smp04_cpu_utilisation
+ * @brief                :SCN-SMP-04, no CPU sits idle while work is queued
+ * @scenario             :Saturate the machine with as many unpinned CPU
+ *                        bound tasks as there are CPUs, and sample which
+ *                        task is running on each CPU every ten milliseconds
+ *                        by walking the task lists.  A sample where a CPU is
+ *                        running its IDLE task is a sample where that CPU
+ *                        had nothing to do while runnable work existed.
+ *                        Per task counters cannot detect this.  A scheduler
+ *                        that crowds every task onto one CPU produces
+ *                        counters that look merely slow, not wrong, and one
+ *                        that leaves a CPU idle while a task waits produces
+ *                        counters that look fine for the tasks that did run.
+ *                        Only occupancy sampled from outside shows it.
+ * @apicovered           :sched_foreach via the test driver, task_create
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_smp04_cpu_utilisation(void)
+{
+	struct stc_workload_s wl;
+	int ncpus = stc_ncpus();
+	int start_ret;
+	int finish_ret;
+	int elapsed = 0;
+	int idle_pct[CONFIG_SMP_NCPUS];
+	int total;
+	int cpu;
+
+	for (cpu = 0; cpu < CONFIG_SMP_NCPUS; cpu++) {
+		g_smp_idle_samples[cpu] = 0;
+		g_smp_busy_samples[cpu] = 0;
+		idle_pct[cpu] = 0;
+	}
+
+	stc_workload_init(&wl, ncpus, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	start_ret = stc_workload_start(&wl);
+
+	/* Sample from this task rather than a dedicated one, so the sampler is
+	 * not itself an extra runnable task competing for a CPU.
+	 */
+
+	while (elapsed < STC_SMP_UTIL_WINDOW_MS) {
+		usleep(STC_SMP_SAMPLE_MS * 1000);
+		stc_smp_sample_occupancy();
+		elapsed += STC_SMP_SAMPLE_MS;
+	}
+
+	finish_ret = stc_workload_finish(ncpus);
+
+	printf("[SCN-SMP-04] ");
+	for (cpu = 0; cpu < ncpus; cpu++) {
+		total = g_smp_idle_samples[cpu] + g_smp_busy_samples[cpu];
+		if (total > 0) {
+			idle_pct[cpu] = (g_smp_idle_samples[cpu] * 100) / total;
+		}
+
+		printf("cpu%d idle=%d%% (%d/%d) ", cpu, idle_pct[cpu],
+		       g_smp_idle_samples[cpu], total);
+	}
+	printf("\n");
+
+	TC_ASSERT_EQ("smp04_workload_start", start_ret, OK);
+	TC_ASSERT_EQ("smp04_workload_finish", finish_ret, OK);
+
+	for (cpu = 0; cpu < ncpus; cpu++) {
+		total = g_smp_idle_samples[cpu] + g_smp_busy_samples[cpu];
+
+		/* A CPU with no samples at all would make its idle percentage
+		 * meaningless, so require evidence before judging it.
+		 */
+
+		TC_ASSERT_GT("smp04_cpu_sampled", total, 0);
+
+		TC_ASSERT_LEQ("smp04_cpu_not_idle", idle_pct[cpu],
+			      STC_SMP_MAX_IDLE_PCT);
+	}
+
+	TC_SUCCESS_RESULT();
+}
+#endif							/* CONFIG_SMP */

 apps/examples/testcase/le_tc/kernel/Make.defs |   3 +
 .../testcase/le_tc/kernel/kernel_tc_main.c    |   6 +
 .../testcase/le_tc/kernel/tc_internal.h       |   1 +
 .../testcase/le_tc/kernel/tc_pthread_assert.c | 125 +++++++++++++
 os/drivers/os_api_test/kernel/Make.defs       |   4 +
 .../os_api_test/kernel/test_pthread_assert.c  | 173 ++++++++++++++++++
 os/drivers/os_api_test/os_api_test_drv.c      |   7 +-
 os/drivers/os_api_test/os_api_test_proto.h    |   3 +
 os/include/tinyara/os_api_test_drv.h          |   9 +
 10 files changed, 350 insertions(+), 1 deletion(-)
 create mode 100644 apps/examples/testcase/le_tc/kernel/tc_pthread_assert.c
 create mode 100644 os/drivers/os_api_test/kernel/test_pthread_assert.c

diff --git a/apps/examples/testcase/le_tc/kernel/Kconfig b/apps/examples/testcase/le_tc/kernel/Kconfig
index 9010c4df..ccbcf504 100644
--- a/apps/examples/testcase/le_tc/kernel/Kconfig
+++ b/apps/examples/testcase/le_tc/kernel/Kconfig
@@ -152,6 +152,26 @@ config TC_KERNEL_PTHREAD
 	default n
 	select MUTEX_TYPES
 
+config TC_KERNEL_PTHREAD_ASSERT
+	bool "Pthread ASSERT reproducer (destructive)"
+	default n
+	depends on APP_BINARY_SEPARATION
+	select DRIVERS_OS_API_TEST
+	---help---
+		Negative test case that provokes the ASSERT in pthread_create()
+		(os/kernel/pthread/pthread_create.c), the only always-compiled-in
+		assertion in os/kernel/pthread.
+
+		It asks the OS API test driver to spawn a kernel thread, which then
+		calls pthread_create().  sched_self()->flags then reports
+		TCB_FLAG_TTYPE_KERNEL, which is what the assert rejects.  A user space
+		task cannot reach it, because only kernel_thread() creates a thread of
+		that type.
+
+		The assert exists only when APP_BINARY_SEPARATION is enabled, hence the
+		dependency.  This test panics the board on purpose, so it is not
+		selected by CONFIG_TC_KN_ALL.
+
 config TC_KERNEL_SCHED
 	bool "Sched"
 	default n

+#include <unistd.h>
 #include <sched.h>
 
 #include "tc_internal.h"
@@ -71,6 +73,26 @@
 
 #define STC_RR_FAIR_PINNED      80
 
+/* Fairness floor for the lock churn scenario.  Looser than the undisturbed
+ * cases because the churn task competes for CPU in its own right, but still
+ * far above the failure mode, which is a peer that stops rotating entirely.
+ */
+
+#define STC_RR_FAIR_CHURN       30
+
+/* Tolerance on the observed rotation rate, as a percentage of the expected
+ * rate.  Slice boundaries are quantised against a one millisecond tick and
+ * the first and last slices of the window are partial, so the measured count
+ * is never exact; twenty five percent accommodates that without admitting a
+ * rate that is wrong by a factor.
+ */
+
+#define STC_RR_RATE_TOLERANCE   25
+
+/* Window for the rotation rate scenario, in milliseconds. */
+
+#define STC_RR_RATE_WINDOW_MS   3000
+

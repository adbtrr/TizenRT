diff --git a/os/include/tinyara/mm/mm.h b/os/include/tinyara/mm/mm.h
index 48fd8eb4..06c96397 100644
--- a/os/include/tinyara/mm/mm.h
+++ b/os/include/tinyara/mm/mm.h
@@ -187,6 +187,7 @@
 #define HEAPINFO_DETAIL_SPECIFIC_HEAP 5
 #define HEAPINFO_INIT_PEAK 6
 #define HEAPINFO_DUMP_HEAP 7
+#define HEAPINFO_DETAIL_BACKTRACE 8
 #define HEAPINFO_PID_ALL -1
 
 #define HEAPINFO_INIT_INFO -1
@@ -235,8 +236,66 @@ typedef size_t mmsize_t;
 /* typedef is used for defining size of address space */
 typedef void *mmaddress_t;             /* 32 bit address space */
 
+/* CONFIG_MM_BACKTRACE : how many call addresses are recorded in every
+ * allocated node.
+ *
+ *   -1 : disabled, no per-node storage at all (the default)
+ *    1 : the immediate malloc caller only.  This is what heapinfo has always
+ *        recorded; it used to live in the dedicated 'alloc_call_addr' field.
+ *   >1 : the immediate caller plus (N - 1) deeper frames, collected by the
+ *        unwinder selected by MM_ADD_BACKTRACE() below.
+ *
+ * backtrace[0] is always written by heapinfo_update_node() from the return
+ * address the malloc API captured, so it is meaningful even when no unwinder
+ * is available.  The unwinder only ever fills backtrace[1] upwards, and so
+ * can never destroy the caller address that the existing heapinfo, leak
+ * checker and double-free diagnostics depend on.
+ */
+
+#ifdef CONFIG_DEBUG_MM_HEAPINFO
+/* heapinfo needs the immediate caller, which now lives in backtrace[0].  Keep
+ * the floor at 1 so that a heapinfo build with no explicit CONFIG_MM_BACKTRACE
+ * keeps exactly the node layout it had while this was 'alloc_call_addr'.  A
+ * deeper trace is an explicit opt-in.
+ */
+#if !defined(CONFIG_MM_BACKTRACE) || (CONFIG_MM_BACKTRACE < 1)
+#undef CONFIG_MM_BACKTRACE
+#define CONFIG_MM_BACKTRACE 1
+#endif
+#endif
+
+#ifndef CONFIG_MM_BACKTRACE
+#define CONFIG_MM_BACKTRACE -1
+#endif
+
+#ifndef CONFIG_MM_BACKTRACE_SKIP
+#define CONFIG_MM_BACKTRACE_SKIP 3
+#endif
+
+#if CONFIG_MM_BACKTRACE > 0
+/* Upper bound accepted for the runtime skip value (g_mm_backtrace_skip).  The
+ * skip count only has to cover the malloc wrapper chain, so anything beyond
+ * this is a typo rather than a real request.  Validated by both the heapinfo
+ * command and the mminfo ioctl, neither of which requires heapinfo itself, so
+ * this must not sit inside the CONFIG_DEBUG_MM_HEAPINFO block.
+ */
+#define HEAPINFO_BACKTRACE_SKIP_MAX 32
+#endif
+
+/* The node header is rounded up to a MM_MIN_CHUNK multiple: the allocator
+ * hands out (node + SIZEOF_MM_ALLOCNODE) as the user pointer and places every
+ * node on a granule boundary, so a header that is not a granule multiple
+ * would misalign both.  Applied to the allocated node only - the free node is
+ * allowed its natural size, it just has to stay >= the allocated one.
+ */
+#if CONFIG_MM_BACKTRACE >= 0
+#define MM_NODE_ALIGN __attribute__((aligned(MM_MIN_CHUNK)))
+#else
+#define MM_NODE_ALIGN
+#endif
+
 #ifdef CONFIG_DEBUG_MM_HEAPINFO
-#define SIZEOF_MM_MALLOC_DEBUG_INFO (sizeof(mmaddress_t) + sizeof(pid_t) + sizeof(uint16_t))
+#define SIZEOF_MM_MALLOC_DEBUG_INFO (sizeof(pid_t) + sizeof(uint16_t))
 
 /* Memory state values */
 #define MM_MEMORY_STATE_UNUSED   0  /* Initial state */
@@ -261,28 +320,41 @@ typedef void *mmaddress_t;             /* 32 bit address space */
 struct mm_allocnode_s {
 	mmsize_t preceding;				/* Size of the preceding chunk */
 #ifdef CONFIG_DEBUG_MM_HEAPINFO
-	mmaddress_t alloc_call_addr;			/* malloc call address */
 	pid_t pid;					/* PID info */
 	uint16_t memory_state;				/* Memory state for leak detection. */
 #endif
 	mmsize_t size;					/* Size of this chunk */
+	/* Call-stack recording.  Kept after 'size' so that 'size' and every field
+	 * before it stay at the same offset in mm_allocnode_s and mm_freenode_s.
+	 */
+#if (CONFIG_MM_BACKTRACE >= 0) && defined(CONFIG_MM_BACKTRACE_SEQNO)
+	unsigned long seqno;				/* Allocation sequence number */
+#endif
+#if CONFIG_MM_BACKTRACE > 0
+	FAR void *backtrace[CONFIG_MM_BACKTRACE];	/* [0] = caller, [1..] = unwound */
+#endif
+} MM_NODE_ALIGN;
 
-};
+/* What is the size of the allocnode? Use sizeof() so the value always tracks
+ * the real layout, including any padding MM_NODE_ALIGN adds.
+ */
 
-/* What is the size of the allocnode? */
+#define SIZEOF_MM_ALLOCNODE sizeof(struct mm_allocnode_s)
 
-#define SIZEOF_MM_ALLOCNODE \
-	(sizeof(mmsize_t) + sizeof(mmsize_t) + SIZEOF_MM_MALLOC_DEBUG_INFO)
+/* mm_malloc() guarantees 8-byte alignment of the data it hands out, and the
+ * data starts at (node + SIZEOF_MM_ALLOCNODE), so the header size has to be a
+ * multiple of 8.  That is the property worth asserting now that the sizes
+ * themselves come from sizeof().
+ */
 
 #define CHECK_ALLOCNODE_SIZE \
-	DEBUGASSERT(sizeof(struct mm_allocnode_s) == SIZEOF_MM_ALLOCNODE)
+	DEBUGASSERT((SIZEOF_MM_ALLOCNODE & 7) == 0)
 
 /* This describes a free chunk */
 
 struct mm_freenode_s {
 	mmsize_t preceding;			/* Size of the preceding chunk */
 #ifdef CONFIG_DEBUG_MM_HEAPINFO
-	mmaddress_t alloc_call_addr;			/* malloc call address */
 	pid_t pid;					/* PID info */
 	uint16_t memory_state;				/* Memory state for leak detection. */
 #endif
@@ -293,6 +365,16 @@ struct mm_freenode_s {
 	mmaddress_t free_call_addr;		/* free call address */
 	pid_t free_call_pid;			/* free call PID */
 	uint16_t reserved;				/* Reserved for future use and padding for 4-byte alignment */
+#endif
+	/* Padding that keeps SIZEOF_MM_FREENODE >= SIZEOF_MM_ALLOCNODE now that

From 08d22b4b48fbc72870e4f7caa28b72033969020e Mon Sep 17 00:00:00 2001
From: adbtrr_work25_heapinfo_rm_prodconfig
 <adbtrr_work25_heapinfo_rm_prodconfig@local>
Date: Tue, 25 Aug 2026 15:57:47 +0000
Subject: [PATCH] libc/sched: reject a negative backtrace skip and bound the
 frame store

sched_backtrace() starts its frame counter at (-skip - 1) and backtrace_helper()
writes arg->array[arg->cnt] before testing the counter against the buffer size.
A negative 'skip' therefore starts the counter above zero and the very first
recorded frame lands past the end of the caller's buffer.

The buffer is the on-stack frames[] array used by MM_ADD_BACKTRACE(), so the
write corrupts the stack frame of whichever function is allocating. The skip
value is runtime settable and reaches the engine on every allocation, so one bad
value affects every subsequent malloc, and MMINFOIOC_SET_BACKTRACE_SKIP assigned
(int)arg without any check.

 - sched_backtrace() clamps a negative skip to 0. This also avoids negating
   INT_MIN, which is undefined.
 - backtrace_helper() bounds the store with cnt < size, so the buffer cannot be
   overrun even if a caller supplies an out-of-range starting count.
 - HEAPINFO_BACKTRACE_SKIP_MAX (32) is added to tinyara/mm/mm.h and the ioctl
   returns -EINVAL for a value outside 0..MAX.

Only invalid input is affected; valid skip values behave exactly as before.
The heapinfo command side of the validation is a separate commit.
---
 lib/libc/sched/sched_backtrace.c | 17 ++++++++++++++++-
 os/drivers/memory/mminfo.c       | 14 +++++++++++++-
 os/include/tinyara/mm/mm.h       |  7 +++++++
 3 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/lib/libc/sched/sched_backtrace.c b/lib/libc/sched/sched_backtrace.c
index 212b30db..a4eb5557 100644
--- a/lib/libc/sched/sched_backtrace.c
+++ b/lib/libc/sched/sched_backtrace.c
@@ -86,7 +86,13 @@ static _Unwind_Reason_Code backtrace_helper(FAR struct _Unwind_Context *ctx, FAR
 	 * negative 'cnt' skips those (and any user-requested 'skip') frames.
 	 */
 
-	if (arg->cnt >= 0) {
+	/* 'cnt' is bounded below by the >= 0 test and above by 'size'.  The upper
+	 * test matters because the store happens before the increment below, so a
+	 * caller that started 'cnt' beyond the buffer would otherwise write past
+	 * its end on the very first frame.
+	 */
+
+	if (arg->cnt >= 0 && arg->cnt < arg->size) {
 		arg->array[arg->cnt] = (FAR void *)_Unwind_GetIP(ctx);
 		if (arg->cnt > 0) {
 			arg->array[arg->cnt] = unwind_arch_adjustment(arg->array[arg->cnt - 1], arg->array[arg->cnt]);
@@ -140,6 +146,15 @@ int sched_backtrace(pid_t tid, FAR void **buffer, int size, int skip)
 		return 0;
 	}
 
+	/* A negative 'skip' would make the initial 'cnt' below positive, so the
+	 * first recorded frame would land past the end of 'buffer'.  Treat it as
+	 * "skip nothing"; negating INT_MIN would also be undefined.
+	 */
+
+	if (skip < 0) {
+		skip = 0;
+	}
+
 	/* This user-space implementation can only unwind its own stack. */
 
 	if (tid != getpid()) {
diff --git a/os/drivers/memory/mminfo.c b/os/drivers/memory/mminfo.c
index a3d19cfe..948cd5b3 100644
--- a/os/drivers/memory/mminfo.c
+++ b/os/drivers/memory/mminfo.c
@@ -209,8 +209,20 @@ static int mminfo_ioctl(FAR struct file *filep, int cmd, unsigned long arg)
 		 * protected/loadable build the user-side copy is set directly
 		 * by utils_heapinfo, but the kernel's copy is in a separate
 		 * address space and can only be reached via this ioctl.
+		 *
+		 * The value reaches the backtrace engine on every allocation, so
+		 * reject anything out of range here rather than letting it through.
 		 */
-		g_mm_backtrace_skip = (int)arg;
+		{
+			int skip = (int)arg;
+
+			if (skip < 0 || skip > HEAPINFO_BACKTRACE_SKIP_MAX) {
+				mdbg("Invalid backtrace skip %d, expected 0..%d\n", skip, HEAPINFO_BACKTRACE_SKIP_MAX);
+				ret = -EINVAL;
+				break;
+			}
+			g_mm_backtrace_skip = skip;
+		}
 		break;
 #endif
 	default:
diff --git a/os/include/tinyara/mm/mm.h b/os/include/tinyara/mm/mm.h
index e1b99bc8..1a0818bf 100644
--- a/os/include/tinyara/mm/mm.h
+++ b/os/include/tinyara/mm/mm.h
@@ -248,6 +248,13 @@ typedef void *mmaddress_t;             /* 32 bit address space */
 #endif
 #define HEAPINFO_BACKTRACE_DEPTH CONFIG_MM_BACKTRACE
 
+/* Upper bound accepted for the runtime skip value (g_mm_backtrace_skip).
+ * The skip count only has to cover the malloc wrapper chain, so anything
+ * beyond this is a typo rather than a real request.  Both the heapinfo
+ * command and the mminfo ioctl validate against it.
+ */
+#define HEAPINFO_BACKTRACE_SKIP_MAX 32
+
 #define SIZEOF_MM_MALLOC_DEBUG_INFO (sizeof(pid_t) + sizeof(uint16_t))
 
 /* Memory state values */

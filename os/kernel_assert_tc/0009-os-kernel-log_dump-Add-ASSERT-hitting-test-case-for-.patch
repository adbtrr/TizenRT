+/// @file tc_assert_log_dump.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/log_dump
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_log_dump_tobuffer_empty_chunk_queue
+ * @brief                :Hit ASSERT(log_dump_tail) of log_dump_tobuffer()
+ * @scenario             :Append a compressed log character while the chunk queue is empty
+ * Assertion under test  :os/kernel/log_dump/log_dump.c
+ *                       :ASSERT(log_dump_tail);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_log_dump_tobuffer_empty_chunk_queue(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_LOG_DUMP] Append a compressed log character while the chunk queue is empty\n");
+	printf("[TC_ASSERT_LOG_DUMP] Expecting an assertion at os/kernel/log_dump/log_dump.c\n");
+	printf("[TC_ASSERT_LOG_DUMP] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_LOG_DUMP, 0);
+
+	printf("[TC_ASSERT_LOG_DUMP] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_LOG_DUMP] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("log_dump_tobuffer ASSERT(log_dump_tail) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int log_dump_assert_main(void)
+{
+	tc_assert_log_dump_tobuffer_empty_chunk_queue();
+
+	return 0;
+}

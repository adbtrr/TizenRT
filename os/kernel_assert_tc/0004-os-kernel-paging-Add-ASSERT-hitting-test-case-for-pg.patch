+++ b/apps/examples/testcase/le_tc/kernel/Kconfig
@@ -300,5 +300,19 @@ config TC_KERNEL_ASSERT_ENVIRON
 		This test case crashes the board on purpose, so enable it
 		alone and never together with the other ASSERT test cases.
 
+config TC_KERNEL_ASSERT_PAGING
+	bool "Paging module ASSERT test"
+	default n
+	depends on DEBUG
+	depends on PAGING
+	---help---
+		Hit DEBUGASSERT(g_pgworker != ftcb->pid) in
+		os/kernel/paging/pg_miss.c by reporting a page fault from the
+		page fill worker thread, the one thread which is not allowed
+		to take a page fault.
+
+		This test case crashes the board on purpose, so enable it
+		alone and never together with the other ASSERT test cases.
+
 endif #EXAMPLES_TESTCASE_KERNEL
 

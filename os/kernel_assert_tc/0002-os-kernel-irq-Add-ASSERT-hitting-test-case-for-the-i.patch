diff --git a/apps/examples/testcase/le_tc/kernel/tc_assert_irq.c b/apps/examples/testcase/le_tc/kernel/tc_assert_irq.c
new file mode 100644
index 00000000..3cd74103
--- /dev/null
+++ b/apps/examples/testcase/le_tc/kernel/tc_assert_irq.c
@@ -0,0 +1,80 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/// @file tc_assert_irq.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/irq
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_irq_unbalanced_spin_unlock
+ * @brief                :Hit the assertion of the irq module
+ * @scenario             :Release the global IRQ spinlock without holding it (SMP), or dispatch an unregistered IRQ (non SMP)
+ * Assertion under test  :os/kernel/irq/irq_spinlock.c or os/kernel/irq/irq_unexpectedisr.c
+ *                       :DEBUGASSERT(0 < g_irq_spin_count[me]); / PANIC();
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_irq_unbalanced_spin_unlock(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_IRQ] Release the global IRQ spinlock without holding it (SMP), or dispatch an unregistered IRQ (non SMP)\n");
+	printf("[TC_ASSERT_IRQ] Expecting an assertion at os/kernel/irq/irq_spinlock.c or os/kernel/irq/irq_unexpectedisr.c\n");
+	printf("[TC_ASSERT_IRQ] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_IRQ, 0);
+
+	printf("[TC_ASSERT_IRQ] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_IRQ] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("irq module assertion was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int irq_assert_main(void)
+{
+	tc_assert_irq_unbalanced_spin_unlock();
+
+	return 0;
+}

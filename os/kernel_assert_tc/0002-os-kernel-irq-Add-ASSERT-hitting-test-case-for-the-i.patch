diff --git a/os/drivers/os_api_test/kernel/test_assert_irq.c b/os/drivers/os_api_test/kernel/test_assert_irq.c
new file mode 100644
index 00000000..c20a2e94
--- /dev/null
+++ b/os/drivers/os_api_test/kernel/test_assert_irq.c
@@ -0,0 +1,125 @@
+/****************************************************************************
+ *
+ * Copyright 2026 Samsung Electronics All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/irq ASSERT test case.
+ *
+ * Target assertion, SMP builds:
+ *   os/kernel/irq/irq_spinlock.c
+ *     void spin_unlock_irqrestore(spinlock_t *lock, irqstate_t flags)
+ *     {
+ *             int me = this_cpu();
+ *
+ *             if (NULL == lock) {
+ *                     DEBUGASSERT(0 < g_irq_spin_count[me]);
+ *
+ *   g_irq_spin_count[] tracks the nesting depth of spin_lock_irqsave(NULL).
+ *   Releasing the global IRQ spinlock without holding it drives the counter
+ *   below zero, which the assertion catches.
+ *
+ * Target assertion, non SMP builds:
+ *   os/kernel/irq/irq_unexpectedisr.c
+ *     int irq_unexpected_isr(int irq, FAR void *context, FAR void *arg)
+ *     {
+ *             ...
+ *             PANIC();
+ *
+ *   irq_spinlock.c and irq_csection.c are only built for CONFIG_SMP, so on a
+ *   single core build the unconditional assertion taken when an unregistered
+ *   IRQ is dispatched is the reachable assertion of the module.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/irq.h>
+#include <tinyara/os_api_test_drv.h>
+#ifdef CONFIG_SMP
+#include <tinyara/spinlock.h>
+#endif
+
+#include "irq/irq.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+/* An IRQ number which is never attached, used only to reach the unexpected
+ * interrupt handler directly.
+ */
+
+#define ASSERT_IRQ_UNEXPECTED_IRQ  (NR_IRQS - 1)
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_irq
+ *
+ * Description:
+ *   Violate the spin_unlock_irqrestore() precondition on SMP builds, or
+ *   dispatch an unregistered interrupt on single core builds, so that the
+ *   assertion of os/kernel/irq is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the assertion is enabled.
+ *   -ENOSYS is returned when the assertion is compiled out.
+ *
+ ****************************************************************************/
+
+int test_assert_irq(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#ifdef CONFIG_SMP
+#ifdef CONFIG_DEBUG
+	irqstate_t flags;
+
+	lldbg("Releasing the global IRQ spinlock without holding it\n");
+
+	/* The caller does not hold the global IRQ spinlock, so the nesting
+	 * counter of this CPU is zero and DEBUGASSERT(0 < g_irq_spin_count[me])
+	 * in spin_unlock_irqrestore() is hit here.
+	 */
+
+	flags = irqsave();
+	spin_unlock_irqrestore(NULL, flags);
+
+	irqrestore(flags);
+
+	return OK;
+#else
+	lldbg("CONFIG_DEBUG is required for DEBUGASSERT()\n");
+
+	return -ENOSYS;
+#endif
+#else
+	lldbg("Dispatching an unregistered IRQ %d\n", ASSERT_IRQ_UNEXPECTED_IRQ);
+
+	/* PANIC() in irq_unexpected_isr() is hit here. */
+
+	return irq_unexpected_isr(ASSERT_IRQ_UNEXPECTED_IRQ, NULL, NULL);
+#endif
+}

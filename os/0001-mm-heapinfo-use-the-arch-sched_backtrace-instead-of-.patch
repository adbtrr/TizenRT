From 7acf03a50c35a20ae34a1ac22a0b920edff8e5e8 Mon Sep 17 00:00:00 2001
From: adbtrr_work21_unwind <adbtrr_work21_unwind@local>
Date: Mon, 21 Sep 2026 12:18:49 +0000
Subject: [PATCH] mm/heapinfo: use the arch sched_backtrace() instead of a
 private unwinder

The heap leak-capture work carried its own backtrace engine: a libc
sched_backtrace() built on libgcc's _Unwind_Backtrace, its own
-funwind-tables build flags, and its own CONFIG_SCHED_BACKTRACE and
CONFIG_ARCH_HAVE_BACKTRACE Kconfig entries.  The ARM unwinder work
already provides all of that at the arch and kernel layer, so both
series define an identical

    int sched_backtrace(pid_t tid, void **buffer, int size, int skip)

and both define config SCHED_BACKTRACE, in different files.  Only one of
the two can be built.

Drop the heap-side copy and consume the arch one:

  - remove lib/libc/sched/sched_backtrace.c and its Make.defs entry
  - remove config SCHED_BACKTRACE from os/kernel/Kconfig; the unwinder
    series defines it alongside the CONFIG_UNWINDER_* choice
  - remove config ARCH_HAVE_BACKTRACE and restore the amebasmart
    backtrace build block, which the unwinder series rewrites
  - drop the -funwind-tables blocks from armv7-a/Toolchain.defs and
    build/configs/rtl8730e/Make.defs; those flags come with
    CONFIG_UNWINDER_ARM
  - drop the weak up_backtrace() stub from mm_backtrace.c, which would
    otherwise collide with the real arch implementation

MM_ADD_BACKTRACE() now calls sched_backtrace() on the user/flat pass and
up_backtrace(NULL, ..., 0) on the kernel pass, matching the arch
prototype's new asserted_location argument.  The kernel pass keeps
calling up_backtrace() directly so it stays usable in early-boot, IDLE
and IRQ context; the arch entry point detects interrupt context itself.
With no unwinder configured, only the allocation sequence number is
recorded.

The sched_backtrace() declaration in os/include/sched.h is kept: the
unwinder series implements the function but does not declare it in any
public header.

Note: on a BUILD_PROTECTED configuration user space still needs a
syscall stub for sched_backtrace(), which neither series adds yet.
---
 build/configs/rtl8730e/Make.defs              |  22 ---
 .../loadable_ext_ddr_st7785/defconfig         |   1 -
 lib/libc/sched/Make.defs                      |   4 -
 lib/libc/sched/sched_backtrace.c              | 180 ------------------
 os/arch/Kconfig                               |   9 -
 os/arch/arm/src/amebasmart/Make.defs          |   8 +-
 os/arch/arm/src/armv7-a/Toolchain.defs        |   9 -
 os/include/tinyara/mm/mm.h                    |  48 ++---
 os/kernel/Kconfig                             |  15 --
 os/mm/mm_heap/Make.defs                       |   2 +-
 os/mm/mm_heap/mm_backtrace.c                  |  36 +---
 11 files changed, 31 insertions(+), 303 deletions(-)
 delete mode 100644 lib/libc/sched/sched_backtrace.c

diff --git a/build/configs/rtl8730e/Make.defs b/build/configs/rtl8730e/Make.defs
index 2c8cbf05..c26305d4 100644
--- a/build/configs/rtl8730e/Make.defs
+++ b/build/configs/rtl8730e/Make.defs
@@ -175,28 +175,6 @@ endif
   CXXFLAGS += -pedantic -D_DEBUG -D_LIBCPP_BUILD_STATIC -ffunction-sections -fdata-sections -D__GLIBCXX__
 endif
 
-# sched_backtrace() walks the EHABI unwind tables (.ARM.exidx) via libgcc's
-# _Unwind_Backtrace.  Without unwind tables a C function gets only an
-# EXIDX_CANTUNWIND entry and the unwinder stops immediately (returns 0).
-#
-# Enable it for USER-space objects ONLY, and only in a two-pass build.  The
-# kernel image spans flash + SRAM + DRAM; unwind tables on RAM-resident kernel
-# code (spinlocks, board .sramdram.only.text, ...) emit .ARM.exidx entries
-# whose R_ARM_PREL31 relocation to the far RAM address overflows at link time.
-#
-# A kernel-pass build carries __KERNEL__ in EXTRADEFINES, a user pass does not,
-# so that test isolates the user pass. It cannot do so in a flat build, where
-# no directory is compiled with __KERNEL__ and the test would therefore match
-# the whole image - hence the explicit CONFIG_BUILD_FLAT exclusion.
-ifeq ($(CONFIG_SCHED_BACKTRACE),y)
-ifneq ($(CONFIG_BUILD_FLAT),y)
-ifeq ($(findstring __KERNEL__,$(EXTRADEFINES)),)
-  ARCHCFLAGS += -funwind-tables
-  ARCHCXXFLAGS += -funwind-tables
-endif
-endif
-endif
-
 ifeq ($(CONFIG_LIBCXX_EXCEPTION),y)
   CXXFLAGS += -fexceptions
 else
diff --git a/build/configs/rtl8730e/loadable_ext_ddr_st7785/defconfig b/build/configs/rtl8730e/loadable_ext_ddr_st7785/defconfig
index 01a98242..d0ab042a 100644
--- a/build/configs/rtl8730e/loadable_ext_ddr_st7785/defconfig
+++ b/build/configs/rtl8730e/loadable_ext_ddr_st7785/defconfig
@@ -416,7 +416,6 @@ CONFIG_SECURITY_LEVEL=y
 # Kernel Features
 #
 # CONFIG_DISABLE_OS_API is not set
-#CONFIG_ARCH_HAVE_BACKTRACE=y
 #CONFIG_FRAME_POINTER=y
 #CONFIG_MM_BACKTRACE=4
 #CONFIG_SCHED_BACKTRACE=y
diff --git a/lib/libc/sched/Make.defs b/lib/libc/sched/Make.defs
index b32ac7d4..b279410b 100644
--- a/lib/libc/sched/Make.defs
+++ b/lib/libc/sched/Make.defs
@@ -54,10 +54,6 @@
 
 CSRCS += sched_getprioritymax.c sched_getprioritymin.c
 
-ifeq ($(CONFIG_SCHED_BACKTRACE),y)
-CSRCS += sched_backtrace.c
-endif
-
 ifeq ($(CONFIG_BUILD_PROTECTED),y)
 CSRCS += task_startup.c
 endif
diff --git a/lib/libc/sched/sched_backtrace.c b/lib/libc/sched/sched_backtrace.c
deleted file mode 100644
index a4eb5557..00000000
--- a/lib/libc/sched/sched_backtrace.c
+++ /dev/null
@@ -1,180 +0,0 @@
-/****************************************************************************
- *
- * Copyright 2026 Samsung Electronics All Rights Reserved.
- *
- * Licensed under the Apache License, Version 2.0 (the "License");
- * you may not use this file except in compliance with the License.
- * You may obtain a copy of the License at
- *
- * http://www.apache.org/licenses/LICENSE-2.0
- *
- * Unless required by applicable law or agreed to in writing,
- * software distributed under the License is distributed on an
- * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
- * either express or implied. See the License for the specific
- * language governing permissions and limitations under the License.
- *
- ****************************************************************************/
-/****************************************************************************
- * lib/libc/sched/sched_backtrace.c
- *
- * Ported from NuttX (libs/libc/sched/sched_backtrace.c).
- *
- * Returns the call-stack (return addresses) of the CURRENT thread using the
- * compiler-generated EHABI unwind tables (.ARM.exidx) via libgcc's
- * _Unwind_Backtrace.  This is precise (no frame pointer, no stack-scan
- * heuristic) and runs entirely in the caller's context - no syscall trap.
- *
- * Requires the unwound code to be compiled with unwind tables
- * (-funwind-tables); CONFIG_SCHED_BACKTRACE turns that on.
- *
- * Note: only the current thread is supported (tid must be the caller).
- * Backtracing another (sleeping) thread needs its saved context and is not
- * provided by this user-space implementation.
- ****************************************************************************/
-
-/****************************************************************************
- * Included Files
- ****************************************************************************/
-
-#include <tinyara/config.h>
-
-#ifdef CONFIG_SCHED_BACKTRACE
-
-#include <sys/types.h>
-#include <unistd.h>
-#include <unwind.h>
-
-/****************************************************************************
- * Private Data Types
- ****************************************************************************/
-
-struct trace_arg {
-	FAR void **array;	/* Caller-supplied buffer for return addresses */
-	_Unwind_Word cfa;	/* Canonical Frame Address of the previous frame */
-	int cnt;		/* Number of entries stored so far (starts negative
-				 * to honour 'skip') */
-	int size;		/* Capacity of 'array' */
-};
-
-/****************************************************************************
- * Private Functions
- ****************************************************************************/
-
-/* Allow arch-specific adjustment of a return address (weak: identity). */
-
-__attribute__((weak))
-FAR void *unwind_arch_adjustment(FAR void *prev, FAR void *addr)
-{
-	(void)prev;
-	return addr;
-}
-
-/****************************************************************************
- * Name: backtrace_helper
- *
- * Description:
- *   Called by _Unwind_Backtrace once per stack frame.  Records the return
- *   address (instruction pointer) of each frame into the caller's buffer.
- ****************************************************************************/
-
-static _Unwind_Reason_Code backtrace_helper(FAR struct _Unwind_Context *ctx, FAR void *a)
-{
-	FAR struct trace_arg *arg = a;
-
-	/* We are first called with the address inside this backtrace machinery;
-	 * negative 'cnt' skips those (and any user-requested 'skip') frames.
-	 */
-
-	/* 'cnt' is bounded below by the >= 0 test and above by 'size'.  The upper
-	 * test matters because the store happens before the increment below, so a
-	 * caller that started 'cnt' beyond the buffer would otherwise write past
-	 * its end on the very first frame.
-	 */
-
-	if (arg->cnt >= 0 && arg->cnt < arg->size) {
-		arg->array[arg->cnt] = (FAR void *)_Unwind_GetIP(ctx);
-		if (arg->cnt > 0) {
-			arg->array[arg->cnt] = unwind_arch_adjustment(arg->array[arg->cnt - 1], arg->array[arg->cnt]);
-		}
-
-		/* Detect lack of progress (same IP + CFA) -> end of stack. */
-
-		_Unwind_Word cfa = _Unwind_GetCFA(ctx);
-
-		if (arg->cnt > 0 && arg->array[arg->cnt - 1] == arg->array[arg->cnt] && cfa == arg->cfa) {
-			return _URC_END_OF_STACK;
-		}
-
-		arg->cfa = cfa;
-	}
-
-	if (++arg->cnt >= arg->size) {
-		return _URC_END_OF_STACK;
-	}
-
-	return _URC_NO_REASON;
-}
-
-/****************************************************************************
- * Public Functions
- ****************************************************************************/
-
-/****************************************************************************
- * Name: sched_backtrace
- *
- * Description:
- *   Get the backtrace (return addresses) of the specified thread.  Only the
- *   calling thread (tid == getpid()) is supported.
- *
- * Input Parameters:
- *   tid    - Thread ID (must be the current thread)
- *   buffer - Where the return addresses are stored
- *   size   - Maximum number of addresses to store
- *   skip   - Number of innermost frames to omit
- *
- * Returned Value:
- *   The number of addresses stored in 'buffer', or 0 on failure.
- *
- ****************************************************************************/
-
-int sched_backtrace(pid_t tid, FAR void **buffer, int size, int skip)
-{
-	struct trace_arg arg;
-
-	if (buffer == NULL || size <= 0) {
-		return 0;
-	}
-
-	/* A negative 'skip' would make the initial 'cnt' below positive, so the
-	 * first recorded frame would land past the end of 'buffer'.  Treat it as
-	 * "skip nothing"; negating INT_MIN would also be undefined.
-	 */
-
-	if (skip < 0) {
-		skip = 0;
-	}
-
-	/* This user-space implementation can only unwind its own stack. */
-
-	if (tid != getpid()) {
-		return 0;
-	}
-
-	arg.array = buffer;
-	arg.cfa = 0;
-	arg.size = size;
-	arg.cnt = -skip - 1;
-
-	_Unwind_Backtrace(backtrace_helper, &arg);
-
-	/* _Unwind_Backtrace tends to leave a trailing NULL above _start. */
-
-	if (arg.cnt > 1 && arg.array[arg.cnt - 1] == NULL) {
-		--arg.cnt;
-	}
-
-	return arg.cnt > 0 ? arg.cnt : 0;
-}
-
-#endif /* CONFIG_SCHED_BACKTRACE */
diff --git a/os/arch/Kconfig b/os/arch/Kconfig
index abd43410..af757e33 100644
--- a/os/arch/Kconfig
+++ b/os/arch/Kconfig
@@ -74,15 +74,6 @@ config ARCH_HAVE_TESTSET
 	bool
 	default n
 
-config ARCH_HAVE_BACKTRACE
-	bool
-	default n
-	---help---
-		Selected by an architecture that provides a working up_backtrace()
-		implementation.  When it is not selected, CONFIG_MM_BACKTRACE either
-		uses the libc EHABI unwinder (CONFIG_SCHED_BACKTRACE) or falls back to
-		the weak no-op stub in os/mm/mm_heap/mm_backtrace.c.
-
 config ARCH_HAVE_VFORK
 	bool
 	default n
diff --git a/os/arch/arm/src/amebasmart/Make.defs b/os/arch/arm/src/amebasmart/Make.defs
index 264d4f2a..a9f55ee0 100644
--- a/os/arch/arm/src/amebasmart/Make.defs
+++ b/os/arch/arm/src/amebasmart/Make.defs
@@ -106,13 +106,7 @@ ifeq ($(CONFIG_SCHED_THREAD_LOCAL),y)
   CMN_CSRCS += arm_tls.c
 endif
 
-# The arch up_backtrace() (arm_backtrace_thumb.c / arm_backtrace_fp.c) is only
-# built where the architecture actually provides it.  It is NOT tied to
-# CONFIG_SCHED_BACKTRACE: that option selects the libc sched_backtrace()
-# engine, which unwinds the current thread through libgcc's EHABI unwinder and
-# needs no arch support.  arm_backtrace_thumb.c additionally relies on the
-# _stext_flash/_etext_flash linker symbols, which not every board exports.
-ifeq ($(CONFIG_ARCH_HAVE_BACKTRACE),y)
+ifeq ($(CONFIG_SCHED_BACKTRACE),y)
   ifeq ($(CONFIG_FRAME_POINTER),y)
     ifeq ($(CONFIG_ARM_THUMB),y)
       CMN_CSRCS += arm_backtrace_thumb.c
diff --git a/os/arch/arm/src/armv7-a/Toolchain.defs b/os/arch/arm/src/armv7-a/Toolchain.defs
index 5571a032..b74f6b63 100644
--- a/os/arch/arm/src/armv7-a/Toolchain.defs
+++ b/os/arch/arm/src/armv7-a/Toolchain.defs
@@ -138,15 +138,6 @@ else
   ARCHOPTIMIZATION += -fomit-frame-pointer
 endif
 
-ifeq ($(CONFIG_SCHED_BACKTRACE),y)
-ifneq ($(CONFIG_BUILD_FLAT),y)          # <-- add: "no __KERNEL__" != "user space" in flat builds
-ifeq ($(findstring __KERNEL__,$(EXTRADEFINES)),)
-  ARCHCFLAGS += -funwind-tables
-  ARCHCXXFLAGS += -funwind-tables
-endif
-endif
-endif
-
 ifeq ($(CONFIG_STACK_CANARIES),y)
   ARCHOPTIMIZATION += -fstack-protector-all
 endif
diff --git a/os/include/tinyara/mm/mm.h b/os/include/tinyara/mm/mm.h
index 1a0818bf..cf006133 100644
--- a/os/include/tinyara/mm/mm.h
+++ b/os/include/tinyara/mm/mm.h
@@ -396,16 +396,19 @@ extern unsigned long g_mm_seqno;
 /* MM_ADD_BACKTRACE: record the call-stack into a freshly allocated node.
  * Called from mm_malloc / mm_memalign / mm_realloc once the node is owned.
  *
- * Engines:
- *   CONFIG_SCHED_BACKTRACE (user/flat) - precise EHABI unwind via
- *                                        sched_backtrace().
- *   CONFIG_SCHED_BACKTRACE (kernel)    - arch up_backtrace() frame-pointer
- *                                        walk.  The EHABI unwinder is not
- *                                        safe in early-boot, IDLE or IRQ
- *                                        kernel context, so we fall back to
- *                                        the arch stack scan which is safe in
- *                                        any context (just reads memory).
- *   otherwise                          - arch up_backtrace() stack scan.
+ * The unwinder itself is owned by the arch layer and is selected by the
+ * CONFIG_UNWINDER_* choice.  The heap does not implement or duplicate it; it
+ * only picks an entry point into it:
+ *
+ *   user / flat pass - sched_backtrace(), which resolves the tid to a TCB and
+ *                      then calls the arch unwinder.
+ *   kernel pass      - up_backtrace(NULL, ...) directly.  That is the same
+ *                      unwinder, but skipping the sched_gettcb() lookup keeps
+ *                      the call usable in early-boot, IDLE and IRQ context;
+ *                      the arch entry point detects interrupt context and
+ *                      switches to the interrupt stack on its own.
+ *   no unwinder      - record the sequence number only and leave the call
+ *                      stack empty.
  */
 #if CONFIG_MM_BACKTRACE > 0
 
@@ -446,14 +449,19 @@ int sched_backtrace(pid_t tid, FAR void **buffer, int size, int skip);
 
 #elif defined(CONFIG_SCHED_BACKTRACE) && defined(__KERNEL__)
 
+/* Matches the arch prototype in arch/arm/include/arch.h.  The trailing
+ * asserted_location argument is only meaningful for a user ASSERT taken
+ * through a syscall, so the heap always passes 0.
+ */
 struct tcb_s;
-int up_backtrace(FAR struct tcb_s *tcb, FAR void **buffer, int size, int skip);
+int up_backtrace(FAR struct tcb_s *tcb, FAR void **buffer, int size, int skip,
+		uint32_t asserted_location);
 
 #define MM_ADD_BACKTRACE(node) \
 	do { \
 		int _depth; \
 		_depth = up_backtrace(NULL, (node)->backtrace, \
-					CONFIG_MM_BACKTRACE, g_mm_backtrace_skip); \
+					CONFIG_MM_BACKTRACE, g_mm_backtrace_skip, 0); \
 		if (_depth < 0) { \
 			_depth = 0; \
 		} \
@@ -465,20 +473,12 @@ int up_backtrace(FAR struct tcb_s *tcb, FAR void **buffer, int size, int skip);
 
 #else
 
-struct tcb_s;
-int up_backtrace(FAR struct tcb_s *tcb, FAR void **buffer, int size, int skip);
-
+/* No unwinder configured.  Keep the sequence number so allocations can still
+ * be ordered, and leave the recorded call stack empty.
+ */
 #define MM_ADD_BACKTRACE(node) \
 	do { \
-		int _depth; \
-		_depth = up_backtrace(NULL, (node)->backtrace, \
-					CONFIG_MM_BACKTRACE, g_mm_backtrace_skip); \
-		if (_depth < 0) { \
-			_depth = 0; \
-		} \
-		if (_depth < CONFIG_MM_BACKTRACE) { \
-			(node)->backtrace[_depth] = NULL; \
-		} \
+		(node)->backtrace[0] = NULL; \
 		MM_ADD_SEQNO(node); \
 	} while (0)
 
diff --git a/os/kernel/Kconfig b/os/kernel/Kconfig
index 8e2dad2e..04572371 100644
--- a/os/kernel/Kconfig
+++ b/os/kernel/Kconfig
@@ -874,21 +874,6 @@ config SCHED_ONEXIT
 	---help---
 		Enables the on_exit() API
 
-config SCHED_BACKTRACE
-	bool "Enable thread backtrace via sched_backtrace()"
-	default n
-	---help---
-		Enables sched_backtrace(), which returns the call-stack (return
-		addresses) of a thread.  On ARM this uses the compiler-generated
-		EHABI unwind tables (.ARM.exidx) through libgcc's _Unwind_Backtrace,
-		so it produces a precise backtrace without frame pointers.
-
-		When enabled, CONFIG_MM_BACKTRACE recording (heap allocation
-		backtrace) uses sched_backtrace() instead of the heuristic stack
-		scan.  Requires the code being unwound to be compiled with unwind
-		tables (-funwind-tables), which this option turns on for the
-		user-space pass of a two-pass (protected/kernel) build.
-
 endmenu # RTOS hooks
 
 menu "Signal Numbers"
diff --git a/os/mm/mm_heap/Make.defs b/os/mm/mm_heap/Make.defs
index 9c558d93..d78a49f8 100644
--- a/os/mm/mm_heap/Make.defs
+++ b/os/mm/mm_heap/Make.defs
@@ -71,7 +71,7 @@ endif
 
 # mm.h forces CONFIG_MM_BACKTRACE=3 when CONFIG_DEBUG_MM_HEAPINFO is enabled,
 # so mm_backtrace.c must be compiled in that case too (it provides
-# g_mm_backtrace_skip and the weak up_backtrace stub).
+# g_mm_backtrace_skip).
 ifeq ($(CONFIG_DEBUG_MM_HEAPINFO),y)
 CSRCS += mm_backtrace.c mm_heapinfo_backtrace.c
 else
diff --git a/os/mm/mm_heap/mm_backtrace.c b/os/mm/mm_heap/mm_backtrace.c
index 4cb306b7..4a520189 100644
--- a/os/mm/mm_heap/mm_backtrace.c
+++ b/os/mm/mm_heap/mm_backtrace.c
@@ -43,35 +43,9 @@
 int g_mm_backtrace_skip = CONFIG_MM_BACKTRACE_SKIP;
 #endif
 
-#if (CONFIG_MM_BACKTRACE > 0) && !defined(CONFIG_SCHED_BACKTRACE)
-
-/****************************************************************************
- * Public Functions
- ****************************************************************************/
-
-/****************************************************************************
- * Name: up_backtrace
- *
- * Description:
- *   Weak no-op implementation.  Returns 0 frames and NULL-terminates the
- *   caller's buffer so MM_ADD_BACKTRACE() records an empty call stack.
- *
- * Returned Value:
- *   Always 0 (no frames captured).
- *
- ****************************************************************************/
-
-int __attribute__((weak)) up_backtrace(FAR struct tcb_s *tcb, FAR void **buffer, int size, int skip)
-{
-	(void)tcb;
-	(void)skip;
-
-	if (buffer && size > 0) {
-		buffer[0] = NULL;
-	}
-
-	return 0;
-}
-
-#endif /* (CONFIG_MM_BACKTRACE > 0) && !defined(CONFIG_SCHED_BACKTRACE) */
+/* The stack unwinder lives in the arch layer (see the CONFIG_UNWINDER_*
+ * choice) and is reached through sched_backtrace() / up_backtrace().  This
+ * file therefore carries no unwinder and no fallback stub of its own: when no
+ * unwinder is configured, MM_ADD_BACKTRACE() records the sequence number only.
+ */
 

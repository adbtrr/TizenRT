From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: adbtrr_work6_pr_fixes_use_quaran <>
Date: Thu, 6 Aug 2026 20:44:04 +0000
Subject: [PATCH 3/8] os/mm: Give the detector a range based poison and verify
 primitive

mm_uaf_poison() and mm_uaf_verify() derived the checked window inside
themselves, from the free node layout, so they can only ever cover a
chunk sitting on the free list. How much of a chunk may carry the
pattern actually depends on why the chunk is not in use: one on the
free list has to leave flink, blink and the free debug info alone,
while a chunk held out of the free list entirely can carry the pattern
across its whole user data area.

Split the range out. mm_uaf_poison_range() and mm_uaf_verify_range()
take an explicit start and length, and the existing node based
functions become thin wrappers which pass the free list window. All
call sites are untouched and the values they end up using are
identical, so there is no behavioural or output change.

This is what the delayed reuse change which follows needs in order to
cover a whole payload while the free list path keeps its narrower
window, without having to reopen every call site at that point.

Also set *poison in mm_uaf_area() before the early return, so the
wrappers always hand a valid pointer to the range helpers even for a
chunk too small to carry any pattern.
---
 os/include/tinyara/mm/mm.h |   2 +
 os/mm/mm_heap/mm_uaf.c     | 124 +++++++++++++++++++++++++------------
 2 files changed, 87 insertions(+), 39 deletions(-)

diff --git a/os/include/tinyara/mm/mm.h b/os/include/tinyara/mm/mm.h
index 8cddd18e..635efcbe 100644
--- a/os/include/tinyara/mm/mm.h
+++ b/os/include/tinyara/mm/mm.h
@@ -669,6 +669,8 @@ void mm_addfreechunk(FAR struct mm_heap_s *heap, FAR struct mm_freenode_s *node)
 int mm_size2ndx(size_t size);
 
 #ifdef CONFIG_DEBUG_MM_UAF
+void mm_uaf_poison_range(FAR void *start, size_t nbytes);
+void mm_uaf_verify_range(FAR struct mm_allocnode_s *node, FAR void *start, size_t nbytes);
 void mm_uaf_poison(FAR struct mm_freenode_s *node);
 void mm_uaf_verify(FAR struct mm_freenode_s *node);
 #endif
diff --git a/os/mm/mm_heap/mm_uaf.c b/os/mm/mm_heap/mm_uaf.c
index e6127c5b..41223892 100644
--- a/os/mm/mm_heap/mm_uaf.c
+++ b/os/mm/mm_heap/mm_uaf.c
@@ -78,6 +78,8 @@ static size_t mm_uaf_area(struct mm_freenode_s *node, uint32_t **poison)
 	size_t offset = MM_UAF_ALIGN_UP(SIZEOF_MM_FREENODE);
 	size_t nbytes;
 
+	*poison = (uint32_t *)((char *)node + offset);
+
 	if (node->size <= offset) {
 		/* The chunk is all bookkeeping, there is no room for the pattern */
 
@@ -89,8 +91,6 @@ static size_t mm_uaf_area(struct mm_freenode_s *node, uint32_t **poison)
 		nbytes = CONFIG_DEBUG_MM_UAF_POISON_SIZE;
 	}
 
-	*poison = (uint32_t *)((char *)node + offset);
-
 	return nbytes / sizeof(uint32_t);
 }
 
@@ -99,73 +99,78 @@ static size_t mm_uaf_area(struct mm_freenode_s *node, uint32_t **poison)
  ****************************************************************************/
 
 /****************************************************************************
- * Name: mm_uaf_poison
+ * Name: mm_uaf_poison_range
  *
  * Description:
- *   Fill the data area of a chunk which is about to enter the free list with
- *   the poison pattern. Called for every chunk which becomes free, so that
- *   mm_uaf_verify() has a known content to compare against.
+ *   Fill an explicit range with the poison pattern.
+ *
+ *   The range is passed in rather than derived from the node, because how
+ *   much of a chunk may carry the pattern depends on why the chunk is not in
+ *   use. One on the free list has to leave flink, blink and the free debug
+ *   info alone; one held out of the free list altogether can carry the
+ *   pattern across its whole user data area.
+ *
+ *   'nbytes' is truncated to whole words, so nothing outside the range is
+ *   written.
  *
  *   NOTES:
- *     (1) node->size must already be set to its final value.
- *     (2) the caller must hold the MM semaphore.
+ *     (1) the caller must hold the MM semaphore.
  *
  ****************************************************************************/
 
-void mm_uaf_poison(struct mm_freenode_s *node)
+void mm_uaf_poison_range(FAR void *start, size_t nbytes)
 {
-	uint32_t *poison;
-	size_t nwords;
+	FAR uint32_t *poison = (FAR uint32_t *)start;
+	size_t nwords = nbytes / sizeof(uint32_t);
 	size_t i;
 
-	nwords = mm_uaf_area(node, &poison);
 	for (i = 0; i < nwords; i++) {
 		poison[i] = MM_UAF_PATTERN;
 	}
 }
 
 /****************************************************************************
- * Name: mm_uaf_verify
+ * Name: mm_uaf_verify_range
  *
  * Description:
- *   Check that the poison pattern written by mm_uaf_poison() is still intact
- *   in the chunk which is about to be handed out. Any difference means that
- *   the chunk was written while it was free, which is a use-after-free by
- *   whoever owned it before.
+ *   Check that the pattern written by mm_uaf_poison_range() is still intact
+ *   over an explicit range. Any difference means the memory was written while
+ *   it was not in use, which is a use-after-free by whoever owned it before.
+ *
+ *   'node' is only used to describe the chunk in the report; the range does
+ *   not have to start at the node.
  *
  *   NOTES:
- *     (1) must be called before the chunk is removed from the free list and
- *         split, so that the poisoned area is still the one which was
- *         poisoned when the chunk was freed.
- *     (2) the caller must hold the MM semaphore.
+ *     (1) the caller must hold the MM semaphore.
  *
  ****************************************************************************/
 
-void mm_uaf_verify(struct mm_freenode_s *node)
+void mm_uaf_verify_range(FAR struct mm_allocnode_s *node, FAR void *start, size_t nbytes)
 {
-	uint32_t *poison;
-	size_t nwords;
+	FAR uint32_t *poison = (FAR uint32_t *)start;
+	size_t nwords = nbytes / sizeof(uint32_t);
 	size_t dumpsize;
 	size_t i;
 
-	nwords = mm_uaf_area(node, &poison);
 	for (i = 0; i < nwords; i++) {
 		if (poison[i] != MM_UAF_PATTERN) {
 			break;
 		}
 	}
 
-	if (i >= nwords) {
-		/* The pattern is intact, nothing wrote into the chunk while free */
+	if (i == nwords) {
+		/* Every word still holds the pattern, so nothing wrote into the chunk
+		 * while it was free. An empty range lands here too.
+		 */
 
 		return;
 	}
 
-	/* Show the checked window whatever happens, plus as much of the rest of
+	/* Show the checked range whatever happens, plus as much of the rest of
 	 * the chunk as the bound allows.
 	 */
 
-	dumpsize = MM_UAF_ALIGN_UP(SIZEOF_MM_FREENODE) + nwords * sizeof(uint32_t);
+	dumpsize = (size_t)((FAR char *)start - (FAR char *)node) + nwords * sizeof(uint32_t);
 	if (dumpsize < MM_UAF_DUMP_MAX) {
 		dumpsize = MM_UAF_DUMP_MAX;
 	}
@@ -176,20 +181,61 @@ void mm_uaf_verify(struct mm_freenode_s *node)
 
 	heap_dbg("#########################################################################################\n");
 	mfdbg("ERROR: Use after free detected.\n");
-	mm_dump_node((struct mm_allocnode_s *)node, "FREE NODE");
+	mm_dump_node(node, "FREE NODE");
 	mm_dump_heap_region((uint32_t)node, (uint32_t)node + dumpsize);
 
 #ifdef CONFIG_DEBUG_MM_UAF_PANIC
 	PANIC();
 #else
-	/* Repair the pattern now that the corruption has been reported.
-	 *
-	 * mm_realloc() verifies both neighbours before it decides whether to
-	 * consume either of them. A neighbour it does not consume stays on the
-	 * free list still corrupted, so without this repair every later realloc
-	 * touching it prints the same report again, forever, from one defect.
-	 */
-
-	mm_uaf_poison(node);
+	mm_uaf_poison_range(start, nbytes);
 #endif
 }
+
+/****************************************************************************
+ * Name: mm_uaf_poison
+ *
+ * Description:
+ *   Fill the data area of a chunk which is about to enter the free list with
+ *   the poison pattern. Called for every chunk which becomes free, so that
+ *   mm_uaf_verify() has a known content to compare against.
+ *
+ *   NOTES:
+ *     (1) node->size must already be set to its final value.
+ *     (2) the caller must hold the MM semaphore.
+ *
+ ****************************************************************************/
+
+void mm_uaf_poison(FAR struct mm_freenode_s *node)
+{
+	uint32_t *poison;
+	size_t nwords;
+
+	nwords = mm_uaf_area(node, &poison);
+	mm_uaf_poison_range(poison, nwords * sizeof(uint32_t));
+}
+
+/****************************************************************************
+ * Name: mm_uaf_verify
+ *
+ * Description:
+ *   Check that the poison pattern written by mm_uaf_poison() is still intact
+ *   in a chunk which is about to be consumed. Any difference means that the
+ *   chunk was written while it was free, which is a use-after-free by whoever
+ *   owned it before.
+ *
+ *   NOTES:
+ *     (1) must be called before the chunk is split, merged or resized, so
+ *         that the checked area is still the one which was poisoned when the
+ *         chunk was freed.
+ *     (2) the caller must hold the MM semaphore.
+ *
+ ****************************************************************************/
+
+void mm_uaf_verify(FAR struct mm_freenode_s *node)
+{
+	uint32_t *poison;
+	size_t nwords;
+
+	nwords = mm_uaf_area(node, &poison);
+	mm_uaf_verify_range((FAR struct mm_allocnode_s *)node, poison, nwords * sizeof(uint32_t));
+}

+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/log_dump ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/log_dump/log_dump.c
+ *     static int log_dump_tobuffer(char ch, size_t *free_size)
+ *     {
+ *             ...
+ *             } else {  // there is place in tail
+ *                     struct log_dump_chunk_s *log_dump_tail =
+ *                             (struct log_dump_chunk_s *)sq_tail(&log_dump_chunks);
+ *                     ASSERT(log_dump_tail);
+ *                     log_dump_tail->arr[compress_curbytes] = ch;
+ *
+ * log_dump_init() always leaves one chunk on the queue and
+ * log_dump_mem_check() never drops the last one, so the queue is never
+ * empty while the log dump is running. An empty queue on this path means
+ * the chunk bookkeeping is corrupted and the compressed character has
+ * nowhere to go, which the assertion catches before the NULL dereference.
+ *
+ * log_dump_tobuffer() is static and works on file scope state, so the test
+ * is driven through log_dump_tobuffer_asserttest() which is built into
+ * log_dump.c only when this test case is enabled.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/os_api_test_drv.h>
+#ifdef CONFIG_LOG_DUMP
+#include <tinyara/log_dump/log_dump.h>
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_log_dump
+ *
+ * Description:
+ *   Append a compressed character while the chunk queue is empty so that
+ *   ASSERT(log_dump_tail) in os/kernel/log_dump/log_dump.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the test case is built in.
+ *   -ENOSYS is returned otherwise.
+ *
+ ****************************************************************************/
+
+int test_assert_log_dump(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#ifdef CONFIG_LOG_DUMP
+	lldbg("Saving a log character with no chunk queued\n");
+
+	/* ASSERT(log_dump_tail) in log_dump_tobuffer() is hit here. */
+
+	log_dump_tobuffer_asserttest();
+
+	return OK;
+#else
+	lldbg("CONFIG_LOG_DUMP is required\n");
+
+	return -ENOSYS;
+#endif
+}

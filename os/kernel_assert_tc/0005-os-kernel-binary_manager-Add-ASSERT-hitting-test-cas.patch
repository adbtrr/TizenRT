+/// @file tc_assert_binary_manager.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/binary_manager
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_binary_manager_recover_tcb_null_waitsem
+ * @brief                :Hit ASSERT(sem != NULL && sem->semcount < 0) of binary_manager_recover_tcb()
+ * @scenario             :Recover a thread in TSTATE_WAIT_SEM which carries no wait semaphore
+ * Assertion under test  :os/kernel/binary_manager/binary_manager_recovery.c
+ *                       :ASSERT(sem != NULL && sem->semcount < 0);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_binary_manager_recover_tcb_null_waitsem(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_BINARY_MANAGER] Recover a thread in TSTATE_WAIT_SEM which carries no wait semaphore\n");
+	printf("[TC_ASSERT_BINARY_MANAGER] Expecting an assertion at os/kernel/binary_manager/binary_manager_recovery.c\n");
+	printf("[TC_ASSERT_BINARY_MANAGER] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_BINARY_MANAGER, 0);
+
+	printf("[TC_ASSERT_BINARY_MANAGER] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_BINARY_MANAGER] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("binary_manager_recover_tcb ASSERT was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int binary_manager_assert_main(void)
+{
+	tc_assert_binary_manager_recover_tcb_null_waitsem();
+
+	return 0;
+}

+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/binary_manager ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/binary_manager/binary_manager_recovery.c
+ *     static void binary_manager_recover_tcb(struct tcb_s *tcb)
+ *     {
+ *             ...
+ *             if (state == TSTATE_WAIT_SEM) {
+ *                     sem = tcb->waitsem;
+ *                     ASSERT(sem != NULL && sem->semcount < 0);
+ *
+ * While recovering a faulted binary the binary manager releases every
+ * resource its threads were blocked on. A thread parked in TSTATE_WAIT_SEM
+ * always carries a valid waitsem whose count went negative when it blocked,
+ * so a NULL waitsem or a non negative count means the thread bookkeeping is
+ * corrupted and recovery cannot continue.
+ *
+ * binary_manager_recover_tcb() is static, so the test is driven through
+ * binary_manager_recover_tcb_asserttest() which is built into
+ * binary_manager_recovery.c only when this test case is enabled.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/os_api_test_drv.h>
+#include <tinyara/sched.h>
+#ifdef CONFIG_BINMGR_RECOVERY
+#include "binary_manager/binary_manager_internal.h"
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_binary_manager
+ *
+ * Description:
+ *   Recover a thread which claims to be blocked on a semaphore but carries
+ *   no wait semaphore, so that
+ *   ASSERT(sem != NULL && sem->semcount < 0) in
+ *   os/kernel/binary_manager/binary_manager_recovery.c is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the test case is built in.
+ *   -ENOSYS is returned otherwise.
+ *
+ ****************************************************************************/
+
+int test_assert_binary_manager(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#ifdef CONFIG_BINMGR_RECOVERY
+	lldbg("Recovering a thread blocked on a NULL semaphore\n");
+
+	/* ASSERT(sem != NULL && sem->semcount < 0) in
+	 * binary_manager_recover_tcb() is hit here.
+	 */
+
+	binary_manager_recover_tcb_asserttest();
+
+	return OK;
+#else
+	lldbg("CONFIG_BINMGR_RECOVERY is required\n");
+
+	return -ENOSYS;
+#endif
+}

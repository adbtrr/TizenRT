diff --git a/os/drivers/os_api_test/kernel/test_sched.c b/os/drivers/os_api_test/kernel/test_sched.c
index 8b2e9971..b2f8e594 100644
--- a/os/drivers/os_api_test/kernel/test_sched.c
+++ b/os/drivers/os_api_test/kernel/test_sched.c
@@ -26,6 +26,11 @@
 
 #include <tinyara/os_api_test_drv.h>
 #include <tinyara/sched.h>

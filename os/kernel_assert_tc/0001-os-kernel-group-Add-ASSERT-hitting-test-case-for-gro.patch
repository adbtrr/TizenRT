+/* Kernel module ASSERT test commands.
+ *
+ * Each command deliberately violates the precondition of one kernel API so
+ * that the ASSERT()/DEBUGASSERT() guarding that precondition is executed.
+ * The board asserts and reboots when the command succeeds, so exactly one
+ * of these test cases may be enabled in a build.
+ */
+
+#ifdef CONFIG_TC_KERNEL_ASSERT_GROUP
+#define TESTIOC_ASSERT_GROUP                   _TESTIOC(25)
+#endif
+
 #define OS_API_TEST_DRVPATH	"/dev/os_api_test"
 
 /****************************************************************************

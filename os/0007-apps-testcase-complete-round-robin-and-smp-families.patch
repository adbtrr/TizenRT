 }
 
+/****************************************************************************
+ * Name: stc_transitions
+ ****************************************************************************/
+
+uint32_t stc_transitions(int idx)
+{
+	if (idx < 0 || idx >= STC_MAX_WORKERS) {
+		return 0;
+	}
+
+	return g_cpuobs_transitions[idx];
+}

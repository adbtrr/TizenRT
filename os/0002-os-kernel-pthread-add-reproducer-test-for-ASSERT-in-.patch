+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/// @file tc_pthread_assert.c
+
+/// @brief Negative test case which provokes the ASSERT in pthread_create()
+///        at os/kernel/pthread/pthread_create.c.
+///
+/// Target
+/// ------
+/// os/kernel/pthread contains exactly one always-compiled-in ASSERT; every
+/// other assertion in that directory is a DEBUGASSERT, which only exists when
+/// CONFIG_DEBUG is set.  The one that is always live is:
+///
+///     #ifdef CONFIG_APP_BINARY_SEPARATION
+///             ASSERT((sched_self()->flags & TCB_FLAG_TTYPE_MASK) != TCB_FLAG_TTYPE_KERNEL);
+///     #endif
+///
+/// Under app binary separation a pthread has to belong to the task group of a
+/// user binary, so pthread_create() rejects a call made on behalf of a kernel
+/// thread.  It rejects it by panicking rather than by returning an error code,
+/// even though the very next lines of the same function return EBUSY and
+/// ENOMEM for other failures.
+///
+/// How the assert is reached
+/// -------------------------
+/// A user space task cannot trip this on its own.  Every thread it can spawn
+/// is TCB_FLAG_TTYPE_TASK (task_create) or TCB_FLAG_TTYPE_PTHREAD
+/// (pthread_create); only kernel_thread() passes TCB_FLAG_TTYPE_KERNEL to
+/// thread_create() (os/kernel/task/task_create.c).  So the test asks the OS
+/// API test driver to spawn a real kernel thread, and that thread calls
+/// pthread_create().
+///
+/// Unlike the mqueue ASSERT(btcb), this one is not a race: the kernel thread
+/// reaches pthread_create() and the assert fires on the first call, every
+/// time.
+///
+/// Expected result: the board panics with
+///     Assertion failed at file:pthread/pthread_create.c line: 261
+///
+/// Requires CONFIG_APP_BINARY_SEPARATION=y.  Without it the assert is not
+/// compiled at all, and this test reports that instead of claiming a pass.
+///
+/// This test is destructive by design.  It is default n in Kconfig and is not
+/// selected by CONFIG_TC_KN_ALL.
+
+/**************************************************************************
+* Included Files
+**************************************************************************/
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**************************************************************************
+* Private Functions
+**************************************************************************/
+
+/**
+* @fn                   :tc_pthread_assert_create_from_kthread
+* @description          :Ask the OS API test driver to run pthread_create()
+*                        on a kernel thread, which trips the ASSERT in
+*                        pthread_create().
+* @return               :void
+*/
+static void tc_pthread_assert_create_from_kthread(void)
+{
+	int fd;
+	int ret;
+
+	printf("tc_pthread_assert: targeting ASSERT in pthread_create()"
+		" (os/kernel/pthread/pthread_create.c)\n");
+#ifdef CONFIG_APP_BINARY_SEPARATION
+	printf("tc_pthread_assert: spawning a kernel thread that calls"
+		" pthread_create(); the assert should be immediate\n");
+#else
+	printf("tc_pthread_assert: CONFIG_APP_BINARY_SEPARATION is disabled,"
+		" so the assert is not compiled into this build\n");
+#endif
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	/* The kernel is expected to die inside this ioctl. */
+
+	ret = ioctl(fd, TESTIOC_PTHREAD_CREATE_FROM_KTHREAD, 0);
+
+	/* Reaching this point means pthread_create() returned to the kernel
+	 * thread instead of asserting, which happens when the assert is compiled
+	 * out.  Report it rather than claiming a pass.
+	 */
+
+	printf("tc_pthread_assert: NOT REPRODUCED, ioctl returned %d (errno %d)\n",
+		ret, ret < 0 ? errno : 0);
+	printf("tc_pthread_assert: rebuild with CONFIG_APP_BINARY_SEPARATION=y"
+		" so the assert exists\n");
+}
+
+/**************************************************************************
+* Public Functions
+**************************************************************************/
+
+int pthread_assert_main(void)
+{
+	tc_pthread_assert_create_from_kthread();
+
+	return 0;
+}

+
+/// @file tc_assert_group.c
+
+/// @brief Negative test case which hits the ASSERT of os/kernel/group
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <tinyara/os_api_test_drv.h>
+#include "tc_internal.h"
+
+/**
+ * @fn                   :tc_assert_group_foreachchild_null_group
+ * @brief                :Hit DEBUGASSERT(group) of group_foreachchild()
+ * @scenario             :Call group_foreachchild() with a NULL task group
+ * Assertion under test  :os/kernel/group/group_foreachchild.c
+ *                       :DEBUGASSERT(group);
+ * Expected result       :The board asserts and this function never returns.
+ *                       :Returning from the ioctl means the ASSERT was not
+ *                       :hit and the test case fails.
+ * @return               :void
+ */
+
+static void tc_assert_group_foreachchild_null_group(void)
+{
+	int fd;
+	int ret_chk;
+
+	fd = tc_get_drvfd();
+	TC_ASSERT_GEQ("tc_get_drvfd", fd, 0);
+
+	printf("\n[TC_ASSERT_GROUP] Call group_foreachchild() with a NULL task group\n");
+	printf("[TC_ASSERT_GROUP] Expecting an assertion at os/kernel/group/group_foreachchild.c\n");
+	printf("[TC_ASSERT_GROUP] The board is expected to crash dump and reboot now.\n");
+
+	/* The kernel side helper violates the precondition of the API under
+	 * test.  Control is not expected to come back from this ioctl.
+	 */
+
+	ret_chk = ioctl(fd, TESTIOC_ASSERT_GROUP, 0);
+
+	printf("[TC_ASSERT_GROUP] ioctl returned %d, the ASSERT was not hit\n", ret_chk);
+	if (ret_chk == -ENOSYS) {
+		printf("[TC_ASSERT_GROUP] Enable CONFIG_DEBUG so that DEBUGASSERT() is built in\n");
+	}
+
+	TC_ASSERT("group_foreachchild DEBUGASSERT(group) was not hit", false);
+
+	TC_SUCCESS_RESULT();
+}
+
+int group_assert_main(void)
+{
+	tc_assert_group_foreachchild_null_group();
+
+	return 0;
+}

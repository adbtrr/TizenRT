+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Kernel side helper for the os/kernel/paging ASSERT test case.
+ *
+ * Target assertion:
+ *   os/kernel/paging/pg_miss.c
+ *     void pg_miss(void)
+ *     {
+ *             FAR struct tcb_s *ftcb = this_task();
+ *             ...
+ *             DEBUGASSERT(g_pgworker != ftcb->pid);
+ *
+ * The page fill worker thread is the only thread which can resolve a page
+ * fault, so it must never take one itself. pg_miss() blocks the faulting
+ * task and then signals the worker, which would deadlock the system if the
+ * worker were the faulting task. The assertion catches that case.
+ *
+ * The test case makes the calling task look like the page fill worker by
+ * pointing g_pgworker at it, which is exactly the state the assertion
+ * defends against.
+ *
+ * Requires CONFIG_PAGING and CONFIG_DEBUG.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+#include <sys/types.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <tinyara/os_api_test_drv.h>
+#include <tinyara/sched.h>
+#ifdef CONFIG_PAGING
+#include <tinyara/page.h>
+#include "paging/paging.h"
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: test_assert_paging
+ *
+ * Description:
+ *   Make the caller the page fill worker thread and take a page fault so
+ *   that DEBUGASSERT(g_pgworker != ftcb->pid) in os/kernel/paging/pg_miss.c
+ *   is hit.
+ *
+ * Returned Value:
+ *   This function does not return when the assertion is enabled.
+ *   -ENOSYS is returned when the assertion is compiled out.
+ *
+ ****************************************************************************/
+
+int test_assert_paging(int cmd, unsigned long arg)
+{
+	(void)cmd;
+	(void)arg;
+
+#if defined(CONFIG_PAGING) && defined(CONFIG_DEBUG)
+	pid_t saved_pgworker;
+
+	saved_pgworker = g_pgworker;
+
+	lldbg("Reporting a page fault from the page fill worker thread\n");
+
+	/* Claim the identity of the page fill worker thread. pg_miss() is then
+	 * called by the very thread which is supposed to service the fill.
+	 */
+
+	g_pgworker = this_task()->pid;
+
+	/* DEBUGASSERT(g_pgworker != ftcb->pid) in pg_miss() is hit here. */
+
+	pg_miss();
+
+	/* Not reached while the assertion is built in. Restore the worker so
+	 * that paging keeps working if it ever is.
+	 */
+
+	g_pgworker = saved_pgworker;
+
+	return OK;
+#else
+	lldbg("CONFIG_PAGING and CONFIG_DEBUG are required\n");
+
+	return -ENOSYS;
+#endif
+}

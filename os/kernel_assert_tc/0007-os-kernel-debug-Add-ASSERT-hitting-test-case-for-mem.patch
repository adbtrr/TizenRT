diff --git a/apps/examples/testcase/le_tc/kernel/Kconfig b/apps/examples/testcase/le_tc/kernel/Kconfig
index 2056824c..3be2d4e6 100644
--- a/apps/examples/testcase/le_tc/kernel/Kconfig
+++ b/apps/examples/testcase/le_tc/kernel/Kconfig
@@ -367,5 +367,22 @@ config TC_KERNEL_ASSERT_INIT
 		This test case crashes the board on purpose, so enable it
 		alone and never together with the other ASSERT test cases.
 
+config TC_KERNEL_ASSERT_DEBUG
+	bool "Debug module ASSERT test"
+	default n
+	depends on MEM_LEAK_CHECKER
+	---help---
+		Hit ASSERT(ctcb != NULL) in os/kernel/debug/mem_leak_checker.c
+		by running run_all_mem_leak_checker() for a pid which is not
+		running. heap_check() needs the stack of the checker thread so
+		that it can leave it out of the scan, and rejects a pid with no
+		TCB behind it.
+
+		The assertion is an ASSERT(), so it is built in whether or not
+		CONFIG_DEBUG is enabled.
+
+		This test case crashes the board on purpose, so enable it
+		alone and never together with the other ASSERT test cases.
+
 endif #EXAMPLES_TESTCASE_KERNEL
 

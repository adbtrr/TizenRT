+#
+# For a description of the syntax of this configuration file,
+# see kconfig-language at https://www.kernel.org/doc/Documentation/kbuild/kconfig-language.txt
+#
+
+config EXAMPLES_MM_QUARANTINE_TEST
+	bool "Example which exercises the heap quarantine"
+	default n
+	depends on DEBUG_MM_QUARANTINE
+	---help---
+		Checks the behaviour DEBUG_MM_QUARANTINE is supposed to provide, and
+		reports pass or fail per check rather than asking the reader to
+		interpret a log. The checks cover delayed reuse of a freed address,
+		that the delay is bounded so memory is still recycled, and that
+		holding memory back never turns into an allocation failure.
+
+		The last two cases corrupt the heap on purpose to show the reports
+		that the quarantine makes possible. Do not enable this in a product.
+
+config USER_ENTRYPOINT
+	string
+	default "quartest_main" if ENTRY_MM_QUARANTINE_TEST

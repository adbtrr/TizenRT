diff --git a/os/arch/arm/src/armv7-a/Toolchain.defs b/os/arch/arm/src/armv7-a/Toolchain.defs
index b74f6b63..6866aa2d 100644
--- a/os/arch/arm/src/armv7-a/Toolchain.defs
+++ b/os/arch/arm/src/armv7-a/Toolchain.defs
@@ -138,6 +138,28 @@ else
   ARCHOPTIMIZATION += -fomit-frame-pointer
 endif
 
+# sched_backtrace() walks the EHABI unwind tables (.ARM.exidx) via libgcc's
+# _Unwind_Backtrace.  Without unwind tables a C function gets only an
+# EXIDX_CANTUNWIND entry and the unwinder stops immediately.
+#
+# Enable it for USER-space objects only, and only in a two-pass build.  The
+# kernel image spans flash + SRAM + DRAM; unwind tables on RAM-resident kernel
+# code emit .ARM.exidx entries whose R_ARM_PREL31 relocation to the far RAM
+# address overflows at link time.
+#
+# A kernel pass carries __KERNEL__ in EXTRADEFINES and a user pass does not, so
+# that test isolates the user pass.  It cannot do so in a flat build, where no
+# directory is compiled with __KERNEL__ and the test would match the whole
+# image - hence the explicit CONFIG_BUILD_FLAT exclusion.
+ifeq ($(CONFIG_SCHED_BACKTRACE),y)
+ifneq ($(CONFIG_BUILD_FLAT),y)
+ifeq ($(findstring __KERNEL__,$(EXTRADEFINES)),)
+  ARCHCFLAGS += -funwind-tables
+  ARCHCXXFLAGS += -funwind-tables
+endif
+endif
+endif
+
 ifeq ($(CONFIG_STACK_CANARIES),y)
   ARCHOPTIMIZATION += -fstack-protector-all
 endif
diff --git a/os/drivers/memory/mminfo.c b/os/drivers/memory/mminfo.c

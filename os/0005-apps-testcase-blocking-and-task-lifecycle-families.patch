+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+ * either express or implied. See the License for the specific
+ * language governing permissions and limitations under the License.
+ *
+ ****************************************************************************/
+
+/// @file stc_sched_lifecycle.c
+
+/// @brief Scenario test cases for task lifecycle under contention
+///        (family G)
+///
+/// Creating and destroying tasks is exercised constantly by the existing
+/// tests, but always on an idle system.  These scenarios do it while every
+/// CPU is busy, and while the task being removed is running somewhere else
+/// or blocked on something, which is where the list manipulation is at its
+/// most delicate.
+///
+/// The oracles are deliberately about what is left behind rather than about
+/// timing.  A scheduler defect here does not usually announce itself; it
+/// leaks a task control block, or leaves a stale entry on a wait list, and
+/// the system degrades later for no visible reason.
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <tinyara/config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <string.h>
+#include <unistd.h>
+#include <semaphore.h>
+#include <pthread.h>
+#include <sched.h>
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <tinyara/sched.h>
+#include <tinyara/os_api_test_drv.h>
+
+#include "tc_internal.h"
+#include "stc_sched_common.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Number of create and exit cycles in the churn scenario.  The catalogue
+ * calls for a thousand, which is enough for a per task leak of even a few
+ * bytes to become unmistakable against normal heap noise.
+ */
+
+#define STC_LIFE_CHURN_COUNT    1000
+
+/* Slack allowed on the task control block count after the churn.  Ideally
+ * this is zero, but unrelated system activity may legitimately create or
+ * retire a task during the run, so a small allowance avoids a false failure
+ * while still catching a per iteration leak, which would show up as
+ * hundreds.
+ */
+
+#define STC_LIFE_TCB_SLACK      4
+
+/* Slack allowed on the heap, in bytes, for the same reason. */
+
+#define STC_LIFE_HEAP_SLACK     2048
+
+/* Bound on how long a cancellation may take to take effect. */
+
+#define STC_LIFE_CANCEL_MS      500
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static volatile int g_life_tcb_count;
+static volatile bool g_life_spin_run;
+static volatile bool g_life_cancelled_exited;
+
+static sem_t g_life_sem;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_life_count_cb
+ *
+ * Description:
+ *   Counts one task.  Runs inside sched_foreach(), which holds a critical
+ *   section, so it does nothing else.
+ *
+ ****************************************************************************/
+
+static void stc_life_count_cb(struct tcb_s *tcb, void *arg)
+{
+	if (tcb != NULL) {
+		g_life_tcb_count++;
+	}
+}
+
+/****************************************************************************
+ * Name: stc_life_tcb_count
+ ****************************************************************************/
+
+static int stc_life_tcb_count(void)
+{
+	int fd = tc_get_drvfd();
+
+	g_life_tcb_count = 0;
+	(void)ioctl(fd, TESTIOC_SCHED_FOREACH,
+		    (unsigned long)stc_life_count_cb);
+
+	return g_life_tcb_count;
+}
+
+/****************************************************************************
+ * Name: stc_life_heap_used
+ *
+ * Description:
+ *   Bytes currently handed out by the allocator.  The two shapes of
+ *   mallinfo() differ by configuration, so both are handled.
+ *
+ ****************************************************************************/
+
+static int stc_life_heap_used(void)
+{
+	struct mallinfo info;
+
+#ifdef CONFIG_CAN_PASS_STRUCTS
+	info = mallinfo();
+#else
+	memset(&info, 0, sizeof(info));
+	(void)mallinfo(&info);
+#endif
+
+	return info.uordblks;
+}
+
+/****************************************************************************
+ * Name: stc_life_short_task
+ ****************************************************************************/
+
+static int stc_life_short_task(int argc, char *argv[])
+{
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_life_spin_task
+ ****************************************************************************/
+
+static int stc_life_spin_task(int argc, char *argv[])
+{
+	volatile uint32_t sink = 0;
+
+	while (g_life_spin_run) {
+		sink++;
+	}
+
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_life_blocked_task
+ ****************************************************************************/
+
+static int stc_life_blocked_task(int argc, char *argv[])
+{
+	(void)sem_wait(&g_life_sem);
+	return OK;
+}
+
+/****************************************************************************
+ * Name: stc_life_cancellable_thread
+ *
+ * Description:
+ *   Loops over an explicit cancellation point.  Deferred cancellation only
+ *   takes effect at such a point, so a thread that never reaches one would
+ *   never be cancelled and the scenario would be testing nothing.
+ *
+ ****************************************************************************/
+
+static void *stc_life_cancellable_thread(void *arg)
+{
+	(void)pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL);
+	(void)pthread_setcanceltype(PTHREAD_CANCEL_DEFERRED, NULL);
+
+	for (; ; ) {
+		pthread_testcancel();
+		usleep(1000);
+	}
+
+	g_life_cancelled_exited = true;
+	return NULL;
+}
+
+/****************************************************************************
+ * Name: stc_sched_life01_churn_under_load
+ *
+ * @testcase             :stc_sched_life01_churn_under_load
+ * @brief                :SCN-LIFE-01, task churn under saturation leaks
+ *                        nothing
+ * @scenario             :Saturate every CPU with CPU bound work, then create
+ *                        and retire a thousand short lived tasks, and
+ *                        compare the task control block count and the heap
+ *                        usage before and after.
+ *                        Creating a task under contention takes a different
+ *                        path from creating one on an idle system: the new
+ *                        task may not be able to run immediately, may be
+ *                        placed on a different list, and may be retired from
+ *                        a state the idle case never reaches.  A per
+ *                        iteration leak of even one control block is
+ *                        invisible in a single create and destroy test and
+ *                        unmistakable after a thousand.
+ * @apicovered           :task_create, sched_foreach via the test driver,
+ *                        mallinfo
+ * @precondition         :none
+ * @postcondition        :all workers exited, no tasks leaked
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_life01_churn_under_load(void)
+{
+	struct stc_workload_s wl;
+	int ncpus = stc_ncpus();
+	int tcb_before;
+	int tcb_after;
+	int heap_before;
+	int heap_after;
+	int created = 0;
+	int start_ret;
+	int finish_ret;
+	int i;
+	pid_t pid;
+
+	stc_workload_init(&wl, ncpus, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	start_ret = stc_workload_start(&wl);
+
+	/* Let the load settle before taking the baseline, so the workers
+	 * themselves are inside it rather than straddling it.
+	 */
+
+	usleep(200 * 1000);
+
+	tcb_before = stc_life_tcb_count();
+	heap_before = stc_life_heap_used();
+
+	for (i = 0; i < STC_LIFE_CHURN_COUNT; i++) {
+		pid = task_create("stclife", SCHED_PRIORITY_DEFAULT + 5,
+				  STC_WORKER_STACKSIZE, stc_life_short_task,
+				  (char * const *)NULL);
+		if (pid > 0) {
+			created++;
+		}
+
+		/* Yield often enough that the short lived tasks get to run and
+		 * retire rather than piling up.
+		 */
+
+		if ((i % 16) == 15) {
+			usleep(1000);
+		}
+	}
+
+	/* Give the last of them time to retire. */
+
+	usleep(500 * 1000);
+
+	tcb_after = stc_life_tcb_count();
+	heap_after = stc_life_heap_used();
+
+	finish_ret = stc_workload_finish(ncpus);
+
+	printf("[SCN-LIFE-01] created=%d tcb %d->%d heap %d->%d\n",
+	       created, tcb_before, tcb_after, heap_before, heap_after);
+
+	TC_ASSERT_EQ("life01_workload_start", start_ret, OK);
+	TC_ASSERT_EQ("life01_workload_finish", finish_ret, OK);
+
+	/* The churn actually happened. */
+
+	TC_ASSERT_EQ("life01_all_created", created, STC_LIFE_CHURN_COUNT);
+
+	/* And left nothing behind. */
+
+	TC_ASSERT_LEQ("life01_no_tcb_leak", tcb_after,
+		      tcb_before + STC_LIFE_TCB_SLACK);
+	TC_ASSERT_LEQ("life01_no_heap_leak", heap_after,
+		      heap_before + STC_LIFE_HEAP_SLACK);
+
+	TC_SUCCESS_RESULT();
+}
+
+#ifdef CONFIG_SMP
+/****************************************************************************
+ * Name: stc_sched_life02_delete_remote_running
+ *
+ * @testcase             :stc_sched_life02_delete_remote_running
+ * @brief                :SCN-LIFE-02, deleting a task running on another CPU
+ * @scenario             :Pin a CPU bound task to the highest numbered CPU,
+ *                        let it run, and delete it from this CPU.
+ *                        Removing a task that is merely ready is a list
+ *                        operation.  Removing one that is executing on
+ *                        another CPU is not: that CPU has to be interrupted
+ *                        and made to pick something else, and the deleting
+ *                        CPU has to wait for that to happen before the
+ *                        control block can be released.  It is the most
+ *                        intricate removal path in the scheduler and the one
+ *                        least likely to be covered by accident.
+ *                        Afterwards the task must be gone and the system
+ *                        must still schedule normally, which is checked by
+ *                        running a fresh workload.
+ * @apicovered           :task_delete, sched_setaffinity, task_create
+ * @precondition         :CONFIG_SMP_NCPUS greater than one
+ * @postcondition        :task deleted, scheduling still functional
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_life02_delete_remote_running(void)
+{
+	struct stc_workload_s wl;
+	cpu_set_t remote_mask = 0;
+	pid_t victim;
+	int ncpus = stc_ncpus();
+	int tcb_before;
+	int tcb_after;
+	int del_ret;
+	int run_ret;
+
+	g_life_spin_run = true;
+
+	CPU_SET(ncpus - 1, &remote_mask);
+
+	tcb_before = stc_life_tcb_count();
+
+	victim = task_create("stcvict", SCHED_PRIORITY_DEFAULT,
+			     STC_WORKER_STACKSIZE, stc_life_spin_task,
+			     (char * const *)NULL);
+
+	if (victim > 0) {
+		(void)sched_setaffinity(victim, sizeof(cpu_set_t),
+					&remote_mask);
+	}
+
+	/* Let it settle on the remote CPU and start spinning. */
+
+	usleep(300 * 1000);
+
+	del_ret = task_delete(victim);
+
+	usleep(200 * 1000);
+
+	tcb_after = stc_life_tcb_count();
+
+	/* The scheduler still works afterwards. */
+
+	stc_workload_init(&wl, ncpus, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+	wl.window_ms = 500;
+	run_ret = stc_run_workload(&wl);
+
+	g_life_spin_run = false;
+
+	printf("[SCN-LIFE-02] victim=%d del=%d tcb %d->%d\n",
+	       (int)victim, del_ret, tcb_before, tcb_after);
+
+	TC_ASSERT_GT("life02_victim_created", victim, 0);
+	TC_ASSERT_EQ("life02_delete_ok", del_ret, OK);
+
+	/* The control block came back. */
+
+	TC_ASSERT_LEQ("life02_no_leak", tcb_after,
+		      tcb_before + STC_LIFE_TCB_SLACK);
+
+	/* And the system still schedules. */
+
+	TC_ASSERT_EQ("life02_still_scheduling", run_ret, OK);
+	TC_ASSERT_GT("life02_workers_ran", stc_min(ncpus), 0);
+
+	TC_SUCCESS_RESULT();
+}
+#endif							/* CONFIG_SMP */
+
+/****************************************************************************
+ * Name: stc_sched_life03_delete_blocked
+ *
+ * @testcase             :stc_sched_life03_delete_blocked
+ * @brief                :SCN-LIFE-03, deleting a task blocked on a semaphore
+ * @scenario             :Park two tasks on a semaphore, delete the first,
+ *                        then post the semaphore once and confirm the second
+ *                        wakes.
+ *                        A deleted waiter has to be taken off the
+ *                        semaphore's wait list as well as out of the task
+ *                        lists.  If a stale entry survives, the next post
+ *                        is delivered to a task that no longer exists and
+ *                        the remaining waiter is left blocked forever, which
+ *                        is exactly what the second half of this scenario
+ *                        detects.  Checking only that the delete returned
+ *                        success would miss it entirely.
+ * @apicovered           :task_delete, sem_wait, sem_post, task_create
+ * @precondition         :none
+ * @postcondition        :both tasks gone, semaphore destroyed
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_life03_delete_blocked(void)
+{
+	pid_t first;
+	pid_t second;
+	int tcb_before;
+	int tcb_after;
+	int del_ret;
+	int post_ret;
+	int remaining_before;
+	int remaining_after;
+
+	if (sem_init(&g_life_sem, 0, 0) != OK) {
+		TC_ASSERT("life03_sem_init", false);
+	}
+
+	tcb_before = stc_life_tcb_count();
+
+	first = task_create("stcblk1", SCHED_PRIORITY_DEFAULT,
+			    STC_WORKER_STACKSIZE, stc_life_blocked_task,
+			    (char * const *)NULL);
+	usleep(100 * 1000);
+
+	second = task_create("stcblk2", SCHED_PRIORITY_DEFAULT,
+			     STC_WORKER_STACKSIZE, stc_life_blocked_task,
+			     (char * const *)NULL);
+	usleep(100 * 1000);
+
+	remaining_before = stc_life_tcb_count();
+
+	/* Remove the first waiter while it is still blocked. */
+
+	del_ret = task_delete(first);
+
+	usleep(100 * 1000);
+
+	/* One post should now release the surviving waiter.  If a stale entry
+	 * was left behind, the post goes to the deleted task and this one
+	 * stays blocked.
+	 */
+
+	post_ret = sem_post(&g_life_sem);
+
+	usleep(300 * 1000);
+
+	remaining_after = stc_life_tcb_count();
+	tcb_after = remaining_after;
+
+	(void)sem_destroy(&g_life_sem);
+
+	printf("[SCN-LIFE-03] del=%d tcb %d (both blocked %d) -> %d\n",
+	       del_ret, tcb_before, remaining_before, remaining_after);
+
+	TC_ASSERT_GT("life03_first_created", first, 0);
+	TC_ASSERT_GT("life03_second_created", second, 0);
+	TC_ASSERT_EQ("life03_delete_ok", del_ret, OK);
+	TC_ASSERT_EQ("life03_post_ok", post_ret, OK);
+
+	/* Both tasks are gone: the deleted one and the one the post released.
+	 * A surviving blocked waiter would leave the count higher.
+	 */
+
+	TC_ASSERT_LEQ("life03_no_stale_waiter", tcb_after,
+		      tcb_before + STC_LIFE_TCB_SLACK);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Name: stc_sched_life04_cancel_under_load
+ *
+ * @testcase             :stc_sched_life04_cancel_under_load
+ * @brief                :SCN-LIFE-04, cancellation takes effect under
+ *                        saturation
+ * @scenario             :Saturate every CPU, start a thread that loops over
+ *                        an explicit cancellation point, cancel it and join
+ *                        it.
+ *                        Deferred cancellation only takes effect when the
+ *                        target reaches a cancellation point, so under
+ *                        saturation the target has to be scheduled before it
+ *                        can notice.  A cancel that is delivered but never
+ *                        acted upon leaves the join blocked forever, which
+ *                        is why this scenario asserts on the join completing
+ *                        rather than on the cancel call returning success.
+ * @apicovered           :pthread_create, pthread_cancel, pthread_join,
+ *                        pthread_setcanceltype, pthread_testcancel
+ * @precondition         :CONFIG_CANCELLATION_POINTS
+ * @postcondition        :thread joined, all workers exited
+ * @return               :void
+ *
+ ****************************************************************************/
+
+static void stc_sched_life04_cancel_under_load(void)
+{
+	struct stc_workload_s wl;
+	pthread_t thread;
+	int ncpus = stc_ncpus();
+	int start_ret;
+	int finish_ret;
+	int create_ret;
+	int cancel_ret = ERROR;
+	int join_ret = ERROR;
+
+	g_life_cancelled_exited = false;
+
+	stc_workload_init(&wl, ncpus, SCHED_PRIORITY_DEFAULT, SCHED_RR);
+
+	start_ret = stc_workload_start(&wl);
+
+	create_ret = pthread_create(&thread, NULL, stc_life_cancellable_thread,
+				    NULL);
+
+	usleep(200 * 1000);
+
+	if (create_ret == OK) {
+		cancel_ret = pthread_cancel(thread);
+
+		usleep(STC_LIFE_CANCEL_MS * 1000);
+
+		join_ret = pthread_join(thread, NULL);
+	}
+
+	finish_ret = stc_workload_finish(ncpus);
+
+	printf("[SCN-LIFE-04] create=%d cancel=%d join=%d\n",
+	       create_ret, cancel_ret, join_ret);
+
+	TC_ASSERT_EQ("life04_workload_start", start_ret, OK);
+	TC_ASSERT_EQ("life04_thread_create", create_ret, OK);
+	TC_ASSERT_EQ("life04_workload_finish", finish_ret, OK);
+
+	TC_ASSERT_EQ("life04_cancel_ok", cancel_ret, OK);
+
+	/* The join is the real assertion: it only completes if the cancel was
+	 * acted upon rather than merely accepted.
+	 */
+
+	TC_ASSERT_EQ("life04_join_completed", join_ret, OK);
+
+	TC_SUCCESS_RESULT();
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: stc_sched_lifecycle_main
+ ****************************************************************************/
+
+int stc_sched_lifecycle_main(void)
+{
+	printf("[SCN-LIFE] task lifecycle scenarios, ncpus=%d\n",
+	       stc_ncpus());
+
+	stc_sched_life01_churn_under_load();
+#ifdef CONFIG_SMP
+	if (stc_ncpus() > 1) {
+		stc_sched_life02_delete_remote_running();
+	} else {
+		printf("[SCN-LIFE-02] skipped, single CPU configuration\n");
+	}
+#endif
+	stc_sched_life03_delete_blocked();
+#ifdef CONFIG_CANCELLATION_POINTS
+	stc_sched_life04_cancel_under_load();
+#else
+	printf("[SCN-LIFE-04] skipped, built without CONFIG_CANCELLATION_POINTS\n");
+#endif
+
+	return 0;
+}
